+// Node unit tests model the native compiler boundary with the real VM compiler.
+// Product runtime code and its native-only execution policy are unchanged.
+if (typeof global.compileAndRunBundle === 'undefined') {
+  global.compileAndRunBundle = function(bundle, file) {
+    const Script = require('vm').Script;
+    return new Script(bundle, { filename: file }).runInThisContext();
+  };
+} else if (typeof global.compileAndRunBundle !== 'function') {
+  throw new TypeError('compileAndRunBundle must be a function in the unit-test host');
+}
