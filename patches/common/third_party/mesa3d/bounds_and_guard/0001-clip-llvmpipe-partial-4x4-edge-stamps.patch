-                                         &task->thread_data,
-                                         stride,
-                                         depth_stride,
-                                         sample_stride,
-                                         depth_sample_stride);
-      END_JIT_CALL();
+      lp_rast_call_fs_4x4_clipped(scene, state, task, variant, RAST_WHOLE,
+                                  x, y,
+                                  inputs->frontfacing,
+                                  GET_A0(inputs),
+                                  GET_DADX(inputs),
+                                  GET_DADY(inputs),
+                                  color,
+                                  depth,
+                                  mask,
+                                  scene->fb.nr_cbufs,
+                                  stride,
+                                  depth_stride,
+                                  sample_stride,
+                                  depth_sample_stride);
    }
 }
 
