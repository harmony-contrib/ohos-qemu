+# limitations under the License.
+
+import hashlib
+import argparse
+import os
+import subprocess
+import sys
+import shutil
+import tempfile
+from pathlib import Path
+
+
+def untar_file(tar_file_path, extract_path):
+    # The fixed archive is an input contract, not an optional dependency.
+    expected = 'cb3892683edb7a964d4ef39d1ed8d908504f426bd096d21acf7bff08e3cdaace'
+    with open(tar_file_path, 'rb') as archive:
+        digest = hashlib.sha256(archive.read()).hexdigest()
+    if digest != expected:
+        raise ValueError('unexpected libjpeg-turbo 3.1.0 archive')
+    subprocess.run(['tar', '-zxf', tar_file_path, '-C', extract_path], check=True)
+
+
+def move_file(src_path, dst_path):
+    files = [
+        "Add-loongarch64.patch",
+        "libjpeg-turbo-2.1.x-bugfix.patch",
+        "liteos_adapting.patch",
+        "libjpeg-turbo-optimize.patch",
+        "libjpeg-turbo-3.1.0-compat.patch",
+    ]
+    neon_compat_src_path = os.path.join(src_path, "neon-compat.h")
+    neon_compat_dst_path = os.path.join(dst_path, "simd/arm/neon-compat.h")
+    shutil.copy(neon_compat_src_path, neon_compat_dst_path)
+    for file in files:
+        src_file = os.path.join(src_path, file)
+        dst_file = os.path.join(dst_path, file)
+        shutil.copy(src_file, dst_file)
+    files1 = [
+        "jconfig.h",
+        "jconfigint.h",
+    ]
+    for file in files1:
+        src_file = os.path.join(src_path, file)
+        dst_file = os.path.join(dst_path, "src/", file)
+        shutil.copy(src_file, dst_file)
+
+def apply_patch(patch_file, target_dir):
+    if not os.path.isdir(target_dir) or os.path.islink(target_dir):
+        raise ValueError('libjpeg patch target must be a real generated directory')
+    patch_path = os.path.abspath(os.path.join(target_dir, patch_file))
+    patch_cmd = ['patch', '--batch', '--forward', '-p1', '--fuzz=0',
+                 '--no-backup-if-mismatch', '-i', patch_path, '-d', target_dir]
+    # No fuzzy/reverse fallback or swallowed failure. Validate each complete
+    # patch before applying any of its hunks.
+    subprocess.run(patch_cmd + ['--dry-run'], check=True)
+    subprocess.run(patch_cmd, check=True)
+
+
+def do_patch(target_dir):
+    patch_file = [
+        "Add-loongarch64.patch",
+        "libjpeg-turbo-2.1.x-bugfix.patch",
+        "liteos_adapting.patch",
+        "libjpeg-turbo-optimize.patch",
+        "libjpeg-turbo-3.1.0-compat.patch",
+    ]
+
+    for patch in patch_file:
+        apply_patch(patch, target_dir)
+
+
+def move_include(src_path, dst_path):
+    files = [
+        "src/jmorecfg.h",
+        "src/jerror.h",
+        "src/jpeglib.h"
+    ]
+    for file in files:
+        src_file = os.path.join(src_path, file)
+        file_name = file[4:]
+        dst_file = os.path.join(dst_path, file_name)
+        shutil.copy(src_file, dst_file)
+
+
+def generate(source_dir, gen_dir):
+    source = Path(source_dir).resolve()
+    generated = Path(os.path.abspath(gen_dir))
+    if generated == Path(generated.anchor) or generated == source or source in generated.parents:
+        raise ValueError('libjpeg generation must use a separate output directory')
+    for path in (generated, *generated.parents):
+        if path.is_symlink():
+            raise ValueError('libjpeg generation path must not contain symlinks')
+    if generated.exists() and not generated.is_dir():
+        raise ValueError('libjpeg generation path is not a directory')
+    generated.mkdir(parents=True, exist_ok=True)
+    destination = generated / 'libjpeg-turbo-3.1.0'
+    if destination.is_symlink() or (destination.exists() and not destination.is_dir()):
+        raise ValueError('libjpeg generated tree must be a real directory')
+    # Extract and patch a FRESH tree every time. Overlay extraction preserves
+    # old patch-created files and breaks strict incremental rebuilds.
+    with tempfile.TemporaryDirectory(prefix='.libjpeg-install-', dir=generated) as temporary:
+        stage = Path(temporary)
+        target = stage / 'libjpeg-turbo-3.1.0'
+        untar_file(str(source / 'libjpeg-turbo-3.1.0.tar.gz'), str(stage))
+        move_file(str(source), str(target))
+        do_patch(str(target))
+        for name in ('jmorecfg.h', 'jerror.h', 'jpeglib.h', 'jconfig.h', 'jconfigint.h'):
+            header = target / 'src' / name
+            if header.is_symlink() or not header.is_file() or header.stat().st_size == 0:
+                raise ValueError('missing or unsafe patched libjpeg header: ' + name)
+        previous = stage / 'previous-generated-tree'
+        had_previous = destination.exists()
+        if had_previous:
+            destination.rename(previous)
+        try:
+            target.rename(destination)
+        except OSError:
+            if had_previous:
+                previous.rename(destination)
+            raise
+        # No source header is published unless the entire patch set passed.
+        move_include(str(destination), str(source))
+
+
+def main():
+    freetype_path = argparse.ArgumentParser()
+    freetype_path.add_argument('--gen-dir', help='generate path of log', required=True)
+    freetype_path.add_argument('--source-dir', help='generate path of log', required=True)
+    args = freetype_path.parse_args()
+    generate(args.source_dir, args.gen_dir)
+    return 0
+
+if __name__ == '__main__':
+    sys.exit(main())
