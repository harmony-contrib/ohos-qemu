    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/config/scan_config_builder.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/concurrent/handler/deduplication_handler.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/concurrent/resolver/quality_conflict_resolver.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/concurrent/resolver/resolver_registry.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/concurrent/enhanced_scan_executor.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/concurrent/scan_task_deduplicator.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/converter/scanner_context_converter.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/strategy/default_scan_strategy.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/strategy/scan_strategy_manager.cpp",
  ]

  media_fuse_source = [
    "${MEDIALIB_NEW_SERVICES_PATH}/media_fuse/src/media_fuse_hdc_operations.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_fuse/src/media_fuse_high_daemon.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_fuse/src/media_fuse_low_daemon.cpp",
