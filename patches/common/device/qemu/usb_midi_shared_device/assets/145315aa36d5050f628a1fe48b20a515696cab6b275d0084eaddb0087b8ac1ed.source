  ]

  include_albums_refresh =
      [ "${MEDIALIB_SERVICES_PATH}/media_albums_refresh/include" ]

  include_cloud_sync_add_server =
      [ "${MEDIALIB_INTERFACES_PATH}/inner_api/native/cloud_sync" ]

  include_cloud_sync_server = [
    "${MEDIALIB_CLOUD_SYNC_SERVICE_PATH}/include",
    "${MEDIALIB_CLOUD_SYNC_SERVICE_PATH}/include/dto",
    "${MEDIALIB_CLOUD_SYNC_SERVICE_PATH}/include/controller",
    "${MEDIALIB_CLOUD_SYNC_SERVICE_PATH}/include/controller/processor",
    "${MEDIALIB_CLOUD_SYNC_SERVICE_PATH}/include/dao",
    "${MEDIALIB_CLOUD_SYNC_SERVICE_PATH}/include/service",
    "${MEDIALIB_CLOUD_SYNC_SERVICE_PATH}/include/service/processor",
    "${MEDIALIB_CLOUD_SYNC_SERVICE_PATH}/include/utils",
    "${MEDIALIB_CLOUD_SYNC_SERVICE_PATH}/include/background",
  ]

  include_media_ipc = [
    "${MEDIALIB_INNERKITS_PATH}/medialibrary_data_extension/include/ipc/util",
    "${MEDIALIB_INNERKITS_PATH}/medialibrary_data_extension/include/ipc/controller",
  ]

  include_media_cloud_sync_data = [
    "${MEDIALIB_CLOUD_SYNC_DATA}/include",
    "${MEDIALIB_CLOUD_SYNC_DATA}/include/vo",
  ]

  include_media_ipc_common = [
    "${MEDIALIB_IPC_COMMON}/include/config",
    "${MEDIALIB_IPC_COMMON}/include/utils",
    "${MEDIALIB_IPC_COMMON}/include/vo",
    "${MEDIALIB_IPC_COMMON}/include/callback",
  ]

  include_media_orm = [
    "${MEDIALIB_INNERKITS_PATH}/medialibrary_data_extension/include/po",
    "${MEDIALIB_INNERKITS_PATH}/medialibrary_data_extension/include/orm",
    "${MEDIALIB_INNERKITS_PATH}/medialibrary_data_extension/include/orm/po",
  ]

  include_media_assets_manager = [
    "${MEDIALIB_BUSINESS_PATH}/media_assets_manager/include/",
    "${MEDIALIB_BUSINESS_PATH}/media_assets_manager/include/controller",
    "${MEDIALIB_BUSINESS_PATH}/media_assets_manager/include/dao",
    "${MEDIALIB_BUSINESS_PATH}/media_assets_manager/include/dto",
    "${MEDIALIB_BUSINESS_PATH}/media_assets_manager/include/vo",
    "${MEDIALIB_BUSINESS_PATH}/media_assets_manager/include/service",
    "${MEDIALIB_BUSINESS_PATH}/media_assets_manager/include/utils",
  ]

  include_media_albums_manager = [
    "${MEDIALIB_BUSINESS_PATH}/media_albums_manager/include/",
    "${MEDIALIB_BUSINESS_PATH}/media_albums_manager/include/attribute",
    "${MEDIALIB_BUSINESS_PATH}/media_albums_manager/include/controller",
    "${MEDIALIB_BUSINESS_PATH}/media_albums_manager/include/dto",
    "${MEDIALIB_BUSINESS_PATH}/media_albums_manager/include/dao",
    "${MEDIALIB_BUSINESS_PATH}/media_albums_manager/include/vo",
  ]

  include_media_file_management =
      [ "${MEDIALIB_BUSINESS_PATH}/media_file_management/include/" ]

  include_media_permission =
      [ "${MEDIALIB_BUSINESS_PATH}/media_permission/include/" ]

  include_notification = [
    "${MEDIALIB_NEW_SERVICES_PATH}/media_notification/include/accurate_refresh",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_notification/include/register_manager",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_notification/include/data",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_notification/include",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_notification/include/utils",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_notification/include/progress_callback_notify",
  ]

  include_accurate_refresh = [
    "${MEDIALIB_ACCURATE_REFRESH_PATH}/include",
    "${MEDIALIB_ACCURATE_REFRESH_PATH}/include/analysis/core",
    "${MEDIALIB_ACCURATE_REFRESH_PATH}/include/analysis/base",
    "${MEDIALIB_ACCURATE_REFRESH_PATH}/include/analysis/strategies",
    "${MEDIALIB_ACCURATE_REFRESH_PATH}/include/controller",
    "${MEDIALIB_ACCURATE_REFRESH_PATH}/include/dfx",
  ]

  include_media_camera_character = [
    "${MEDIALIB_INTERFACES_PATH}/inner_api/media_library_camera_helper/include/enum",
    "${MEDIALIB_BUSINESS_PATH}/media_camera_character_service/include/",
    "${MEDIALIB_BUSINESS_PATH}/media_camera_character_service/include/capture_object",
    "${MEDIALIB_BUSINESS_PATH}/media_camera_character_service/include/common_data",
    "${MEDIALIB_BUSINESS_PATH}/media_camera_character_service/include/controller",
    "${MEDIALIB_BUSINESS_PATH}/media_camera_character_service/include/dao",
    "${MEDIALIB_BUSINESS_PATH}/media_camera_character_service/include/deferred_processing",

    "${MEDIALIB_BUSINESS_PATH}/media_camera_character_service/include/dfx",
    "${MEDIALIB_BUSINESS_PATH}/media_camera_character_service/include/dto",
    "${MEDIALIB_BUSINESS_PATH}/media_camera_character_service/include/notify",
    "${MEDIALIB_BUSINESS_PATH}/media_camera_character_service/include/vo",
    "${MEDIALIB_BUSINESS_PATH}/media_camera_character_service/include/utils",
  ]

  include_backround_task = [
    "${MEDIALIB_NEW_SERVICES_PATH}/background_task_manager/include",
    "${MEDIALIB_NEW_SERVICES_PATH}/background_task_manager/include/background",
    "${MEDIALIB_NEW_SERVICES_PATH}/background_task_manager/include/operation",
  ]

  include_media_lake_monitor = [
    "${MEDIALIB_NEW_SERVICES_PATH}/media_lake_scanner/include",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_lake_file_monitor/include",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_lake_load/include",
  ]

  include_media_analysis_data_client_vo =
      [ "${MEDIALIB_INTERFACES_PATH}/inner_api/analysis_data_kits/include/vo" ]

  include_media_analysis_data_extension =
      [ "${MEDIALIB_BUSINESS_PATH}/media_analysis_extension/include" ]

  include_event_handler =
      [ "${MEDIALIB_NEW_SERVICES_PATH}/media_rdbstore/include/event_handler" ]

  include_upgrade = [
    "${MEDIALIB_NEW_SERVICES_PATH}/media_rdbstore/include/upgrade",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_rdbstore/include/upgrade/upgrade_sqls",
  ]

  include_old_notification =
      [ "${MEDIALIB_NEW_SERVICES_PATH}/media_old_notification/include" ]

  include_lcd_aging =
      [ "${MEDIALIB_NEW_SERVICES_PATH}/media_lcd_aging/include" ]

  include_media_file_manager = [
    "${MEDIALIB_SERVICES_PATH}/media_file_manager/include",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_file_scan/file_manager/include",
  ]

  include_dirs = [
    "${MEDIALIB_INTERFACES_PATH}/innerkits/native/include",
    "${MEDIALIB_INTERFACES_PATH}/inner_api/media_library_helper/include",
    "${MEDIALIB_INTERFACES_PATH}/inner_api/media_permission_helper/include",
    "${MEDIALIB_INNERKITS_PATH}/media_library_helper/include",
    "${MEDIALIB_UTILS_PATH}/include",
    "${MEDIALIB_INNERKITS_PATH}/medialibrary_data_extension/include/config",
    "${MEDIALIB_INNERKITS_PATH}/medialibrary_data_extension/include/operation",
    "${MEDIALIB_INNERKITS_PATH}/medialibrary_data_extension/include/photo_album_operation",
    "${MEDIALIB_INNERKITS_PATH}/medialibrary_data_extension/include",
    "${MEDIALIB_INNERKITS_PATH}/medialibrary_data_extension/include/attribute/is_removed",
    "${MEDIALIB_INNERKITS_PATH}/medialibrary_data_extension/include/attribute/nickname",
    "${MEDIALIB_INNERKITS_PATH}/medialibrary_data_extension/include/attribute/extra_info",
    "${MEDIALIB_SERVICES_PATH}/media_async_worker/include",
    "${MEDIALIB_SERVICES_PATH}/media_cloud_sync_notify_handle/include",
    "${MEDIALIB_ROOT_SERVICES_PATH}/media_mtp_service/include",
    "${MEDIALIB_SERVICES_PATH}/media_permission/include",
    "${MEDIALIB_SERVICES_PATH}/media_power_efficiency/include",
    "${MEDIALIB_SERVICES_PATH}/media_visit_count/include",
    "${MEDIALIB_THUMBNAIL_PATH}/include",
    "${MEDIALIB_FACARD_PATH}/include",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_rdbstore/include/rdbstore",
    "${MEDIALIB_INTERFACES_PATH}/kits/js/include",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_kv_db/include",
    "${MEDIALIB_BUSINESS_PATH}/media_analysis_data_manager/include/dao/table",
  ]
  include_dirs += include_common_utils
  include_dirs += include_fuse
  include_dirs += include_scanner
  include_dirs += include_dfx
  include_dirs += include_cloud_asset_download
  include_dirs += include_cloud_dirty_handle
  include_dirs += include_albums_refresh
  include_dirs += include_cloud_sync_add_server
  include_dirs += include_media_ipc
  include_dirs += include_media_orm
  include_dirs += include_media_permission
  include_dirs += include_media_assets_manager
  include_dirs += include_media_albums_manager
  include_dirs += include_notification
  include_dirs += include_accurate_refresh
  include_dirs += include_media_camera_character

  include_dirs += include_backround_task
  include_dirs += include_media_lake_monitor
  include_dirs += include_media_analysis_data_client_vo
  include_dirs += include_media_analysis_data_extension
  include_dirs += include_event_handler
  include_dirs += include_upgrade
  include_dirs += include_old_notification
  include_dirs += include_media_ipc_common
  include_dirs += include_media_cloud_sync_data
  include_dirs += include_lcd_aging
  include_dirs += include_media_file_manager

  if (media_library_analysis_data_enable) {
    include_media_analysis_data_server = [
      "${MEDIALIB_BUSINESS_PATH}/media_analysis_data_manager/include/controller",
      "${MEDIALIB_BUSINESS_PATH}/media_analysis_data_manager/include/dto",
      "${MEDIALIB_BUSINESS_PATH}/media_analysis_data_manager/include/dao",
      "${MEDIALIB_BUSINESS_PATH}/media_analysis_data_manager/include/service",
      "${MEDIALIB_BUSINESS_PATH}/media_analysis_data_manager/include/utils",
    ]
    include_dirs += include_media_analysis_data_server
  }

  if (media_library_lake_enable) {
    include_media_lake = [
      "${MEDIALIB_NEW_SERVICES_PATH}/media_file_monitor/lake/include",
      "${MEDIALIB_NEW_SERVICES_PATH}/media_file_scan/lake/include",
    ]
    include_dirs += include_media_lake
  }

  if (media_library_file_manager_enable) {
    include_media_file_manager_source = [
      "${MEDIALIB_NEW_SERVICES_PATH}/media_file_monitor/file_manager/include",
      "${MEDIALIB_NEW_SERVICES_PATH}/media_file_scan/file_manager/include",
    ]
    include_dirs += include_media_file_manager_source
  }

  if (media_library_file_manager_enable || media_library_lake_enable) {
    include_media_file_access_load =
        [ "${MEDIALIB_SERVICES_PATH}/media_file_access_load/include" ]
    include_media_file_scan = [
      "${MEDIALIB_NEW_SERVICES_PATH}/media_file_monitor/common/include",
      "${MEDIALIB_NEW_SERVICES_PATH}/media_file_scan/common/include",
    ]
    include_dirs += include_media_file_access_load
    include_dirs += include_media_file_scan
  }

  if (media_library_file_manager_enable) {
    include_dirs += include_media_file_management
  }

  if (media_library_facard_enable) {
    include_facard = [ "${MEDIALIB_FACARD_PATH}/include/operation" ]
    include_dirs += include_facard
  }

  if (media_library_cloud_sync_enable) {
    include_dirs += include_cloud_sync_server
  } else {
    include_cloud_sync_server = []
  }

  if (media_library_feature_cloud_enhancement) {
    include_cloud_enhancement = [
      "${MEDIALIB_ROOT_SERVICES_PATH}/media_cloud_enhancement/include",
      "${MEDIALIB_ROOT_SERVICES_PATH}/media_cloud_enhancement/include/enhancement_service",
      "${MEDIALIB_ROOT_SERVICES_PATH}/media_cloud_enhancement/include/utils",
      "${MEDIALIB_ROOT_SERVICES_PATH}/media_cloud_enhancement/include/dfx",
    ]
    include_dirs += include_cloud_enhancement
  }

  if (media_library_feature_custom_restore) {
    include_custom_restore =
        [ "${MEDIALIB_NEW_SERVICES_PATH}/media_custom_restore/include" ]
    include_dirs += include_custom_restore
  }

  if (defined(global_parts_info) &&
      defined(
          global_parts_info.device_cloud_gateway_media_cloud_enhance_service) &&
      media_library_feature_cloud_enhancement) {
    include_dirs += [ "${MEDIALIB_ROOT_SERVICES_PATH}/media_cloud_enhancement/include/common_data" ]
  }

  ldflags = [ "-Wl,--gc-sections" ]

  cflags = [
    "-Wunused-const-variable",
    "-Wno-unused-but-set-variable",
    "-fvisibility=hidden",
    "-fdata-sections",
    "-ffunction-sections",
    "-Os",
  ]

  cflags_cc = [
    "-fvisibility-inlines-hidden",
    "-Os",
  ]

  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }
}

ohos_shared_library("medialibrary_data_extension") {
  install_enable = true
  defines = []

  if (media_library_cellular_data_enable) {
    defines += [ "CELLULAR_DATA_ENABLE" ]
  }
  if (media_library_facard_enable) {
    defines += [ "MEDIALIBRARY_FACARD_SUPPORT" ]
  }

  if (media_library_feature_cloud_enhancement) {
    defines += [ "MEDIALIBRARY_FEATURE_CLOUD_ENHANCEMENT" ]
  }

  if (media_library_feature_cloud_download) {
    defines += [ "MEDIALIBRARY_FEATURE_CLOUD_DOWNLOAD" ]
  }

  if (media_library_analysis_data_enable) {
    defines += [ "MEDIALIBRARY_FEATURE_ANALYSIS_DATA" ]
  }

  if (media_library_feature_custom_restore) {
    defines += [ "MEDIALIBRARY_FEATURE_CUSTOM_RESTORE" ]
  }

  if (media_library_lake_enable) {
    defines += [ "MEDIALIBRARY_LAKE_SUPPORT" ]
  }

  if (media_library_file_manager_enable) {
    defines += [ "MEDIALIBRARY_FILE_MGR_SUPPORT" ]
  }

  media_video_mode_source = [ "${MEDIALIB_INNERKITS_PATH}/medialibrary_data_extension/src/operation/photo_video_mode_operation.cpp" ]

  media_scan_source = [
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/media_scan_executor.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/media_scanner.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/media_scanner_manager.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/media_scanner_db.cpp",
