import("//build/ohos.gni")
import("//foundation/multimedia/media_library/media_library.gni")

ohos_prebuilt_etc("userfilemanager_mimetypes.json") {
  module_install_dir = "etc/userfilemanager"

  source = "${MEDIALIB_UTILS_PATH}/configs/userfilemanager_mimetypes.json"

  subsystem_name = "multimedia"
  part_name = "media_library"
}

ohos_prebuilt_etc("heif_transcoding_checklist.json") {
  module_install_dir =
      "etc/com.ohos.medialibrary.medialibrarydata/heif_transcoding/"

  source = "${MEDIALIB_UTILS_PATH}/configs/heif_transcoding_checklist.json"

  subsystem_name = "multimedia"
  part_name = "media_library"
}

ohos_prebuilt_etc("version.txt") {
  module_install_dir =
      "etc/com.ohos.medialibrary.medialibrarydata/heif_transcoding/"

  source = "${MEDIALIB_UTILS_PATH}/configs/version.txt"

  subsystem_name = "multimedia"
  part_name = "media_library"
}

ohos_prebuilt_etc("medialibrary_kit_whitelist.json") {
  module_install_dir =
      "etc/com.ohos.medialibrary.medialibrarydata/medialibrary_kit_whitelist/"

  source = "${MEDIALIB_UTILS_PATH}/configs/medialibrary_kit_whitelist/medialibrary_kit_whitelist.json"

  subsystem_name = "multimedia"
  part_name = "media_library"
}

ohos_prebuilt_etc("medialibrary_kit_version.txt") {
  module_install_dir =
      "etc/com.ohos.medialibrary.medialibrarydata/medialibrary_kit_whitelist/"

  source =
      "${MEDIALIB_UTILS_PATH}/configs/medialibrary_kit_whitelist/version.txt"

  subsystem_name = "multimedia"
  part_name = "media_library"
}

config("media_data_extension_public_config") {
  include_common_utils = [ "${MEDIALIB_COMMON_PATH}/utils/include" ]

  include_fuse = [ "${MEDIALIB_NEW_SERVICES_PATH}/media_fuse/include" ]

  include_scanner = [
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include/callback",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include/scanner",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include/scanner/config",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include/scanner/concurrent",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include/scanner/concurrent/handler",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include/scanner/concurrent/resolver",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include/scanner/internal",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include/scanner/converter",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include/scanner/strategy",
  ]

  include_dfx = [ "${MEDIALIB_SERVICES_PATH}/media_dfx/include" ]

  include_cloud_asset_download = [
