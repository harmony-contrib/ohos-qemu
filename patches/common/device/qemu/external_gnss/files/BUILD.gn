import("//build/ohos.gni")
import("//device/qemu/common/virt_full/device.gni")

ohos_shared_library("qemu_external_gnss") {
  output_name = "vendorGnssAdapter"
  output_prefix_override = true
  output_extension = "so"
  sources = [
    "qemu_gnss_input.cpp",
    "qemu_gnss_vendor.cpp",
  ]
  include_dirs = [ "//drivers/peripheral/location/gnss/hdi_service" ]
  cflags = [ "-Wall", "-Wextra", "-Werror" ]
  sanitize = {
    cfi = true
    cfi_cross_dso = true
  }
  branch_protector_ret = "pac_ret"
  install_images = [ chipset_base_dir ]
  subsystem_name = virt_subsystem_name
  part_name = virt_part_name
}
