@@ -117,6 +117,10 @@
 
   # The global switch of cfi debug mode.
   cfi_debug = false
+
+  # QEMU retains CFI while using bounded ThinLTO instead of monolithic LTO.
+  # Other products preserve their existing full-LTO CFI configuration.
+  qemu_thin_cfi = false
 
