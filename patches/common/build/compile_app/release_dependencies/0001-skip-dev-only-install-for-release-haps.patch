+def has_release_dependencies(cwd: str, modules_list) -> bool:
+    package_files = [os.path.join(cwd, 'oh-package.json5')]
+    for module in modules_list or []:
+        src_path = module.get('srcPath')
+        if src_path:
+            package_files.append(os.path.join(cwd, src_path, 'oh-package.json5'))
+
+    for package_file in package_files:
+        if not os.path.isfile(package_file):
+            continue
+        with open(package_file, 'r') as input_f:
+            package_info = json5.load(input_f)
+        if package_info.get('dependencies') or package_info.get('dynamicDependencies'):
+            return True
+    return False
+
