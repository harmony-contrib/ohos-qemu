+def _strict_path(path):
+    import stat
+
+    path = os.path.abspath(path)
+    cursor = path
+    while True:
+        if os.path.lexists(cursor) and stat.S_ISLNK(os.lstat(cursor).st_mode):
+            raise ValueError('strict HAP path contains a symlink: ' + path)
+        parent = os.path.dirname(cursor)
+        if parent == cursor:
+            return path
+        cursor = parent
+
+
+def _strict_regular_file(path):
+    import stat
+
+    value = os.lstat(_strict_path(path))
+    if not stat.S_ISREG(value.st_mode) or value.st_nlink != 1:
+        raise ValueError('strict HAP input/output is not a unique regular file: ' + path)
+    return (value.st_dev, value.st_ino, value.st_mode, value.st_size,
+            value.st_mtime_ns, value.st_ctime_ns, value.st_nlink)
+
+
+def _strict_json(path):
+    import json
+
+    def unique_pairs(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result:
+                raise ValueError('duplicate strict HAP JSON key: ' + key)
+            result[key] = value
+        return result
+
+    before = _strict_regular_file(path)
+    with open(path, 'r', encoding='utf-8') as stream:
+        value = json.load(stream, object_pairs_hook=unique_pairs)
+    if before != _strict_regular_file(path):
+        raise ValueError('strict HAP JSON changed while reading: ' + path)
+    return value
+
+
+def _strict_output_state(directory, expected):
+    import stat
+
+    value = os.lstat(_strict_path(directory))
+    if not stat.S_ISDIR(value.st_mode):
+        raise ValueError('strict HAP output is not a directory')
+    result = {}
+    with os.scandir(directory) as entries:
+        for entry in entries:
+            if not entry.name.endswith(('.hap', '.hsp')):
+                continue
+            if entry.name not in expected:
+                raise ValueError('unknown strict HAP output; preserving it: ' + entry.name)
+            result[entry.name] = _strict_regular_file(entry.path)
+    return (value.st_dev, value.st_ino), result
+
+
