+    int32_t ret = SingleStagePolyphaseResamplerResetMem(state_);
+    if (ret == EOK) {
+        ret = SingleStagePolyphaseResamplerSkipHalfTaps(state_);
+    }
+    configurationValid_ = (ret == EOK);
+    if (configurationValid_) {
+        lastDelayFrames_ = 0;
+    }
