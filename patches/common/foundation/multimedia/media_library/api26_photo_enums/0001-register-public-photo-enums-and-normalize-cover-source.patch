+            {"USED", static_cast<int32_t>(LivePhoto4dStatusType::TYPE_USED)},
+            {"LIVEPHOTO_4D", static_cast<int32_t>(LivePhoto4dStatusType::TYPE_LIVEPHOTO_4D)},
