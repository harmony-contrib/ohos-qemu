+#include "knowledge_content_napi.h"
+#include "knowledge_content_query.h"
+#include "accesstoken_kit.h"
+#include "ipc_skeleton.h"
+#include "medialibrary_napi_utils.h"
+#include "media_asset_rdbstore.h"
+#include <algorithm>
