+{
+    value.clear();
+    for (size_t i = 0; i < encoded.size(); ++i) {
+        char c = encoded[i];
+        if (c == '\\') {
+            if (++i == encoded.size()) return false;
+            c = encoded[i];
+            if (c == 'N' || c == 'n') c = '\n';
+            else if (c != '\\' && c != ',' && c != ';') return false;
+        }
+        value += c;
+        if (value.size() > MAX_TEXT) return false;
+    }
+    return !value.empty() && Utf8(value);
