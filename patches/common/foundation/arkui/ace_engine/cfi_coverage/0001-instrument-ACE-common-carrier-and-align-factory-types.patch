+if (is_ohos && current_os == "ohos") {
+  ohos_sanitizer_config("ace_cfi_config") {
+    sanitize = {
+      cfi = true
+      cfi_cross_dso = true
+      debug = ace_sanitize_debug
+    }
+  }
