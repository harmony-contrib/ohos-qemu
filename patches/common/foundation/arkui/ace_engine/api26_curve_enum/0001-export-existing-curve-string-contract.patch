+static bool RegisterPublicCurveEnum(const shared_ptr<JsRuntime>& runtime, const shared_ptr<JsValue>& moduleObj)
+{
+    const struct {
+        const char* name;
+        const char* value;
+    } members[] = {
+        { "Linear", DOM_ANIMATION_TIMING_FUNCTION_LINEAR },
+        { "Ease", DOM_ANIMATION_TIMING_FUNCTION_EASE },
+        { "EaseIn", DOM_ANIMATION_TIMING_FUNCTION_EASE_IN },
+        { "EaseOut", DOM_ANIMATION_TIMING_FUNCTION_EASE_OUT },
+        { "EaseInOut", DOM_ANIMATION_TIMING_FUNCTION_EASE_IN_OUT },
+        { "FastOutSlowIn", DOM_ANIMATION_TIMING_FUNCTION_FAST_OUT_SLOW_IN },
+        { "LinearOutSlowIn", DOM_ANIMATION_TIMING_FUNCTION_LINEAR_OUT_SLOW_IN },
+        { "FastOutLinearIn", DOM_ANIMATION_TIMING_FUNCTION_FAST_OUT_LINEAR_IN },
+        { "ExtremeDeceleration", DOM_ANIMATION_TIMING_FUNCTION_EXTREME_DECELERATION },
+        { "Sharp", DOM_ANIMATION_TIMING_FUNCTION_SHARP },
+        { "Rhythm", DOM_ANIMATION_TIMING_FUNCTION_RHYTHM },
+        { "Smooth", DOM_ANIMATION_TIMING_FUNCTION_SMOOTH },
+        { "Friction", DOM_ANIMATION_TIMING_FUNCTION_FRICTION },
+    };
+    auto curve = runtime->NewObject();
+    if (!curve || !curve->IsObject(runtime)) {
+        return false;
+    }
+    for (const auto& member : members) {
+        auto value = runtime->NewString(member.value);
+        if (!value || !value->IsString(runtime) || !curve->SetProperty(runtime, member.name, value)) {
+            return false;
+        }
+    }
+    return moduleObj->SetProperty(runtime, "Curve", curve);
+}
+
 void InitCurvesModule(const shared_ptr<JsRuntime>& runtime, shared_ptr<JsValue>& moduleObj)
 {
+    if (!RegisterPublicCurveEnum(runtime, moduleObj)) {
+        moduleObj = runtime->NewNull();
+        return;
+    }
     moduleObj->SetProperty(runtime, CURVES_INIT, runtime->NewFunction(CurvesInit));

