 void LazyDynamicLayoutPattern::UpdateCustomLayoutAlgorithmParam(const RefPtr<LazyCustomLayoutAlgorithmParam>& param)
 {
+    // Attribute callbacks belong to the component, not to a particular
+    // algorithm object. Preserve the existing callback unless the new
+    // parameter already supplies one; explicit reset remains an empty callback.
+    if (param && customParams_ && param != customParams_ && !param->HasOnVisibleIndexesChange()) {
+        auto onVisibleIndexesChange = customParams_->GetOnVisibleIndexesChange();
+        param->SetOnVisibleIndexesChange(std::move(onVisibleIndexesChange));
+    }
+    const auto previousAxis = axis_;
     customParams_ = param;
-    if (customParams_) {
-        axis_ = customParams_->GetAxis();
+    axis_ = customParams_ ? customParams_->GetAxis() : Axis::VERTICAL;
+    if (axis_ != previousAxis) {
+        auto host = GetHost();
+        if (host && host->IsOnMainTree()) {
+            OnAttachToMainTree();
+        }
     }
 }
