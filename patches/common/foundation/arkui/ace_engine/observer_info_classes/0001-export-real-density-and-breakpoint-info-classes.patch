+namespace {
+struct ObserverInfoConstructors {
+    napi_env env = nullptr;
+    napi_ref density = nullptr;
+    napi_ref breakpoint = nullptr;
+};
+
+thread_local std::map<napi_env, std::unique_ptr<ObserverInfoConstructors>> observerInfoConstructors;
+
+void CleanUpObserverInfoConstructors(void* data)
+{
+    auto context = static_cast<ObserverInfoConstructors*>(data);
+    if (context->density != nullptr) {
+        napi_delete_reference(context->env, context->density);
+    }
+    if (context->breakpoint != nullptr) {
+        napi_delete_reference(context->env, context->breakpoint);
+    }
+    observerInfoConstructors.erase(context->env);
+}
+
+ObserverInfoConstructors* GetObserverInfoConstructors(napi_env env)
+{
+    auto existing = observerInfoConstructors.find(env);
+    if (existing != observerInfoConstructors.end()) {
+        return existing->second.get();
+    }
+    auto context = std::unique_ptr<ObserverInfoConstructors>(new (std::nothrow) ObserverInfoConstructors());
+    if (!context) {
+        return nullptr;
+    }
+    context->env = env;
+    if (napi_add_env_cleanup_hook(env, CleanUpObserverInfoConstructors, context.get()) != napi_ok) {
+        return nullptr;
+    }
+    auto pointer = context.get();
+    observerInfoConstructors.emplace(env, std::move(context));
+    return pointer;
+}
+
+napi_value ObserverInfoConstructor(napi_env env, napi_callback_info info)
+{
+    napi_value target = nullptr;
+    napi_value instance = nullptr;
+    if (napi_get_new_target(env, info, &target) != napi_ok) {
+        return nullptr;
+    }
+    if (target == nullptr) {
+        napi_throw_type_error(env, nullptr, "Observer info class constructor requires new");
+        return nullptr;
+    }
+    if (napi_get_cb_info(env, info, nullptr, nullptr, &instance, nullptr) != napi_ok) {
+        return nullptr;
+    }
+    return instance;
+}
+
+napi_value GetObserverInfoConstructor(napi_env env, const char* name, napi_ref& reference)
+{
+    napi_value constructor = nullptr;
+    if (reference != nullptr) {
+        return napi_get_reference_value(env, reference, &constructor) == napi_ok ? constructor : nullptr;
+    }
+    if (napi_define_class(env, name, NAPI_AUTO_LENGTH, ObserverInfoConstructor, nullptr,
+        0, nullptr, &constructor) != napi_ok ||
+        napi_create_reference(env, constructor, 1, &reference) != napi_ok) {
+        return nullptr;
+    }
+    return constructor;
+}
+
+napi_value CreateObserverInfo(napi_env env, bool density)
+{
+    auto context = GetObserverInfoConstructors(env);
+    if (context == nullptr) {
+        return nullptr;
+    }
+    auto constructor = GetObserverInfoConstructor(env,
+        density ? "DensityInfo" : "WindowSizeLayoutBreakpointInfo",
+        density ? context->density : context->breakpoint);
+    napi_value result = nullptr;
+    if (constructor == nullptr || napi_new_instance(env, constructor, 0, nullptr, &result) != napi_ok) {
+        return nullptr;
+    }
+    return result;
+}
+} // namespace
+
+napi_value InitObserverInfoClasses(napi_env env, napi_value exports)
+{
+    auto context = GetObserverInfoConstructors(env);
+    if (context == nullptr) {
+        return exports;
+    }
+    auto density = GetObserverInfoConstructor(env, "DensityInfo", context->density);
+    if (density == nullptr || napi_set_named_property(env, exports, "DensityInfo", density) != napi_ok) {
+        return exports;
+    }
+    auto breakpoint = GetObserverInfoConstructor(env, "WindowSizeLayoutBreakpointInfo", context->breakpoint);
+    if (breakpoint != nullptr) {
+        napi_set_named_property(env, exports, "WindowSizeLayoutBreakpointInfo", breakpoint);
+    }
+    return exports;
+}
