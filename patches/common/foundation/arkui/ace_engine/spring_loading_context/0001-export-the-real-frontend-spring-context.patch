+// Use the frontend's real class, also used to create spring-loading callbacks.
+// Resolve in the calling environment, without pinning another UI/worker env.
+// An import before frontend registration must not break other drag exports.
+static napi_value GetSpringLoadingContext(napi_env env, napi_callback_info info)
+{
+    napi_value global = nullptr;
+    napi_value constructor = nullptr;
+    napi_valuetype type = napi_undefined;
+    NAPI_CALL(env, napi_get_global(env, &global));
+    NAPI_CALL(env, napi_get_named_property(env, global, "SpringLoadingContext", &constructor));
+    NAPI_CALL(env, napi_typeof(env, constructor, &type));
+    if (type == napi_undefined) {
+        return constructor;
+    }
+    if (type != napi_function) {
+        napi_throw_type_error(env, nullptr, "SpringLoadingContext is not an ArkUI constructor");
+        return nullptr;
+    }
+    return constructor;
+}
