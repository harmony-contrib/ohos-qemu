+
+    template<typename C>
+    void SetNativeCallbacks(JSDestructorCallback<C> dtor, JSGCMarkCallback<C> gcMark)
+    {
+        // Capture callback addresses only, retaining the callbacks' native object ownership.
+        jsDestructorErased = nullptr;
+        if (dtor != nullptr) {
+            jsDestructorErased = [dtor](void* nativePtr) {
+                dtor(static_cast<C*>(nativePtr));
+            };
+        }
+        jsGcMarkErased = nullptr;
+        if (gcMark != nullptr) {
+            jsGcMarkErased = [gcMark](void* nativePtr, const JSGCMarkCallbackInfo& info) {
+                gcMark(static_cast<C*>(nativePtr), info);
+            };
+        }
+    }
 };
 
