+#ifndef FOUNDATION_ACE_INTERFACES_LUMINANCE_ERROR_H
+#define FOUNDATION_ACE_INTERFACES_LUMINANCE_ERROR_H
+
+#include "interfaces/napi/kits/utils/napi_utils.h"
+#include "napi/native_api.h"
+
+namespace OHOS::Ace::Napi {
+// Only this module adopts the SDK's numeric BusinessError.code contract.
+// Keep the existing message mapping and leave shared NapiThrow unchanged.
+inline void ThrowLuminanceError(napi_env env, const std::string& message, int32_t errCode)
+{
+    bool pending = false;
+    if (napi_is_exception_pending(env, &pending) != napi_ok || pending) {
+        return;
+    }
+    const std::string strMsg = ErrorToMessage(errCode) + message;
+    LOGE("napi throw errCode %{public}d strMsg %{public}s", errCode, strMsg.c_str());
+    napi_value msg = nullptr;
+    napi_value error = nullptr;
+    napi_value code = nullptr;
+    if (napi_create_string_utf8(env, strMsg.c_str(), strMsg.length(), &msg) != napi_ok ||
+        napi_create_error(env, nullptr, msg, &error) != napi_ok ||
+        napi_create_int32(env, errCode, &code) != napi_ok ||
+        napi_set_named_property(env, error, "code", code) != napi_ok) {
+        return;
+    }
+    napi_throw(env, error);
+}
+} // namespace OHOS::Ace::Napi
+#endif // FOUNDATION_ACE_INTERFACES_LUMINANCE_ERROR_H
