+    for (const auto& slot : slots) {
+        if (slot.offset > previousEnd &&
+            !parcel->WriteBuffer(reinterpret_cast<const void*>(snapshot.GetData() + previousEnd),
+                slot.offset - previousEnd)) {
+            return nullptr;
+        }
+        uint32_t kind = slot.kind;
+        if (sidecar) {
