+static napi_value RegisterAuthForm(napi_env env, napi_value exports)
+{
+    const DmAuthForm forms[] = {
+        DmAuthForm::INVALID_TYPE, DmAuthForm::PEER_TO_PEER,
+        DmAuthForm::IDENTICAL_ACCOUNT, DmAuthForm::ACROSS_ACCOUNT
+    };
+    const char *names[] = {
+        "INVALID_TYPE", "PEER_TO_PEER", "IDENTICAL_ACCOUNT", "ACROSS_ACCOUNT"
+    };
+    napi_value result = nullptr;
+    if (napi_create_object(env, &result) != napi_ok) {
+        return nullptr;
+    }
+    for (size_t index = 0; index < sizeof(forms) / sizeof(forms[0]); ++index) {
+        napi_value member = nullptr;
+        if (napi_create_int32(env, static_cast<int32_t>(forms[index]), &member) != napi_ok ||
+            napi_set_named_property(env, result, names[index], member) != napi_ok) {
+            return nullptr;
+        }
+    }
+    if (napi_set_named_property(env, exports, "AuthForm", result) != napi_ok) {
+        return nullptr;
+    }
+    return exports;
+}
