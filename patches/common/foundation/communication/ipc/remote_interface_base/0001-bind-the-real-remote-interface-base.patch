+struct RemoteInterfaceIdentity {
+    napi_env env = nullptr;
+    napi_ref object = nullptr;
+    NAPIRemoteObjectHolder *holder = nullptr;
+    RemoteInterfaceIdentity *next = nullptr;
+    bool registered = false;
+    ~RemoteInterfaceIdentity();
+};
+
+static std::mutex remoteInterfaceIdentityMutex;
+static std::array<RemoteInterfaceIdentity *, 256> remoteInterfaceIdentities{};
+
+static size_t RemoteInterfaceIdentityBucket(void *holder)
+{
+    return (reinterpret_cast<uintptr_t>(holder) >> 4) % remoteInterfaceIdentities.size();
+}
+
+static void RemoveRemoteInterfaceIdentity(RemoteInterfaceIdentity *identity)
+{
+    // Caller holds the registry lock. Intrusive buckets need no extra
+    // allocation and work with this product's -fno-exceptions build.
+    if (!identity->registered) {
+        return;
+    }
+    auto link = &remoteInterfaceIdentities[RemoteInterfaceIdentityBucket(identity->holder)];
+    while (*link != nullptr && *link != identity) {
+        link = &(*link)->next;
+    }
+    if (*link == identity) {
+        *link = identity->next;
+    }
+    identity->registered = false;
+}
+
+RemoteInterfaceIdentity::~RemoteInterfaceIdentity()
+{
+    {
+        std::lock_guard<std::mutex> lock(remoteInterfaceIdentityMutex);
+        RemoveRemoteInterfaceIdentity(this);
+    }
+    if (env != nullptr && object != nullptr) {
+        napi_delete_reference(env, object);
+    }
+}
+
+static void FinalizeRemoteInterfaceStub(napi_env env, void *data, void *hint)
+{
+    auto identity = static_cast<RemoteInterfaceIdentity *>(hint);
+    {
+        std::lock_guard<std::mutex> lock(remoteInterfaceIdentityMutex);
+        RemoveRemoteInterfaceIdentity(identity);
+    }
+    if (env == nullptr) {
+        identity->object = nullptr;
+    }
+    delete identity;
+    RemoteObjectHolderFinalizeCb(env, data, nullptr);
+}
