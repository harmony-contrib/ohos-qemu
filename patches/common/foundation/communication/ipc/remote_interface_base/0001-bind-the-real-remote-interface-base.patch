+napi_value NAPIRemoteInterfaceExport(napi_env env, napi_value exports,
+    const napi_callback *proxyMethods, size_t proxyCount)
+{
+    static constexpr const char *names[] = {
+        "queryLocalInterface", "getLocalInterface", "sendRequest", "sendMessageRequest",
+        "addDeathRecipient", "registerDeathRecipient", "removeDeathRecipient",
+        "unregisterDeathRecipient", "getInterfaceDescriptor", "getDescriptor", "isObjectDead",
+    };
+    static constexpr napi_callback stubMethods[] = {
+        NAPI_RemoteObject_queryLocalInterface, NAPI_RemoteObject_getLocalInterface,
+        NAPI_RemoteObject_sendRequest, NAPI_RemoteObject_sendMessageRequest,
+        NAPI_RemoteObject_addDeathRecipient, NAPI_RemoteObject_registerDeathRecipient,
+        NAPI_RemoteObject_removeDeathRecipient, NAPI_RemoteObject_unregisterDeathRecipient,
+        NAPI_RemoteObject_getInterfaceDescriptor, NAPI_RemoteObject_getDescriptor, NAPI_RemoteObject_isObjectDead,
+    };
+    constexpr size_t count = sizeof(names) / sizeof(names[0]);
+    static_assert(sizeof(stubMethods) / sizeof(stubMethods[0]) == count);
+    NAPI_ASSERT(env, proxyMethods != nullptr && proxyCount == count, "complete native RPC method table required");
+    // These are DLL-lifetime, environment-independent C++ callbacks. Keep no
+    // per-environment references or heap callback data that can outlive a realm.
+    static std::array<RemoteInterfaceMethod, count> methods{};
+    static std::mutex methodsMutex;
+    {
+        std::lock_guard<std::mutex> lock(methodsMutex);
+        for (size_t index = 0; index < count; ++index) {
+            NAPI_ASSERT(env, proxyMethods[index] != nullptr &&
+                (methods[index].proxy == nullptr || methods[index].proxy == proxyMethods[index]),
+                "native RPC callback implementation changed");
+        }
+        for (size_t index = 0; index < count; ++index) {
+            if (methods[index].proxy == nullptr) {
+                methods[index] = {stubMethods[index], proxyMethods[index]};
+            }
+        }
+    }
+    napi_value stub = nullptr;
+    napi_value proxy = nullptr;
+    napi_value stubPrototype = nullptr;
+    napi_value proxyPrototype = nullptr;
+    NAPI_ASSERT(env, napi_get_named_property(env, exports, "RemoteObject", &stub) == napi_ok,
+        "read RemoteObject constructor failed");
+    NAPI_ASSERT(env, napi_get_named_property(env, exports, "RemoteProxy", &proxy) == napi_ok,
+        "read RemoteProxy constructor failed");
+    NAPI_ASSERT(env, napi_get_named_property(env, stub, "prototype", &stubPrototype) == napi_ok,
+        "read RemoteObject prototype failed");
+    NAPI_ASSERT(env, napi_get_named_property(env, proxy, "prototype", &proxyPrototype) == napi_ok,
+        "read RemoteProxy prototype failed");
+    napi_value constructor = nullptr;
+    NAPI_ASSERT(env, napi_define_class(env, "IRemoteObject", NAPI_AUTO_LENGTH, IRemoteObject_JS_Constructor,
+        nullptr, 0, nullptr, &constructor) == napi_ok, "define IRemoteObject failed");
+    napi_value prototype = nullptr;
+    NAPI_ASSERT(env, napi_get_named_property(env, constructor, "prototype", &prototype) == napi_ok,
+        "read IRemoteObject prototype failed");
+    for (size_t index = 0; index < count; ++index) {
+        napi_value method = nullptr;
+        // Plain native functions accept either actual RPC wrapper kind; class
+        // method signatures would brand them only for IRemoteObject's template.
+        NAPI_ASSERT(env, napi_create_function(env, names[index], NAPI_AUTO_LENGTH, InvokeRemoteInterfaceMethod,
+            &methods[index], &method) == napi_ok, "create native IRemoteObject method failed");
+        napi_property_descriptor property = {
+            names[index], nullptr, nullptr, nullptr, nullptr, method, napi_default, nullptr};
+        NAPI_ASSERT(env, napi_define_properties(env, prototype, 1, &property) == napi_ok,
+            "define IRemoteObject method failed");
+    }
+    NAPI_ASSERT(env, SetRemoteInterfaceParent(env, stubPrototype, prototype) == napi_ok &&
+        SetRemoteInterfaceParent(env, proxyPrototype, prototype) == napi_ok &&
+        SetRemoteInterfaceParent(env, stub, constructor) == napi_ok &&
+        SetRemoteInterfaceParent(env, proxy, constructor) == napi_ok, "link real RPC base class failed");
+    NAPI_ASSERT(env, napi_set_named_property(env, exports, "IRemoteObject", constructor) == napi_ok,
+        "export IRemoteObject failed");
+    return exports;
+}
