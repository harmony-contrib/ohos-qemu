+struct RemoteInterfaceMethod {
+    napi_callback stub = nullptr;
+    napi_callback proxy = nullptr;
+};
+
+static napi_value InvokeRemoteInterfaceMethod(napi_env env, napi_callback_info info)
+{
+    napi_value thisVar = nullptr;
+    void *data = nullptr;
+    NAPI_ASSERT(env, napi_get_cb_info(env, info, nullptr, nullptr, &thisVar, &data) == napi_ok,
+        "read IRemoteObject call failed");
+    auto method = static_cast<const RemoteInterfaceMethod *>(data);
+    sptr<IRemoteObject> target = NAPI_ohos_rpc_getNativeRemoteObject(env, thisVar);
+    if (target == nullptr) {
+        return napiErr.ThrowError(env, errorDesc::PROXY_OR_REMOTE_OBJECT_INVALID_ERROR);
+    }
+    // Call the real native callback with the original callback_info. Calling a
+    // concrete class's JS method would reject a base-derived receiver in V8.
+    return (target->IsProxyObject() ? method->proxy : method->stub)(env, info);
+}
+
+static napi_status SetRemoteInterfaceParent(napi_env env, napi_value child, napi_value parent)
+{
+    napi_value global = nullptr;
+    napi_value object = nullptr;
+    napi_value setter = nullptr;
+    napi_value result = nullptr;
+    napi_value actual = nullptr;
+    if (napi_get_global(env, &global) != napi_ok ||
+        napi_get_named_property(env, global, "Object", &object) != napi_ok ||
+        napi_get_named_property(env, object, "setPrototypeOf", &setter) != napi_ok) {
+        return napi_generic_failure;
+    }
+    napi_value argv[] = {child, parent};
+    napi_status status = napi_call_function(env, object, setter, 2, argv, &result);
+    if (status != napi_ok) {
+        return status;
+    }
+    bool equal = false;
+    if (napi_get_prototype(env, child, &actual) != napi_ok ||
+        napi_strict_equals(env, actual, parent, &equal) != napi_ok || !equal) {
+        return napi_generic_failure;
+    }
+    return napi_ok;
+}
