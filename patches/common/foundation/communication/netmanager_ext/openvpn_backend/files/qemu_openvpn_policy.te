# The existing netsysnative identity owns the client, bridge and private files.
allow init qemu_openvpn_exec:file { execute getattr map open read };
allow init netsysnative:process { transition };
allow netsysnative qemu_openvpn_exec:file { entrypoint execute execute_no_trans getattr map open read };
neverallow { domain -init -netsysnative } qemu_openvpn_exec:file execute;

allow init qemu_openvpn_data_file:dir { getattr relabelto search setattr };
allow netsysnative qemu_openvpn_data_file:dir { add_name create getattr open read remove_name rmdir search setattr write };
allow netsysnative qemu_openvpn_data_file:file { create getattr ioctl lock open read setattr unlink write };
allow netsysnative qemu_openvpn_data_file:sock_file { create getattr open read setattr unlink write };
allowxperm netsysnative dev_tun_file:chr_file ioctl { 0x54d2 };

# Only the two service-specific keys are assigned this parameter type.
allow qemu_openvpn_control_param tmpfs:filesystem associate;
allow init qemu_openvpn_control_param:file { map open read relabelfrom relabelto };
allow netsysnative qemu_openvpn_control_param:file { map open read };
allow netsysnative qemu_openvpn_control_param:parameter_service set;
