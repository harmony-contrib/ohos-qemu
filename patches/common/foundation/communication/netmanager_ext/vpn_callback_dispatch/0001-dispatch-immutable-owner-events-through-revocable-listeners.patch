+bool VpnCallbackForeground(int32_t expected)
+{
+    int32_t current = AppExecFwk::Constants::UNSPECIFIED_USERID;
+    return AccountSA::OsAccountManager::GetForegroundOsAccountLocalId(current) == ERR_OK && current == expected;
+}
