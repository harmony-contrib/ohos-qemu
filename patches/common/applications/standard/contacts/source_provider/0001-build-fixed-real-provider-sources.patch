+import("//build/ohos.gni")
+
+# The existing entry includes the real Contacts UIExtension and picker pages.
+ohos_app("contacts_hap") {
+  deps = []
+  certificate_profile = "signature/contacts.p7b"
+  hap_name = "Contacts"
