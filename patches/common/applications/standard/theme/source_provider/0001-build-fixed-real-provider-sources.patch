diff --git a/applications/standard/theme/BUILD.gn b/applications/standard/theme/BUILD.gn
new file mode 100644
--- /dev/null
+++ b/applications/standard/theme/BUILD.gn
@@ -0,0 +1,35 @@
+# Copyright (c) 2026 Harmony Contrib
+# SPDX-License-Identifier: Apache-2.0
+import("//build/ohos.gni")
+
+# Renderers only: neither target supplies a wallpaper selection/settings UI.
+# The shared HAP graph must select one device module, never install both.
+ohos_app("wallpaper_phone_hap") {
+  deps = []
+  certificate_profile = "signature/wallpaper.p7b"
+  hap_name = "Wallpaper"
+  part_name = "prebuilt_hap"
+  subsystem_name = "applications"
+  module_install_dir = "app/com.ohos.wallpaper"
+  sdk_home = "//prebuilts/ohos-sdk/linux"
+  sdk_type_name = [ "sdk.dir" ]
+  assemble_type = "assembleHap"
+  build_level = "module"
+  build_modules = [ "phone-wallpaper" ]
+  js_build_mode = "release"
+}
+
+ohos_app("wallpaper_pad_hap") {
+  deps = []
+  certificate_profile = "signature/wallpaper.p7b"
+  hap_name = "Wallpaper"
+  part_name = "prebuilt_hap"
+  subsystem_name = "applications"
+  module_install_dir = "app/com.ohos.wallpaper"
+  sdk_home = "//prebuilts/ohos-sdk/linux"
+  sdk_type_name = [ "sdk.dir" ]
+  assemble_type = "assembleHap"
+  build_level = "module"
+  build_modules = [ "pad-wallpaper" ]
+  js_build_mode = "release"
+}
