+# Copyright (c) 2026 Harmony Contrib
+# SPDX-License-Identifier: Apache-2.0
+import("//build/ohos.gni")
+
+# Preserve all seven source-HAP dependencies on this external target. Only one
+# profile target exists per build, so Hvigor still has one writer per project.
+if (defined(device_type) && device_type == "2in1") {
+  _systemui_source_target = "systemui_pc_sources"
+} else {
+  _systemui_source_target = "systemui_phone_sources"
+}
+group("systemui_hap") {
+  deps = [ ":${_systemui_source_target}" ]
+}
+
+# The selected target owns signed HAPs, signing metadata and installation info.
+# Keep the previous systemui_hap output directory as historical evidence.
+ohos_app(_systemui_source_target) {
+  deps = []
+  certificate_profile = "signature/systemui.p7b"
+  hap_name = "SystemUI"
+  strict_hap_list = true
+  part_name = "prebuilt_hap"
+  subsystem_name = "applications"
+  module_install_dir = "app/com.ohos.systemui"
+  sdk_home = "//prebuilts/ohos-sdk/linux"
+  sdk_type_name = [ "sdk.dir" ]
+  assemble_type = "assembleHap"
+  build_level = "module"
+  js_build_mode = "release"
+  if (defined(device_type) && device_type == "2in1") {
+    build_modules = [
+      "pc_entry",
+      "default_navigationBar",
+      "default_notificationmanagement",
+      "default_volumepanel",
+      "default_dialog",
+      "pc_controlpanel",
+      "pc_notificationpanel",
+      "pc_statusbar",
+    ]
+    hap_list = [
+      "SystemUI-pc_entry-default-unsigned:SystemUI",
+      "SystemUI-default_navigationBar-pc_entry-default-unsigned:SystemUI-NavigationBar",
+      "SystemUI-default_notificationmanagement-pc_entry-default-unsigned:SystemUI-NotificationManagement",
+      "SystemUI-default_volumepanel-pc_entry-default-unsigned:SystemUI-VolumePanel",
+      "SystemUI-default_dialog-pc_entry-default-unsigned:SystemUI-SystemDialog",
+      "SystemUI-pc_controlpanel-pc_entry-default-unsigned:SystemUI-ControlPanel",
+      "SystemUI-pc_notificationpanel-pc_entry-default-unsigned:SystemUI-NotificationPanel",
+      "SystemUI-pc_statusbar-pc_entry-default-unsigned:SystemUI-StatusBar",
+    ]
+  } else {
+    build_modules = [
+      "phone_entry",
+      "default_navigationBar",
+      "default_notificationmanagement",
+      "default_volumepanel",
+      "default_dialog",
+      "phone_dropdownpanel",
+      "phone_statusbar",
+    ]
+    hap_list = [
+      "SystemUI-phone_entry-default-unsigned:SystemUI",
+      "SystemUI-default_navigationBar-phone_entry-default-unsigned:SystemUI-NavigationBar",
+      "SystemUI-default_notificationmanagement-phone_entry-default-unsigned:SystemUI-NotificationManagement",
+      "SystemUI-default_volumepanel-phone_entry-default-unsigned:SystemUI-VolumePanel",
+      "SystemUI-default_dialog-phone_entry-default-unsigned:SystemUI-SystemDialog",
+      "SystemUI-phone_dropdownpanel-phone_entry-default-unsigned:SystemUI-DropdownPanel",
+      "SystemUI-phone_statusbar-phone_entry-default-unsigned:SystemUI-StatusBar",
+    ]
+  }
+}
