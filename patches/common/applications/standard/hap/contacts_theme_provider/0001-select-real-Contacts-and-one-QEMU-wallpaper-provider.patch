+} else {
+  ohos_prebuilt_etc("contacts_hap") {
+    source = hap_src_dir + "Contacts.hap"
+    module_install_dir = "app/com.ohos.contacts"
+    part_name = "prebuilt_hap"
+    subsystem_name = "applications"
+  }
+}
+
+# One real renderer module per QEMU device profile. Other products retain their
+# existing providers and receive an empty dependency group here.
+group("wallpaper_hap") {
+  deps = []
+  if (defined(product_name) &&
+    (product_name == "arm64_virt" || product_name == "armv7a_virt" ||
+     product_name == "x86_64_virt")) {
+    if (defined(device_type) && device_type == "2in1") {
+      deps = [ "//applications/standard/theme:wallpaper_pad_hap" ]
+    } else {
+      deps = [ "//applications/standard/theme:wallpaper_phone_hap" ]
+    }
+  }
 }

