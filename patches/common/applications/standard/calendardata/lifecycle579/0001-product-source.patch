+int ReminderAgentService::Dump(int fd, const std::vector<std::u16string>& args)
+{
+    if (args.size() != 1 || args[0] != u"--calendar-reminders") {
+        return ReminderAgentServiceStub::Dump(fd, args);
+    }
+    const auto type = Security::AccessToken::AccessTokenKit::GetTokenTypeFlag(IPCSkeleton::GetCallingTokenID());
+    if (type != Security::AccessToken::ATokenTypeEnum::TOKEN_SHELL &&
+        type != Security::AccessToken::ATokenTypeEnum::TOKEN_NATIVE) {
+        return ERR_REMINDER_PERMISSION_DENIED;
+    }
+    auto manager = ReminderDataManager::GetInstance();
+    std::string snapshot;
+    if (manager == nullptr || !manager->DumpCalendarReminders(snapshot)) { return ERR_REMINDER_INVALID_PARAM; }
+    size_t offset = 0;
+    while (offset < snapshot.size()) {
+        const ssize_t written = write(fd, snapshot.data() + offset, snapshot.size() - offset);
+        if (written < 0 && errno == EINTR) { continue; }
+        if (written <= 0) { return ERR_REMINDER_INVALID_PARAM; }
+        offset += static_cast<size_t>(written);
+    }
+    return ERR_OK;
+}
