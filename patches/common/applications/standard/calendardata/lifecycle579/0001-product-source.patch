+namespace {
+std::string CalendarDumpHex(const std::string& value)
+{
+    static constexpr char DIGITS[] = "0123456789abcdef";
+    std::string result;
+    result.reserve(value.size() * 2);
+    for (const unsigned char byte : value) {
+        result.push_back(DIGITS[byte >> 4]); result.push_back(DIGITS[byte & 15]);
+    }
+    return result;
+}
+}
+
+bool ReminderDataManager::DumpCalendarReminders(std::string& output)
+{
+    std::lock_guard<std::mutex> lock(ReminderDataManager::MUTEX);
+    if (!IsSystemReady()) { return false; }
+    std::string rows;
+    size_t count = 0;
+    for (const auto& reminder : reminderVector_) {
+        if (reminder == nullptr || !reminder->IsShare() ||
+            reminder->GetReminderType() != ReminderRequest::ReminderType::CALENDAR) { continue; }
+        const auto want = reminder->GetWantAgentInfo();
+        rows += "CALENDAR_PENDING579_ROW {\"id\":" + std::to_string(reminder->GetReminderId()) +
+            ",\"notification_id\":" + std::to_string(reminder->GetNotificationId()) +
+            ",\"uid\":" + std::to_string(reminder->GetUid()) +
+            ",\"user\":" + std::to_string(reminder->GetUserId()) +
+            ",\"identifier_hex\":\"" + CalendarDumpHex(reminder->GetIdentifier()) +
+            "\",\"bundle_hex\":\"" + CalendarDumpHex(reminder->GetBundleName()) +
+            "\",\"title_hex\":\"" + CalendarDumpHex(reminder->GetTitle()) +
+            "\",\"uri_hex\":\"" + CalendarDumpHex(want == nullptr ? "" : want->uri) +
+            "\",\"trigger_ms\":" + std::to_string(reminder->GetTriggerTimeInMilli()) +
+            ",\"state\":" + std::to_string(reminder->GetState()) +
+            ",\"expired\":" + std::string(reminder->IsExpired() ? "true" : "false") + "}\n";
+        ++count;
+        if (rows.size() > 16 * 1024 * 1024) { return false; }
+    }
+    output = "CALENDAR_PENDING579_BEGIN {\"schema\":1,\"ready\":true,\"rows\":" +
+        std::to_string(count) + "}\n" + rows + "CALENDAR_PENDING579_END {\"rows\":" +
+        std::to_string(count) + "}\n";
+    return true;
 }
 
