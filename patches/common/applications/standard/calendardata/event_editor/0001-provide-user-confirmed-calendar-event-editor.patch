+void CalendarManagerNapi::FinishEditor(napi_env env, std::shared_ptr<EditEventContext> ctxt,
+    napi_deferred deferred, bool failed, int32_t code, const std::string &message, bool closeModal)
+{
+    if (ctxt->settled) {
+        return;
+    }
+    // Callbacks may reenter while CloseModalUIExtension destroys the session.
+    ctxt->settled = true;
+    napi_value result = nullptr;
+    if (failed) {
+        napi_value text = nullptr;
+        napi_value errorCode = nullptr;
+        napi_create_string_utf8(env, message.c_str(), NAPI_AUTO_LENGTH, &text);
+        napi_create_error(env, nullptr, text, &result);
+        napi_create_int32(env, code, &errorCode);
+        napi_set_named_property(env, result, "code", errorCode);
+        napi_reject_deferred(env, deferred, result);
+    } else {
+        // Never retain a napi_value beyond its callback/handle scope.
+        napi_create_int32(env, ctxt->eventId, &result);
+        napi_resolve_deferred(env, deferred, result);
+    }
+    if (closeModal && !ctxt->closed && ctxt->_uiContent != nullptr && ctxt->_sessionId > 0) {
+        ctxt->closed = true;
+        ctxt->_uiContent->CloseModalUIExtension(ctxt->_sessionId);
+    }
+}
