{
  "module": {
    "name": "entry",
    "type": "entry",
    "srcEntry": "./ets/Application/Application.ets",
    "description": "$string:description_mainability",
    "mainElement": "MainAbility",
    "deviceTypes": [
      "default",
      "tablet"
    ],
    "installationFree": false,
    "deliveryWithInstall": true,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "MainAbility",
        "srcEntry": "./ets/MainAbility/MainAbility.ets",
        "description": "$string:description_mainability",
        "icon": "$media:icon",
        "label": "$string:app_name",
        "exported": true,
        "launchType": "standard",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:yellow",
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          {
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "calendar",
                "host": "com.ohos.calendardata"
              },
              {
                "scheme": "calendar",
                "host": "com.ohos.calendar"
              }
            ]
          }
        ]
      },
      {
        "name": "Application",
        "srcEntry": "./ets/Application/Application.ets",
        "icon": "$media:icon",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:yellow",
        "exported": true
      }
    ],
    "extensionAbilities": [
      {
        "name": "EditorUIExtensionAbility",
        "srcEntry": "./ets/EditorUIExtensionAbility.ets",
        "type": "sys/commonUI",
        "exported": true,
        "extensionProcessMode": "instance"
      },
      {
        "name": "DataShareLowerExtAbility",
        "srcEntry": "./ets/DataAbility/DataShareLowerExtAbility.ets",
        "type": "dataShare",
        "uri": "datashare://calendardata",
        "exported": true,
        "writePermission": "ohos.permission.WRITE_CALENDAR",
        "readPermission": "ohos.permission.READ_CALENDAR"
      },
      {
        "name": "DataShareHighExtAbility",
        "srcEntry": "./ets/DataAbility/DataShareHighExtAbility.ets",
        "type": "dataShare",
        "uri": "datashare://calendardata_whole",
        "exported": true,
        "writePermission": "ohos.permission.WRITE_WHOLE_CALENDAR",
        "readPermission": "ohos.permission.READ_WHOLE_CALENDAR"
      },
      {
        "name": "ReminderCallbackExtAbility",
        "srcEntry": "./ets/ServiceExtensionAbility/ReminderCallbackExtAbility.ets",
        "type": "service",
        "exported": true,
        "permissions": [
          "ohos.permission.UPDATE_CALENDAR_RRULE"
        ]
      }
    ],
    "metadata": [
      {
        "name": "hmos.app.quickfix",
        "value": "true"
      },
      {
        "name": "ohos.calendardata.reminderDbVersion",
        "value": "2"
      },
      {
        "name": "ohos.calendardata.supportReminderSwitch",
        "value": "true"
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.PUBLISH_AGENT_REMINDER"
      },
      {
        "name": "ohos.permission.NOTIFICATION_CONTROLLER"
      },
      {
        "name": "ohos.permission.NOTIFICATION_AGENT_CONTROLLER"
      },
      {
        "name": "ohos.permission.PERMISSION_USED_STATS"
      },
      {
        "name": "ohos.permission.WRITE_WHOLE_CALENDAR",
        "reason": "$string:description_apply_for_calendar_permission",
        "usedScene": {
          "abilities": [
            "DataShareLowerExtAbility",
            "DataShareHighExtAbility",
            "ReminderCallbackExtAbility",
            "EditorUIExtensionAbility",
            "MainAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_WHOLE_CALENDAR",
        "reason": "$string:description_apply_for_calendar_permission",
        "usedScene": {
          "abilities": [
            "DataShareLowerExtAbility",
            "DataShareHighExtAbility",
            "ReminderCallbackExtAbility",
            "EditorUIExtensionAbility",
            "MainAbility"
          ],
          "when": "inuse"
        }
      }
    ],
    "proxyData": [
      {
        "uri": "datashareproxy://com.ohos.calendardata/Calendars",
        "requiredReadPermission": "ohos.permission.READ_WHOLE_CALENDAR",
        "metadata": {
          "name": "dataProperties",
          "resource": "$profile:calendars_proxy"
        }
      },
      {
        "uri": "datashareproxy://com.ohos.calendardata/CalendarAlerts",
        "requiredWritePermission": "ohos.permission.WRITE_WHOLE_CALENDAR",
        "requiredReadPermission": "ohos.permission.READ_WHOLE_CALENDAR",
        "metadata": {
          "name": "dataProperties",
          "resource": "$profile:calendar_alerts_proxy"
        }
      },
      {
        "uri": "datashareproxy://com.ohos.calendardata/Instances",
        "requiredReadPermission": "ohos.permission.READ_WHOLE_CALENDAR",
        "metadata": {
          "name": "dataProperties",
          "resource": "$profile:instances_proxy"
        }
      },
      {
        "uri": "datashareproxy://com.ohos.calendardata/CalendarMetaData",
        "requiredReadPermission": "ohos.permission.READ_WHOLE_CALENDAR",
        "metadata": {
          "name": "dataProperties",
          "resource": "$profile:calendar_metadata_proxy"
        }
      },
      {
        "uri": "datashareproxy://com.ohos.calendardata/Events",
        "requiredReadPermission": "ohos.permission.READ_WHOLE_CALENDAR",
        "metadata": {
          "name": "dataProperties",
          "resource": "$profile:events_proxy"
        }
      },
      {
        "uri": "datashareproxy://com.ohos.calendardata/Attendees",
        "requiredReadPermission": "ohos.permission.READ_WHOLE_CALENDAR",
        "metadata": {
          "name": "dataProperties",
          "resource": "$profile:attendees_proxy"
        }
      },
      {
        "uri": "datashareproxy://com.ohos.calendardata/Participants",
        "requiredReadPermission": "ohos.permission.READ_WHOLE_CALENDAR",
        "metadata": {
          "name": "dataProperties",
          "resource": "$profile:participants_proxy"
        }
      },
      {
        "uri": "datashareproxy://com.ohos.calendardata/Reminders",
        "requiredReadPermission": "ohos.permission.READ_WHOLE_CALENDAR",
        "metadata": {
          "name": "dataProperties",
          "resource": "$profile:reminders_proxy"
        }
      },
      {
        "uri": "datashareproxy://com.ohos.calendardata/CalendarCacheWhole",
        "requiredReadPermission": "ohos.permission.READ_WHOLE_CALENDAR",
        "metadata": {
          "name": "dataProperties",
          "resource": "$profile:calendar_cache_proxy"
        }
      }
    ]
  }
}
