+# Copyright (c) 2026 Harmony Contrib
+# SPDX-License-Identifier: Apache-2.0
+import("//build/ohos.gni")
+
+# Compile the complete fixed CommunicationSetting application; never reuse its
+# prebuilt ABC after changing its exported policy protocol.
+ohos_app("communicationsetting_hap") {
+  deps = []
+  certificate_profile = "signature/CommunicationSetting.p7b"
+  hap_name = "CommunicationSetting"
+  part_name = "prebuilt_hap"
+  subsystem_name = "applications"
+  module_install_dir = "app/com.ohos.communicationsetting"
+  sdk_home = "//prebuilts/ohos-sdk/linux"
+  sdk_type_name = [ "sdk.dir" ]
+  assemble_type = "assembleHap"
+  build_level = "module"
+  js_build_mode = "release"
+  build_modules = [ "entry" ]
+  hap_list = [ "CommunicationSetting-entry-default-unsigned:CommunicationSetting" ]
+}
