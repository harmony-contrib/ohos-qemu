diff --git a/src/build/config/ohos/BUILD.gn b/src/build/config/ohos/BUILD.gn
--- a/src/build/config/ohos/BUILD.gn
+++ b/src/build/config/ohos/BUILD.gn
@@ -151,6 +151,19 @@ config("runtime_library") {
   } else {
     defines = [ "__BUILD_LINUX_WITH_CLANG" ]
   }
+
+  # Chromium's mainline Clang treats linux-ohos as a generic Linux target and
+  # otherwise injects crtbegin/crtend and compiler-rt from its own resource
+  # directory. The API 26 SDK supplies the OHOS runtime explicitly below.
+  if (llvm_ohos_mainline) {
+    ldflags += [
+      "-nostartfiles",
+      "-nodefaultlibs",
+      "-lm",
+      "-lunwind",
+      "-lc",
+    ]
+  }
   if (use_musl) {
     llvm_version = "15.0.4"
     dynamic_linker = "/lib/ld-musl-arm.so.1"
