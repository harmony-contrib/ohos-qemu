 LocationErrCode GnssAbility::SendLocationRequest(WorkRecord &workrecord)
 {
+    // RequestConfig/WorkRecord intervals are seconds; the HDI field is ms.
+    // Use the fastest active request, including an explicit zero interval.
+    const int size = workrecord.Size();
+    int64_t intervalMs = std::numeric_limits<uint32_t>::max();
+    for (int i = 0; i < size; ++i) {
+        const int seconds = workrecord.GetTimeInterval(i);
+        if (seconds < 0) {
+            return ERRCODE_INVALID_PARAM;
+        }
+        const int64_t requestedMs = static_cast<int64_t>(seconds) * EVENT_INTERVAL_UNITE;
+        intervalMs = std::min(intervalMs, requestedMs);
+    }
+    const int64_t previousInterval = fixInterval_;
+    if (size > 0) {
+        fixInterval_ = intervalMs;
+        if (gnssWorkingStatus_.load() == GNSS_WORKING_STATUS_SESSION_BEGIN &&
+            previousInterval != fixInterval_) {
+            const auto error = SetPositionMode();
+            if (error != ERRCODE_SUCCESS) {
+                fixInterval_ = previousInterval;
+                return error;
+            }
+        }
+    }
     LocationRequest(workrecord);
+    if (size > 0 && gnssWorkingStatus_.load() != GNSS_WORKING_STATUS_SESSION_BEGIN) {
+        return ERRCODE_SERVICE_UNAVAILABLE;
+    }
     return ERRCODE_SUCCESS;
 }

