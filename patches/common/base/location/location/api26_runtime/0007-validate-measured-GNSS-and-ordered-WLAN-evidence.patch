@@ -15,6 +15,7 @@
 
 #ifdef FEATURE_GNSS_SUPPORT
 #include "gnss_event_callback.h"
+#include <cmath>
 #include <singleton.h>
 #include <sys/time.h>
 #include "ipc_skeleton.h"
@@ -47,6 +48,16 @@
 
 int32_t GnssEventCallback::ReportLocation(const LocationInfo& location)
 {
+    // An HDI report with unmeasured/default coordinates is not a location fix.
+    using GnssValidity = HDI::Location::Gnss::V2_0::GnssLocationValidity;
+    constexpr uint32_t requiredFields = GnssValidity::GNSS_LOCATION_LAT_VALID | GnssValidity::GNSS_LOCATION_LONG_VALID |
+        GnssValidity::GNSS_LOCATION_HORIZONTAL_ACCURACY_VALID;
+    if ((location.fieldValidity & requiredFields) != requiredFields ||
+        !std::isfinite(location.latitude) || std::abs(location.latitude) > 90 ||
+        !std::isfinite(location.longitude) || std::abs(location.longitude) > 180 ||
+        !std::isfinite(location.horizontalAccuracy) || location.horizontalAccuracy < 0) {
+        return ERR_INVALID_VALUE;
+    }
     auto gnssAbility = GnssAbility::GetInstance();
     std::string identity = IPCSkeleton::ResetCallingIdentity();
     std::shared_ptr<Location> locationNew = std::make_shared<Location>();
@@ -80,7 +91,11 @@
         "latitude", std::to_string(location.latitude),
         "longitude", std::to_string(location.longitude)});
     gnssAbility->ReportLocationInfo(GNSS_ABILITY, locationNew);
-    SetGpsTime(locationNew->GetTimeStamp());
+    // UTC is optional independently of the measured position. Never discipline
+    // the system clock from a missing or invalid UTC field.
+    if ((location.fieldValidity & GnssValidity::GNSS_LOCATION_TIME_VALID) != 0 && location.timeForFix > 0) {
+        SetGpsTime(location.timeForFix);
+    }
     IPCSkeleton::SetCallingIdentity(identity);
     return ERR_OK;
 }
