+struct FusionPoint {
+    double latitude = 0;
+    double longitude = 0;
+    bool Valid() const
+    {
+        return std::isfinite(latitude) && std::abs(latitude) <= 90 &&
+            std::isfinite(longitude) && std::abs(longitude) <= 180;
+    }
+};
+struct FusionGnssFence {
+    int32_t type = 0;
+    FusionPoint center;
