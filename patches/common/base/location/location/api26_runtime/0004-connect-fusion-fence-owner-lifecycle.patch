+            !p.WriteInt32(loiterMs) || !p.WriteDouble(expirationMs) || !p.WriteInt32(gnss.size())) { return false; }
+        for (const auto& s : gnss) {
+            if (!p.WriteInt32(s.type) || !WritePoint(p, s.center) || !p.WriteDouble(s.radius) ||
+                !p.WriteDouble(s.expirationMs) || !p.WriteInt32(s.coordinateSystem) || !p.WriteInt32(s.polygon.size())) { return false; }
+            for (const auto& point : s.polygon) { if (!WritePoint(p, point)) { return false; } }
+        }
+        if (!p.WriteInt32(cells.size())) { return false; }
+        for (const auto& group : cells) {
+            if (!p.WriteInt32(group.size())) { return false; }
+            for (const auto& c : group) {
+                if (!p.WriteInt64(c.cellId) || !p.WriteInt32(c.lac) || !p.WriteInt32(c.mcc) ||
+                    !p.WriteInt32(c.mnc) || !p.WriteInt32(c.rat) || !p.WriteInt32(c.pci) ||
+                    !p.WriteBool(c.hasTac) || !p.WriteInt32(c.tac)) { return false; }
+            }
+        }
+        if (!p.WriteInt32(wifi.size())) { return false; }
+        for (const auto& group : wifi) {
+            if (!p.WriteInt32(group.type) || !p.WriteInt32(group.features.size())) { return false; }
+            for (const auto& f : group.features) {
+                if (!p.WriteInt32(f.average) || !p.WriteDouble(f.deviation) || !p.WriteInt32(f.macs.size())) {
+                    return false;
+                }
+                for (const auto& mac : f.macs) { if (!p.WriteString(mac)) { return false; } }
+            }
+        }
+        return true;
+    }
+
+    static FusionFenceRequest* Unmarshalling(Parcel& p)
+    {
+        auto r = std::make_unique<FusionFenceRequest>();
+        if (!r->Read(p) || !r->Valid()) { return nullptr; }
+        return r.release();
+    }
+private:
+    static bool WritePoint(Parcel& p, const FusionPoint& point)
+    { return p.WriteDouble(point.latitude) && p.WriteDouble(point.longitude); }
+    static bool ReadPoint(Parcel& p, FusionPoint& point)
+    { return p.ReadDouble(point.latitude) && p.ReadDouble(point.longitude); }
+    template<class T, class Reader>
+    static bool ReadItems(Parcel& p, std::vector<T>& out, Reader reader)
+    {
+        int32_t count = 0;
+        if (!p.ReadInt32(count) || count < 0 || count > static_cast<int32_t>(MAX_ITEMS)) { return false; }
+        out.resize(count);
+        for (auto& item : out) { if (!reader(item)) { return false; } }
+        return true;
+    }
+    bool Read(Parcel& p)
