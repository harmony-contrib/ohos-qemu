+struct FusionFenceRecord {
+    FusionFenceRequest params;
+    AppIdentity owner;
+    sptr<IRemoteObject> callback;
+    sptr<IRemoteObject::DeathRecipient> death;
+    sptr<ILocatorCallback> locationCallback;
+    sptr<ILocatingRequiredDataCallback> wifiCallback;
+    std::shared_ptr<Request> permissionRequest;
+    // Only producer start/stop operations take this lock. Data callbacks never do.
+    std::mutex producerMutex;
+    uint64_t generation = 0;
+    uint64_t shapeMask = 0;
+    int64_t created = 0;
+    int64_t expires = 0;
+    bool active = false;
+    bool cancelled = false;
+    bool gnssStarted = false;
+    bool wifiStarted = false;
+    bool knownState = false;
+    bool inside = false;
+    bool dwellReported = false;
+    bool cellInside = false;
+    int64_t cellTime = 0;
+    bool wifiInside = false;
+    int64_t wifiTime = 0;
+    double gnssDistance = 0;
+    double accuracy = 0;
+    int64_t gnssTime = 0;
+    int64_t evaluatedGnssTime = 0;
+    int64_t insideSince = 0;
+    double lastDistance = 0;
+    int lastDirection = 0;
+    int directionChanges = 0;
+    int64_t nearSince = 0;
+};
