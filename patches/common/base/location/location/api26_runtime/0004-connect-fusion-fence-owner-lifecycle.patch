+{ return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; }
+SphereVector FusionCross(const SphereVector& a, const SphereVector& b)
+{ return {a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]}; }
+double FusionNorm(const SphereVector& a) { return std::sqrt(FusionDot(a, a)); }
+double FusionAngle(const SphereVector& a, const SphereVector& b)
+{ return std::atan2(FusionNorm(FusionCross(a, b)), std::clamp(FusionDot(a, b), -1.0, 1.0)); }
+// Signed distance is negative inside. Spherical geometry also covers the antimeridian.
+double FusionShapeDistance(const FusionGnssFence& shape, const FusionPoint& p)
+{
+    const auto point = FusionUnit(p);
+    if (shape.type == 2) {
+        return FusionAngle(point, FusionUnit(shape.center)) * FUSION_EARTH_RADIUS - shape.radius;
+    }
+    double winding = 0;
+    double nearest = FUSION_PI;
+    SphereVector normalSum {0, 0, 0};
+    SphereVector centroidSum {0, 0, 0};
+    for (size_t i = 0; i < shape.polygon.size(); ++i) {
+        auto a = FusionUnit(shape.polygon[i]);
+        auto b = FusionUnit(shape.polygon[(i + 1) % shape.polygon.size()]);
+        auto normal = FusionCross(a, b);
+        for (size_t j = 0; j < 3; ++j) { normalSum[j] += normal[j]; centroidSum[j] += a[j]; }
+        double norm = FusionNorm(normal);
+        if (norm < 1e-12) { return std::numeric_limits<double>::quiet_NaN(); }
+        for (auto& value : normal) { value /= norm; }
+        double height = std::clamp(FusionDot(point, normal), -1.0, 1.0);
+        SphereVector foot;
+        for (size_t j = 0; j < 3; ++j) { foot[j] = point[j] - height * normal[j]; }
+        double footNorm = FusionNorm(foot);
+        double edgeDistance = std::min(FusionAngle(point, a), FusionAngle(point, b));
+        if (footNorm > 1e-12) {
+            for (auto& value : foot) { value /= footNorm; }
+            if (FusionAngle(a, foot) + FusionAngle(foot, b) <= FusionAngle(a, b) + 1e-8) {
+                edgeDistance = std::min(edgeDistance, std::asin(std::abs(height)));
+            }
+        }
+        nearest = std::min(nearest, edgeDistance);
+        winding += std::atan2(FusionDot(point, FusionCross(a, b)),
+            FusionDot(a, b) - FusionDot(point, a) * FusionDot(point, b));
+    }
+    double orientation = FusionDot(normalSum, centroidSum);
+    if (std::abs(orientation) < 1e-12) { return std::numeric_limits<double>::quiet_NaN(); }
+    return (std::abs(winding) > FUSION_PI && winding * orientation > 0 ? -nearest : nearest) * FUSION_EARTH_RADIUS;
+}
+bool FusionOwnerAvailable(const AppIdentity& identity)
+{
+    return PermissionManager::CheckLocationPermission(identity.GetTokenId(), identity.GetFirstTokenId()) &&
+        PermissionManager::CheckSystemPermission(identity.GetTokenId(), identity.GetTokenIdEx()) &&
+        CommonUtils::IsAppBelongCurrentAccount(identity) &&
+        LocationDataRdbManager::QuerySwitchStateWithUid(identity.GetUid()) == ENABLED &&
+        (!ReportManager::GetInstance()->IsAppBackground(identity.GetBundleName(), identity.GetTokenId(),
+            identity.GetTokenIdEx(), identity.GetUid(), identity.GetPid()) ||
+        PermissionManager::CheckBackgroundPermission(identity.GetTokenId(), identity.GetFirstTokenId()));
+}
+class FusionLocationCallback final : public IRemoteStub<ILocatorCallback> {
+public:
+    explicit FusionLocationCallback(std::weak_ptr<FusionFenceRecord> record) : record_(std::move(record)) {}
+    void OnLocationReport(const std::unique_ptr<Location>& location) override
+    {
+        if (auto record = record_.lock()) { LocatorAbility::GetInstance()->OnFusionFenceLocation(record, location); }
+    }
+    void OnLocatingStatusChange(int status) override {}
+    void OnErrorReport(int error) override {}
+private:
+    std::weak_ptr<FusionFenceRecord> record_;
+};
+class FusionWifiCallback final : public IRemoteStub<ILocatingRequiredDataCallback> {
+public:
+    explicit FusionWifiCallback(std::weak_ptr<FusionFenceRecord> record) : record_(std::move(record)) {}
+    void OnLocatingDataChange(const std::vector<std::shared_ptr<LocatingRequiredData>>& result) override
+    {
+        if (auto record = record_.lock()) { LocatorAbility::GetInstance()->OnFusionFenceWifi(record, result); }
+    }
+    void OnMatchingWlanInfoChange(const std::vector<MatchingWlanInfo>& info) override {}
+private:
+    std::weak_ptr<FusionFenceRecord> record_;
+};
+class FusionCallbackDeath final : public IRemoteObject::DeathRecipient {
+public:
+    explicit FusionCallbackDeath(std::weak_ptr<FusionFenceRecord> record) : record_(std::move(record)) {}
+    void OnRemoteDied(const wptr<IRemoteObject>& remote) override
+    {
+        if (auto record = record_.lock()) { LocatorAbility::GetInstance()->RemoveFusionFenceRecord(record); }
+    }
+private:
+    std::weak_ptr<FusionFenceRecord> record_;
+};
+bool FusionSameOwner(const AppIdentity& a, const AppIdentity& b)
+{
+    return a.GetUid() == b.GetUid() && a.GetTokenId() == b.GetTokenId() &&
+        a.GetFirstTokenId() == b.GetFirstTokenId();
+}
+std::string FusionLowerMac(std::string value)
+{
+    std::transform(value.begin(), value.end(), value.begin(), [](unsigned char c) {
+        return c >= 'A' && c <= 'F' ? c - 'A' + 'a' : c;
+    });
+    return value;
+}
+bool FusionWifiMatches(const FusionFenceRequest& request, const std::map<std::string, int32_t>& scanned)
+{
+    for (const auto& fence : request.wifi) {
+        bool matches = true;
+        for (const auto& feature : fence.features) {
+            bool found = false;
+            for (const auto& mac : feature.macs) {
+                auto item = scanned.find(FusionLowerMac(mac));
+                if (item != scanned.end() && std::abs(static_cast<double>(item->second) - feature.average) <=
+                    std::max(1.0, 2 * feature.deviation)) { found = true; break; }
+            }
+            if (!found) { matches = false; break; }
+        }
+        if (matches) { return true; }
+    }
+    return false;
+}
