+LocationErrCode LocatorRequiredDataManager::QueryFusionCells(std::vector<std::shared_ptr<CellularInfo>>& result)
+{
+    result.clear();
+#ifndef TEL_CORE_SERVICE_ENABLE
+    return ERRCODE_NOT_SUPPORTED;
+#else
+    auto& client = DelayedRefSingleton<Telephony::CoreServiceClient>::GetInstance();
+    // Query as the native location service, after the fence has checked its
+    // original owner. Never forward an untrusted binder identity to core_service.
+    struct CallingIdentityGuard {
+        std::string saved = IPCSkeleton::ResetCallingIdentity();
+        ~CallingIdentityGuard() { IPCSkeleton::SetCallingIdentity(saved); }
+    } identityGuard;
+    int32_t slots = client.GetMaxSimCount();
+    if (slots <= 0 || slots > 8) { return ERRCODE_SERVICE_UNAVAILABLE; }
+    int64_t nowNs = CommonUtils::GetSinceBootTime();
+    int64_t nowMs = nowNs / FusionFenceRequest::NS_PER_MS;
+    for (int32_t slot = 0; slot < slots; ++slot) {
+        std::vector<sptr<Telephony::CellInformation>> cells;
+        if (client.GetCellInfoList(slot, cells) != Telephony::TELEPHONY_SUCCESS) {
+            result.clear();
+            return ERRCODE_SERVICE_UNAVAILABLE;
+        }
+        for (const auto& source : cells) {
+            if (source == nullptr || source->GetTimeStamp() == 0 || source->GetTimeStamp() > static_cast<uint64_t>(nowMs) ||
+                nowNs - static_cast<int64_t>(source->GetTimeStamp()) * FusionFenceRequest::NS_PER_MS >
+                    30LL * 1000000000) { continue; }
+            auto cell = std::make_shared<CellularInfo>();
+            auto parsePlmn = [](const std::string& value, int32_t& number) {
+                if (value.empty() || value.size() > 3) { return false; }
+                number = 0;
+                for (char digit : value) {
+                    if (digit < '0' || digit > '9') { return false; }
+                    number = number * 10 + digit - '0';
+                }
+                return true;
+            };
+            int32_t mcc = 0;
+            int32_t mnc = 0;
+            if (!parsePlmn(source->GetMcc(), mcc) || !parsePlmn(source->GetMnc(), mnc)) { continue; }
+            cell->SetMcc(mcc);
+            cell->SetMnc(mnc);
+            cell->SetCellId(source->GetCellId());
+            cell->SetRat(static_cast<int32_t>(source->GetNetworkType()));
+            cell->SetSignalIntensity(source->GetSignalIntensity());
+            // CellInformation stamps are boot milliseconds in its actual Init/
+            // Set* producer. Preserve that age rather than relabel cached data.
+            cell->SetTimeSinceBoot(static_cast<int64_t>(source->GetTimeStamp()) * FusionFenceRequest::NS_PER_MS);
+            using CellType = Telephony::CellInformation::CellType;
+            switch (source->GetNetworkType()) {
+                case CellType::CELL_TYPE_GSM: {
+                    auto value = static_cast<Telephony::GsmCellInformation*>(source.GetRefPtr());
+                    cell->SetLac(value->GetLac()); cell->SetArfcn(value->GetArfcn()); break;
+                }
+                case CellType::CELL_TYPE_LTE: {
+                    auto value = static_cast<Telephony::LteCellInformation*>(source.GetRefPtr());
+                    cell->SetLac(value->GetTac()); cell->SetPci(value->GetPci());
+                    cell->SetArfcn(value->GetArfcn()); break;
+                }
+                case CellType::CELL_TYPE_NR: {
+                    auto value = static_cast<Telephony::NrCellInformation*>(source.GetRefPtr());
+                    cell->SetCellId(value->GetNci()); cell->SetLac(value->GetTac());
+                    cell->SetPci(value->GetPci()); cell->SetArfcn(value->GetArfcn()); break;
+                }
+                case CellType::CELL_TYPE_WCDMA: {
+                    auto value = static_cast<Telephony::WcdmaCellInformation*>(source.GetRefPtr());
+                    cell->SetLac(value->GetLac()); cell->SetPci(value->GetPsc());
+                    cell->SetArfcn(value->GetArfcn()); break;
+                }
+                case CellType::CELL_TYPE_TDSCDMA: {
+                    auto value = static_cast<Telephony::TdscdmaCellInformation*>(source.GetRefPtr());
+                    cell->SetLac(value->GetLac()); cell->SetArfcn(value->GetArfcn()); break;
+                }
+                // The SDK cell key cannot faithfully carry CDMA SID/NID/BID.
+                default: continue;
+            }
+            if (cell->GetCellId() >= 0) { result.push_back(cell); }
+        }
+    }
+    return result.empty() ? ERRCODE_SERVICE_UNAVAILABLE : ERRCODE_SUCCESS;
+#endif
+}
