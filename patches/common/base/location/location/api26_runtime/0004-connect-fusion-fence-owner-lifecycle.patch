+ErrCode LocatorAbility::IsFusionFenceSupported(bool& supported)
+{
+    supported = false;
+    AppIdentity identity;
+    GetAppIdentityInfo(identity);
+    if (!PermissionManager::CheckSystemPermission(identity.GetTokenId(), identity.GetTokenIdEx())) {
+        return LOCATION_ERRCODE_SYSTEM_PERMISSION_DENIED;
+    }
+#if defined(FEATURE_GNSS_SUPPORT) || defined(WIFI_ENABLE) || defined(TEL_CORE_SERVICE_ENABLE)
+    supported = true;
+#endif
+    return ERRCODE_SUCCESS;
+}
+
+ErrCode LocatorAbility::AddFusionFence(const FusionFenceRequest& params, const sptr<IRemoteObject>& callback)
+{
+    AppIdentity identity;
+    GetAppIdentityInfo(identity);
+    if (!PermissionManager::CheckSystemPermission(identity.GetTokenId(), identity.GetTokenIdEx())) {
+        return LOCATION_ERRCODE_SYSTEM_PERMISSION_DENIED;
+    }
+    if (!CheckRequestAvailable(LocatorInterfaceCode::ADD_FUSION_FENCE, identity) ||
+        !PermissionManager::CheckLocationPermission(identity.GetTokenId(), identity.GetFirstTokenId())) {
+        return LOCATION_ERRCODE_PERMISSION_DENIED;
+    }
+    if (!params.Valid() || callback == nullptr) { return ERRCODE_INVALID_PARAM; }
+    if (LocationDataRdbManager::QuerySwitchStateWithUid(identity.GetUid()) != ENABLED) { return ERRCODE_SWITCH_OFF; }
+    // API 26 provides no BLE matching payload. Never accept that bitmap as
+    // a successful fence whose backend cannot evaluate its input.
+    if ((params.fenceType & 8) != 0 || ((params.events & (8 | 16 | 32)) != 0 &&
+        (params.fenceType & 1) == 0)) { return ERRCODE_NOT_SUPPORTED; }
+#ifndef FEATURE_GNSS_SUPPORT
+    if ((params.fenceType & 1) != 0) { return ERRCODE_NOT_SUPPORTED; }
+#endif
+#ifndef TEL_CORE_SERVICE_ENABLE
+    if ((params.fenceType & 2) != 0) { return ERRCODE_NOT_SUPPORTED; }
+#endif
+#ifndef WIFI_ENABLE
+    if ((params.fenceType & 4) != 0) { return ERRCODE_NOT_SUPPORTED; }
+#endif
+    for (const auto& shape : params.gnss) {
+        if (shape.type == 2 && shape.coordinateSystem != WGS84) { return ERRCODE_NOT_SUPPORTED; }
+        if (shape.type == 1 && !std::isfinite(FusionShapeDistance(shape, params.poi))) {
+            return ERRCODE_INVALID_PARAM;
+        }
+    }
+    std::vector<std::shared_ptr<CellularInfo>> initialCells;
+    if ((params.fenceType & 2) != 0) {
+        auto error = LocatorRequiredDataManager::GetInstance()->QueryFusionCells(initialCells);
+        if (error != ERRCODE_SUCCESS) { return error; }
+    }
+    if (!FusionOwnerAvailable(identity)) { return LOCATION_ERRCODE_PERMISSION_DENIED; }
+    if ((params.fenceType & 4) != 0 && LocatorRequiredDataManager::GetInstance()->RequestFusionWifiScan() != ERRCODE_SUCCESS) {
+        return ERRCODE_SERVICE_UNAVAILABLE;
+    }
+    if (locatorHandler_ == nullptr || requestManager_ == nullptr) { return ERRCODE_SERVICE_UNAVAILABLE; }
+    auto record = std::make_shared<FusionFenceRecord>();
+    record->params = params;
+    record->shapeMask = params.gnss.size() == 64 ? std::numeric_limits<uint64_t>::max() :
+        (uint64_t(1) << params.gnss.size()) - 1;
+    record->owner = identity;
+    record->callback = callback;
+    int64_t now = CommonUtils::GetSinceBootTime();
+    const long double durationNs = static_cast<long double>(params.expirationMs) * FusionFenceRequest::NS_PER_MS;
+    if (durationNs < 1 || durationNs >= std::numeric_limits<int64_t>::max() - now) { return ERRCODE_INVALID_PARAM; }
+    record->created = now;
+    record->expires = now + static_cast<int64_t>(durationNs);
+    {
+        std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+        size_t count = 0;
+        for (const auto& item : fusionFences_) {
+            if (FusionSameOwner(item->owner, identity)) {
+                if (item->params.identifier == params.identifier) { return static_cast<ErrCode>(3501603); }
+                ++count;
+            }
+        }
+        if (count >= 64 || fusionFences_.size() >= 1024) { return static_cast<ErrCode>(3301601); }
+        record->generation = ++fusionFenceSequence_;
+        fusionFences_.push_back(record);
+    }
+    ErrCode error = ERRCODE_SUCCESS;
+    {
+        std::lock_guard<std::mutex> producer(record->producerMutex);
+        record->death = new (std::nothrow) FusionCallbackDeath(record);
+        if (record->death == nullptr || (callback->IsProxyObject() && !callback->AddDeathRecipient(record->death))) {
+            error = ERRCODE_SERVICE_UNAVAILABLE;
+        }
+        auto config = std::make_unique<RequestConfig>();
+        config->SetPriority(PRIORITY_ACCURACY);
+        config->SetLocationSourceType(GNSS_TYPE);
+        config->SetNeedsFinePermission(true);
+        config->SetFixNumber(0);
+        config->SetTimeInterval(1);
+        record->locationCallback = new (std::nothrow) FusionLocationCallback(record);
+        record->permissionRequest = std::make_shared<Request>(config, record->locationCallback, identity);
+        record->permissionRequest->SetPermUsedType(static_cast<int>(
+            Security::AccessToken::AccessTokenKit::GetPermissionUsedType(identity.GetTokenId(), ACCESS_LOCATION)));
+        if (error == ERRCODE_SUCCESS && !requestManager_->UpdateUsingPermission(record->permissionRequest, true)) {
+            error = LOCATION_ERRCODE_PERMISSION_DENIED;
+        }
+        if (error == ERRCODE_SUCCESS && (params.fenceType & 1) != 0) {
+            requestManager_->HandleStartLocating(record->permissionRequest);
+            record->gnssStarted = true;
+        }
+        if (error == ERRCODE_SUCCESS && (params.fenceType & 4) != 0) {
+            auto scan = std::make_shared<LocatingRequiredDataConfig>();
+            scan->SetType(LocatingRequiredDataType::WIFI);
+            scan->SetNeedStartScan(true);
+            scan->SetScanIntervalMs(1000);
+            scan->SetFixNumber(0);
+            record->wifiCallback = new (std::nothrow) FusionWifiCallback(record);
+            if (record->wifiCallback == nullptr) { error = ERRCODE_SERVICE_UNAVAILABLE; }
+            else {
+                error = LocatorRequiredDataManager::GetInstance()->RegisterCallback(identity, scan,
+                    record->wifiCallback->AsObject());
+                record->wifiStarted = error == ERRCODE_SUCCESS;
+            }
+        }
+        {
+            std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+            record->active = error == ERRCODE_SUCCESS && !record->cancelled;
+            if (record->cancelled) { error = ERRCODE_SERVICE_UNAVAILABLE; }
+        }
+    }
+    if (error != ERRCODE_SUCCESS) {
+        RemoveFusionFenceRecord(record);
+        if (error != LOCATION_ERRCODE_PERMISSION_DENIED) { error = ERRCODE_SERVICE_UNAVAILABLE; }
+    }
+    else if ((params.fenceType & 2) != 0) { UpdateFusionFenceCells(record, initialCells); }
+    // Expiry/revocation maintenance is independent of a silent GNSS provider.
+    ScheduleFusionFenceCheck();
+    return error;
+}
+
+ErrCode LocatorAbility::RemoveFusionFence(const std::string& identifier)
+{
+    AppIdentity identity;
+    GetAppIdentityInfo(identity);
+    if (!PermissionManager::CheckSystemPermission(identity.GetTokenId(), identity.GetTokenIdEx())) {
+        return LOCATION_ERRCODE_SYSTEM_PERMISSION_DENIED;
+    }
+    std::shared_ptr<FusionFenceRecord> target;
+    {
+        std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+        for (const auto& item : fusionFences_) {
+            if (item->params.identifier == identifier && FusionSameOwner(item->owner, identity)) { target = item; break; }
+        }
+    }
+    if (target == nullptr) { return static_cast<ErrCode>(3301602); }
+    RemoveFusionFenceRecord(target);
+    return ERRCODE_SUCCESS;
+}
+
+ErrCode LocatorAbility::ReleaseFusionFence(const std::string& identifier, const sptr<IRemoteObject>& callback)
+{
+    AppIdentity identity;
+    GetAppIdentityInfo(identity);
+    if (!PermissionManager::CheckSystemPermission(identity.GetTokenId(), identity.GetTokenIdEx())) {
+        return LOCATION_ERRCODE_SYSTEM_PERMISSION_DENIED;
+    }
+    std::shared_ptr<FusionFenceRecord> target;
+    {
+        std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+        for (const auto& item : fusionFences_) {
+            if (item->params.identifier == identifier && item->callback == callback &&
+                FusionSameOwner(item->owner, identity)) { target = item; break; }
+        }
+    }
+    if (target == nullptr) { return static_cast<ErrCode>(3301602); }
+    RemoveFusionFenceRecord(target);
+    return ERRCODE_SUCCESS;
+}
+
+void LocatorAbility::RemoveFusionFenceRecord(const std::shared_ptr<FusionFenceRecord>& record)
+{
+    if (record == nullptr) { return; }
+    {
+        std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+        if (record->cancelled) { return; }
+        record->cancelled = true;
+        record->active = false;
+        fusionFences_.erase(std::remove(fusionFences_.begin(), fusionFences_.end(), record), fusionFences_.end());
+        stoppedFusionFences_.push_back(record);
+    }
+    std::lock_guard<std::mutex> producer(record->producerMutex);
+    if (record->callback != nullptr && record->death != nullptr) { record->callback->RemoveDeathRecipient(record->death); }
+    if (record->wifiStarted) {
+        LocatorRequiredDataManager::GetInstance()->UnregisterCallback(record->wifiCallback->AsObject());
+        record->wifiStarted = false;
+    }
+    if (record->gnssStarted) {
+        requestManager_->HandleStopLocating(record->locationCallback);
+        record->gnssStarted = false;
+    }
+    // The retired record retains ownership for a failed PrivacyKit stop. Tick
+    // retries the same request; a new fence cannot steal its reference count.
+    requestManager_->UpdateUsingPermission(record->permissionRequest, false);
+}
+
+void LocatorAbility::CheckFusionFences()
+{
+    {
+        std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+        fusionCheckScheduled_ = false;
+        if (fusionStopping_) { return; }
+    }
+    std::vector<std::shared_ptr<FusionFenceRecord>> active;
+    std::vector<std::shared_ptr<FusionFenceRecord>> retired;
+    {
+        std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+        active = fusionFences_;
+        retired = stoppedFusionFences_;
+    }
+    std::vector<std::shared_ptr<CellularInfo>> cells;
+    bool needsCells = std::any_of(active.begin(), active.end(), [](const auto& item) {
+        return (item->params.fenceType & 2) != 0;
+    });
+    bool cellsAvailable = needsCells && LocatorRequiredDataManager::GetInstance()->QueryFusionCells(cells) == ERRCODE_SUCCESS;
+    bool scanWifi = false;
+    {
+        std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+        int64_t now = CommonUtils::GetSinceBootTime();
+        if (now - lastFusionWifiScanNs_ >= 5LL * 1000000000 && std::any_of(active.begin(), active.end(),
+            [](const auto& record) { return (record->params.fenceType & 4) != 0 && record->active; })) {
+            lastFusionWifiScanNs_ = now;
+            scanWifi = true;
+        }
+    }
+    if (scanWifi) { LocatorRequiredDataManager::GetInstance()->RequestFusionWifiScan(); }
+    for (const auto& record : active) {
+        if ((record->params.fenceType & 2) != 0) { UpdateFusionFenceCells(record, cellsAvailable ? cells :
+            std::vector<std::shared_ptr<CellularInfo>>{}); }
+        const auto now = CommonUtils::GetSinceBootTime();
+        bool shapesExpired = record->params.fenceType == 1 && std::none_of(record->params.gnss.begin(),
+            record->params.gnss.end(), [&](const auto& shape) {
+                return shape.type == 1 || static_cast<long double>(now - record->created) <
+                    static_cast<long double>(shape.expirationMs) * FusionFenceRequest::NS_PER_MS;
+            });
+        if (now >= record->expires || shapesExpired || !FusionOwnerAvailable(record->owner)) {
+            RemoveFusionFenceRecord(record);
+        } else { EvaluateFusionFence(record); }
+    }
+    for (const auto& record : retired) {
+        std::lock_guard<std::mutex> producer(record->producerMutex);
+        if (requestManager_->UpdateUsingPermission(record->permissionRequest, false)) {
+            std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+            stoppedFusionFences_.erase(std::remove(stoppedFusionFences_.begin(), stoppedFusionFences_.end(), record),
+                stoppedFusionFences_.end());
+        }
+    }
+    ScheduleFusionFenceCheck();
+}
+
+void LocatorAbility::ScheduleFusionFenceCheck()
+{
+    std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+    if (fusionCheckScheduled_ || fusionStopping_ || locatorHandler_ == nullptr ||
+        (fusionFences_.empty() && stoppedFusionFences_.empty())) { return; }
+    fusionCheckScheduled_ = locatorHandler_->PostTask([this]() { CheckFusionFences(); }, FUSION_CHECK_TASK, 1000);
+}
+
+bool LocatorAbility::IsFusionFenceLocatingInCurrentAccount()
+{
+    std::vector<std::shared_ptr<FusionFenceRecord>> active;
+    {
+        std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+        for (const auto& record : fusionFences_) {
+            if (record->active && !record->cancelled && CommonUtils::GetSinceBootTime() < record->expires) {
+                active.push_back(record);
+            }
+        }
+    }
+    // No fence lock is held across RequestManager, permission or account APIs.
+    for (const auto& record : active) {
+        if (FusionOwnerAvailable(record->owner) && requestManager_->IsFinePermissionInUse(record->permissionRequest)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool LocatorAbility::HasFusionFences()
+{
+    std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+    return !fusionFences_.empty() || !stoppedFusionFences_.empty();
+}
+
+void LocatorAbility::ClearFusionFences()
+{
+    std::vector<std::shared_ptr<FusionFenceRecord>> records;
+    {
+        std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+        records = fusionFences_;
+        fusionStopping_ = true;
+        fusionCheckScheduled_ = false;
+    }
+    for (const auto& record : records) { RemoveFusionFenceRecord(record); }
+    if (locatorHandler_ != nullptr) { locatorHandler_->RemoveTask(FUSION_CHECK_TASK); }
+    // Keep failed stop records for retry if this singleton restarts.
+}
+
+void LocatorAbility::OnFusionFenceLocation(const std::shared_ptr<FusionFenceRecord>& record,
+    const std::unique_ptr<Location>& location)
+{
+    if (location == nullptr || location->GetIsFromMock() ||
+        (location->GetLocationSourceType() != GNSS_TYPE && location->GetLocationSourceType() != RTK_TYPE) ||
+        !std::isfinite(location->GetAccuracy()) || location->GetAccuracy() < 0) { return; }
+    FusionPoint point {location->GetLatitude(), location->GetLongitude()};
+    int64_t now = CommonUtils::GetSinceBootTime();
+    int64_t time = location->GetTimeSinceBoot();
+    if (!point.Valid() || time <= 0 || time > now || now - time > FUSION_GNSS_FRESH_NS) { return; }
+    double distance = std::numeric_limits<double>::infinity();
+    for (const auto& shape : record->params.gnss) {
+        if (shape.type == 1 || static_cast<long double>(now - record->created) <
+            static_cast<long double>(shape.expirationMs) * FusionFenceRequest::NS_PER_MS) {
+            distance = std::min(distance, FusionShapeDistance(shape, point));
+        }
+    }
+    if (!std::isfinite(distance)) { return; }
+    {
+        std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+        if (!record->active || record->cancelled || time <= record->gnssTime) { return; }
+        record->gnssDistance = distance;
+        record->accuracy = location->GetAccuracy();
+        record->gnssTime = time;
+    }
+    EvaluateFusionFence(record);
+}
+
+void LocatorAbility::OnFusionFenceWifi(const std::shared_ptr<FusionFenceRecord>& record,
+    const std::vector<std::shared_ptr<LocatingRequiredData>>& result)
+{
+    const int64_t now = CommonUtils::GetSinceBootTime();
+    const int64_t scanTime = LocatorRequiredDataManager::GetInstance()->GetWifiScanCompleteTimestamp();
+    if (scanTime < record->created || scanTime > now || now - scanTime > FUSION_WIFI_FRESH_NS) { return; }
+    int64_t evidenceTime = scanTime;
+    std::map<std::string, int32_t> scanned;
+    for (const auto& item : result) {
+        if (item != nullptr && item->GetType() == LocatingRequiredDataType::WIFI && item->GetWifiScanInfo() != nullptr &&
+            FusionFenceRequest::ValidMac(item->GetWifiScanInfo()->GetBssid())) {
+            auto stampUs = item->GetWifiScanInfo()->GetTimestamp();
+            if (stampUs <= 0 || stampUs > now / 1000 || now / 1000 - stampUs > FUSION_WIFI_FRESH_NS / 1000) { continue; }
+            evidenceTime = std::min(evidenceTime, stampUs * 1000);
+            scanned[FusionLowerMac(item->GetWifiScanInfo()->GetBssid())] = item->GetWifiScanInfo()->GetRssi();
+        }
+    }
+    // Empty/failing scan results do not prove an exit.
+    if (scanned.empty()) { return; }
+    {
+        std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+        if (!record->active || record->cancelled) { return; }
+        record->wifiInside = FusionWifiMatches(record->params, scanned);
+        record->wifiTime = evidenceTime;
+    }
+    EvaluateFusionFence(record);
+}
+
+void LocatorAbility::UpdateFusionFenceCells(const std::shared_ptr<FusionFenceRecord>& record,
+    const std::vector<std::shared_ptr<CellularInfo>>& cells)
+{
+    bool inside = false;
+    int64_t oldest = CommonUtils::GetSinceBootTime();
+    for (const auto& source : cells) {
+        if (source == nullptr) { continue; }
+        oldest = std::min(oldest, source->GetTimeSinceBoot());
+        for (const auto& group : record->params.cells) {
+            for (const auto& expected : group) {
+                if (expected.cellId == source->GetCellId() && expected.mcc == source->GetMcc() &&
+                    expected.mnc == source->GetMnc() && expected.rat == source->GetRat() &&
+                    (expected.hasTac ? expected.tac : expected.lac) == source->GetLac() && expected.pci == source->GetPci()) { inside = true; }
+            }
+        }
+    }
+    std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+    if (record->cancelled || !record->active) { return; }
+    record->cellInside = inside;
+    record->cellTime = cells.empty() ? 0 : oldest;
+}
+
+void LocatorAbility::EvaluateFusionFence(const std::shared_ptr<FusionFenceRecord>& record)
+{
+    if (!FusionOwnerAvailable(record->owner)) { RemoveFusionFenceRecord(record); return; }
+    bool frozen = ProxyFreezeManager::GetInstance()->IsProxyPid(record->owner.GetPid());
+    std::vector<int32_t> events;
+    {
+        std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+        int64_t now = CommonUtils::GetSinceBootTime();
+        if (!record->active || record->cancelled || now >= record->expires) { return; }
+        uint64_t mask = 0;
+        for (size_t index = 0; index < record->params.gnss.size(); ++index) {
+            const auto& shape = record->params.gnss[index];
+            if (shape.type == 1 || static_cast<long double>(now - record->created) <
+                static_cast<long double>(shape.expirationMs) * FusionFenceRequest::NS_PER_MS) { mask |= uint64_t(1) << index; }
+        }
+        if (mask != record->shapeMask) {
+            // Expiring a shape changes the set being monitored; it is not a
+            // physical boundary crossing. Require fresh evidence for that set.
+            record->shapeMask = mask;
+            record->knownState = false;
+            record->insideSince = 0;
+            record->gnssTime = 0;
+            record->dwellReported = false;
+        }
+        bool activeGnss = mask != 0;
+        bool gnssKnown = !activeGnss || (record->gnssTime > 0 &&
+            now - record->gnssTime <= FUSION_GNSS_FRESH_NS && std::abs(record->gnssDistance) > record->accuracy);
+        bool cellKnown = (record->params.fenceType & 2) == 0 || (record->cellTime > 0 &&
+            now - record->cellTime <= FUSION_CELL_FRESH_NS);
+        bool wifiKnown = (record->params.fenceType & 4) == 0 || (record->wifiTime > 0 &&
+            now - record->wifiTime <= FUSION_WIFI_FRESH_NS);
+        bool inside = (activeGnss && gnssKnown && record->gnssDistance < 0) ||
+            ((record->params.fenceType & 4) != 0 && wifiKnown && record->wifiInside) ||
+            ((record->params.fenceType & 2) != 0 && cellKnown && record->cellInside);
+        if (frozen || (!inside && (!gnssKnown || !wifiKnown || !cellKnown))) {
+            record->insideSince = 0;
+            record->dwellReported = false;
+            record->nearSince = 0;
+            return;
+        }
+        if (!record->knownState || record->inside != inside) {
+            if (inside) { events.push_back(1); }
+            else if (record->knownState) { events.push_back(2); }
+            record->knownState = true;
+            record->inside = inside;
+            record->insideSince = inside ? now : 0;
+            record->dwellReported = false;
+        }
+        if (inside && record->insideSince == 0) { record->insideSince = now; }
+        if (inside && !record->dwellReported && now - record->insideSince >=
+            static_cast<int64_t>(record->params.loiterMs) * FusionFenceRequest::NS_PER_MS) {
+            events.push_back(4);
+            record->dwellReported = true;
+        }
+        if (activeGnss && gnssKnown && record->gnssTime > record->evaluatedGnssTime) {
+            if (!inside && record->evaluatedGnssTime > 0) {
+                double delta = record->gnssDistance - record->lastDistance;
+                int direction = delta > record->accuracy ? 1 : delta < -record->accuracy ? -1 : 0;
+                if (direction != 0) {
+                    events.push_back(direction < 0 ? 8 : 16);
+                    if (record->lastDirection != 0 && record->lastDirection != direction) { ++record->directionChanges; }
+                    record->lastDirection = direction;
+                }
+            }
+            if (std::abs(record->gnssDistance) <= std::max(1.0, 2 * record->accuracy)) {
+                if (record->nearSince == 0) { record->nearSince = now; }
+                if (record->directionChanges >= 2 && now - record->nearSince >=
+                    static_cast<int64_t>(record->params.loiterMs) * FusionFenceRequest::NS_PER_MS) {
+                    events.push_back(32);
+                    record->directionChanges = 0;
+                    record->nearSince = now;
+                }
+            } else { record->nearSince = 0; record->directionChanges = 0; }
+            record->lastDistance = record->gnssDistance;
+            record->evaluatedGnssTime = record->gnssTime;
+        }
+    }
+    for (int32_t event : events) {
+        if ((record->params.events & event) == 0) { continue; }
+        // Revalidate after waiting for the state lock and before IPC dispatch.
+        if (!FusionOwnerAvailable(record->owner)) { RemoveFusionFenceRecord(record); return; }
+        {
+            std::lock_guard<std::mutex> lock(fusionFenceMutex_);
+            if (record->cancelled || !record->active || CommonUtils::GetSinceBootTime() >= record->expires) { return; }
+        }
+        MessageParcel data;
+        MessageParcel reply;
+        MessageOption option(MessageOption::TF_ASYNC);
+        if (!data.WriteInterfaceToken(FUSION_CALLBACK_DESCRIPTOR) || !data.WriteString(record->params.identifier) ||
+            !data.WriteInt32(record->params.scene) || !data.WriteInt32(event)) { continue; }
+        record->callback->SendRequest(1, data, reply, option);
+    }
 }

