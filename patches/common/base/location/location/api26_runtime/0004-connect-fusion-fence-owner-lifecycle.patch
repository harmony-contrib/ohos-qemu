+// A dedicated Promise path retains the registration until work completes and
+// rejects queue/cancellation failures instead of leaving a registered callback
+// behind an unresolved Promise.
+static napi_value RunFusionFencePromise(napi_env env, std::unique_ptr<FusionFenceAsyncContext> context)
+{
+    napi_value promise = nullptr;
+    if (napi_create_promise(env, &context->deferred, &promise) != napi_ok) { return nullptr; }
+    auto fail = [&]() {
+        context->errCode = ERRCODE_SERVICE_UNAVAILABLE;
+        context->completeFunc(context.get());
+        napi_value error = GetErrorObject(env, context->errCode, "The location service is unavailable.");
+        napi_reject_deferred(env, context->deferred, error);
+        if (context->work != nullptr) { napi_delete_async_work(env, context->work); }
+        return promise;
+    };
+    if (napi_create_async_work(env, nullptr, context->resourceName,
+        [](napi_env env, void* data) {
+            auto* context = static_cast<FusionFenceAsyncContext*>(data);
+            context->executeFunc(context);
+        },
+        [](napi_env env, napi_status status, void* data) {
+            std::unique_ptr<FusionFenceAsyncContext> context(static_cast<FusionFenceAsyncContext*>(data));
+            if (status != napi_ok) { context->errCode = ERRCODE_SERVICE_UNAVAILABLE; }
+            context->completeFunc(context.get());
+            if (context->errCode == ERRCODE_SUCCESS) {
+                napi_resolve_deferred(env, context->deferred, context->result[PARAM1]);
+            } else {
+                napi_value error = GetErrorObject(env, context->errCode, CommonUtils::GetErrorMsgByCode(context->errCode));
+                napi_reject_deferred(env, context->deferred, error);
+            }
+            napi_delete_async_work(env, context->work);
+        }, context.get(), &context->work) != napi_ok) { return fail(); }
+    if (napi_queue_async_work(env, context->work) != napi_ok) { return fail(); }
+    context->isAsyncWorkAddToQueue = true;
+    context.release();
+    return promise;
+}
