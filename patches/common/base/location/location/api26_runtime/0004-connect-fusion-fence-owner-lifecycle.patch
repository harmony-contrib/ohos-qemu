+napi_value RemoveFusionFence(napi_env env, napi_callback_info info)
+{
+    size_t argc = 2;
+    napi_value argv[2] = {nullptr};
+    NAPI_CALL(env, napi_get_cb_info(env, info, &argc, argv, nullptr, nullptr));
+    auto context = std::make_unique<FusionFenceAsyncContext>(env);
+    if (argc != 1 || !FusionJsText(env, argv[0], context->identifier) || context->identifier.empty()) {
+        HandleSyncErrCode(env, ERRCODE_INVALID_PARAM);
+        return nullptr;
+    }
+    context->client = Locator::GetInstance();
+    {
+        std::lock_guard<std::mutex> guard(g_fusionFenceMutex);
+        for (const auto& item : g_fusionFenceRegistrations) {
+            if (item->env == env && item->identifier == context->identifier) { context->removals.push_back(item); }
+        }
+    }
+    NAPI_CALL(env, napi_create_string_utf8(env, "removeFusionFence", NAPI_AUTO_LENGTH, &context->resourceName));
+    context->executeFunc = [](void* data) {
+        auto context = static_cast<FusionFenceAsyncContext*>(data);
+        context->errCode = context->client == nullptr ? ERRCODE_SERVICE_UNAVAILABLE :
+            context->client->RemoveFusionFenceV9(context->identifier);
+    };
+    context->completeFunc = [](void* data) {
+        auto context = static_cast<FusionFenceAsyncContext*>(data);
+        if (context->errCode == ERRCODE_SUCCESS || context->errCode == 3301602) {
+            for (const auto& item : context->removals) { CloseFusionRegistration(item); }
+        }
+        napi_get_undefined(context->env, &context->result[PARAM1]);
+    };
+    return RunFusionFencePromise(env, std::move(context));
+}
