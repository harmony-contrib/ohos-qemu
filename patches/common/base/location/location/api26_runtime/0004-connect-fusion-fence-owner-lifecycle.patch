+napi_value AddFusionFence(napi_env env, napi_callback_info info)
+{
+    size_t argc = 2;
+    napi_value argv[2] = {nullptr};
+    NAPI_CALL(env, napi_get_cb_info(env, info, &argc, argv, nullptr, nullptr));
+    auto context = std::make_unique<FusionFenceAsyncContext>(env);
+    napi_value callback = nullptr;
+    if (argc != 1 || !ReadFusionFenceRequest(env, argv[0], context->request, callback)) {
+        HandleSyncErrCode(env, ERRCODE_INVALID_PARAM);
+        return nullptr;
+    }
+    auto registration = std::make_shared<FusionFenceRegistration>();
+    registration->env = env;
+    registration->identifier = context->request.identifier;
+    registration->client = Locator::GetInstance();
+    napi_ref reference = nullptr;
+    NAPI_CALL(env, napi_create_reference(env, callback, 1, &reference));
+    registration->callback = new (std::nothrow) FusionFenceCallbackNapi(env, reference);
+    if (registration->callback == nullptr) {
+        napi_delete_reference(env, reference);
+        HandleSyncErrCode(env, ERRCODE_SERVICE_UNAVAILABLE);
+        return nullptr;
+    }
+    auto holder = std::make_unique<std::shared_ptr<FusionFenceRegistration>>(registration);
+    if (napi_add_env_cleanup_hook(env, CleanupFusionFence, holder.get()) != napi_ok) {
+        registration->callback->Close();
+        HandleSyncErrCode(env, ERRCODE_SERVICE_UNAVAILABLE);
+        return nullptr;
+    }
+    registration->cleanupData = holder.release();
+    {
+        std::lock_guard<std::mutex> guard(g_fusionFenceMutex);
+        g_fusionFenceRegistrations.push_back(registration);
+    }
+    context->registration = registration;
+    NAPI_CALL(env, napi_create_string_utf8(env, "addFusionFence", NAPI_AUTO_LENGTH, &context->resourceName));
+    context->executeFunc = [](void* data) {
+        auto context = static_cast<FusionFenceAsyncContext*>(data);
+        auto registration = context->registration;
+        context->errCode = registration->client == nullptr ? ERRCODE_SERVICE_UNAVAILABLE :
+            registration->client->AddFusionFenceV9(context->request, registration->callback);
+        if (registration->cancelled.load() && context->errCode == ERRCODE_SUCCESS) {
+            registration->client->ReleaseFusionFenceV9(registration->identifier, registration->callback);
+            context->errCode = ERRCODE_SERVICE_UNAVAILABLE;
+        }
+    };
+    context->completeFunc = [](void* data) {
+        auto context = static_cast<FusionFenceAsyncContext*>(data);
+        if (context->errCode != ERRCODE_SUCCESS) {
+            // A cancellation/completion failure can follow a successful worker.
+            // Callback identity makes this compensating release safe even for
+            // duplicate requests or a later same-identifier registration.
+            auto registration = context->registration;
+            if (registration->client != nullptr) {
+                registration->client->ReleaseFusionFenceV9(registration->identifier, registration->callback);
+            }
+            CloseFusionRegistration(registration);
+        }
+        napi_get_undefined(context->env, &context->result[PARAM1]);
+    };
+    return RunFusionFencePromise(env, std::move(context));
+}
