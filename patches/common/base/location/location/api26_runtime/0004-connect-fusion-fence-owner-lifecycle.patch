+    int32_t lac = 0;
+    int32_t mcc = 0;
+    int32_t mnc = 0;
+    int32_t rat = 0;
+    int32_t pci = 0;
+    bool hasTac = false;
+    int32_t tac = 0;
+};
+struct FusionWifiFeature {
+    int32_t average = 0;
+    double deviation = 0;
+    std::vector<std::string> macs;
+};
+struct FusionWifiFence {
+    int32_t type = 0;
+    std::vector<FusionWifiFeature> features;
+};
+// New IPC payload; no field is appended to any legacy parcelable.
+class FusionFenceRequest : public Parcelable {
+public:
+    static constexpr size_t MAX_ITEMS = 64;
+    static constexpr size_t MAX_TEXT = 1024;
+    static constexpr int64_t NS_PER_MS = 1000000;
+    std::string identifier;
+    std::string poiType;
+    int32_t scene = 0;
+    int32_t fenceType = 0;
+    FusionPoint poi;
+    int32_t events = 0;
+    int32_t loiterMs = 0;
+    double expirationMs = 0;
+    std::vector<FusionGnssFence> gnss;
+    std::vector<std::vector<FusionCell>> cells;
+    std::vector<FusionWifiFence> wifi;
+
+    bool Valid() const
+    {
+        if (identifier.empty() || identifier.size() > MAX_TEXT || poiType.size() > MAX_TEXT ||
+            identifier.find('\0') != std::string::npos || scene < 1 || scene > 4 || !poi.Valid() ||
+            fenceType <= 0 || (fenceType & ~15) != 0 || events <= 0 || (events & ~63) != 0 ||
+            loiterMs < 0 || !std::isfinite(expirationMs) || expirationMs <= 0 ||
+            expirationMs > static_cast<double>(std::numeric_limits<int64_t>::max() / NS_PER_MS) ||
+            gnss.size() > MAX_ITEMS || cells.size() > MAX_ITEMS || wifi.size() > MAX_ITEMS ||
+            ((fenceType & 1) != 0) != !gnss.empty() || ((fenceType & 2) != 0) != !cells.empty() ||
+            ((fenceType & 4) != 0) != !wifi.empty()) {
+            return false;
+        }
+        for (const auto& shape : gnss) {
+            if ((shape.type != 1 && shape.type != 2) || (shape.type == 2 &&
+                (!shape.center.Valid() || !std::isfinite(shape.radius) || shape.radius <= 0 ||
+                !std::isfinite(shape.expirationMs) || shape.expirationMs <= 0)) ||
+                (shape.type == 1 && (shape.polygon.size() < 3 || shape.polygon.size() > MAX_ITEMS)) ||
+                !std::all_of(shape.polygon.begin(), shape.polygon.end(), [](const auto& p) { return p.Valid(); })) {
+                return false;
+            }
+        }
+        for (const auto& group : cells) {
+            if (group.empty() || group.size() > MAX_ITEMS) { return false; }
+            for (const auto& c : group) {
+                if (c.cellId < 0 || c.mcc < 0 || c.mcc > 999 || c.mnc < 0 || c.mnc > 999 || c.rat < 0) {
+                    return false;
+                }
+            }
+        }
+        for (const auto& group : wifi) {
+            if ((group.type != 1 && group.type != 2) || group.features.empty() || group.features.size() > MAX_ITEMS) {
+                return false;
+            }
+            for (const auto& f : group.features) {
+                if (!std::isfinite(f.deviation) || f.deviation < 0 || f.macs.empty() || f.macs.size() > MAX_ITEMS ||
+                    !std::all_of(f.macs.begin(), f.macs.end(), [](const auto& mac) { return ValidMac(mac); })) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    static bool ValidMac(const std::string& mac)
+    {
+        if (mac.size() != 17) { return false; }
+        for (size_t i = 0; i < mac.size(); ++i) {
+            if (i % 3 == 2 ? mac[i] != ':' : !((mac[i] >= '0' && mac[i] <= '9') ||
+                (mac[i] >= 'a' && mac[i] <= 'f') || (mac[i] >= 'A' && mac[i] <= 'F'))) { return false; }
+        }
+        return true;
+    }
