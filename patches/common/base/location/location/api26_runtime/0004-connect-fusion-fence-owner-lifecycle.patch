+            p.ReadDouble(expirationMs) && ReadItems(p, gnss, [&p](auto& s) {
+                return p.ReadInt32(s.type) && ReadPoint(p, s.center) && p.ReadDouble(s.radius) &&
+                    p.ReadDouble(s.expirationMs) && p.ReadInt32(s.coordinateSystem) && ReadItems(p, s.polygon, [&p](auto& pt) { return ReadPoint(p, pt); });
+            }) && ReadItems(p, cells, [&p](auto& group) {
+                return ReadItems(p, group, [&p](auto& c) {
+                    return p.ReadInt64(c.cellId) && p.ReadInt32(c.lac) && p.ReadInt32(c.mcc) &&
+                        p.ReadInt32(c.mnc) && p.ReadInt32(c.rat) && p.ReadInt32(c.pci) &&
+                        p.ReadBool(c.hasTac) && p.ReadInt32(c.tac);
+                });
+            }) && ReadItems(p, wifi, [&p](auto& group) {
+                return p.ReadInt32(group.type) && ReadItems(p, group.features, [&p](auto& f) {
+                    return p.ReadInt32(f.average) && p.ReadDouble(f.deviation) &&
+                        ReadItems(p, f.macs, [&p](auto& mac) { return p.ReadString(mac); });
+                });
+            });
+    }
+};
