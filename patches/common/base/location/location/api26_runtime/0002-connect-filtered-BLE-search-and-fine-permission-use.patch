+LocationErrCode LocatorRequiredDataManager::StartBluetoothSearch(
+    const sptr<IBluetoothScanResultCallback>& callback, const AppIdentity& identity,
+    const std::vector<std::string>& deviceIds, bool hasRssiThreshold, int32_t rssiThreshold)
+{
+#ifdef BLUETOOTH_ENABLE
+    if (callback == nullptr || callback->AsObject() == nullptr) {
+        return ERRCODE_INVALID_PARAM;
+    }
+    if (!HookUtils::ExecuteHookWhenStartScanBluetoothDevice(identity.GetBundleName(), TYPE_BLE)) {
+        return ERRCODE_SCAN_FAIL;
+    }
+    auto object = callback->AsObject();
+    sptr<IRemoteObject::DeathRecipient> death(new (std::nothrow) BluetoothScanCallbackDeathRecipient());
+    if (death == nullptr) {
+        return ERRCODE_SERVICE_UNAVAILABLE;
+    }
+    BluetoothSearchFilter filter;
+    filter.hasRssiThreshold = hasRssiThreshold;
+    filter.rssiThreshold = rssiThreshold;
+    for (const auto& deviceId : deviceIds) {
+        filter.deviceIds.insert(NormalizeBluetoothDeviceId(deviceId));
+    }
+    {
+        std::lock_guard<std::mutex> lock(bluetoothcallbacksMapMutex_);
+        if (bluetoothcallbacksMap_.size() >= MAX_CALLBACKS_MAP_NUM || bluetoothcallbacksMap_.count(object) != 0) {
+            return ERRCODE_SCAN_FAIL;
+        }
+        bluetoothcallbacksMap_.emplace(object, std::make_pair(identity, death));
+        bluetoothSearchFilters_.emplace(object, std::move(filter));
+    }
+    if (!object->AddDeathRecipient(death)) {
+        RemoveBluetoothScanCallback(object);
+        return ERRCODE_SERVICE_UNAVAILABLE;
+    }
+    auto result = StartBluetoothScan();
+    if (result != ERRCODE_SUCCESS) {
+        RemoveBluetoothScanCallbackDeathRecipientByCallback(object);
+        RemoveBluetoothScanCallback(object);
+    }
+    return result;
+#else
+    return ERRCODE_NOT_SUPPORTED;
+#endif
+}
+
+LocationErrCode LocatorRequiredDataManager::StopBluetoothSearch(
+    const sptr<IBluetoothScanResultCallback>& callback, const AppIdentity& identity)
+{
+#ifdef BLUETOOTH_ENABLE
+    if (callback == nullptr || callback->AsObject() == nullptr) {
+        return ERRCODE_INVALID_PARAM;
+    }
+    auto object = callback->AsObject();
+    {
+        std::lock_guard<std::mutex> lock(bluetoothcallbacksMapMutex_);
+        auto entry = bluetoothcallbacksMap_.find(object);
+        if (entry != bluetoothcallbacksMap_.end() &&
+            (entry->second.first.GetTokenId() != identity.GetTokenId() ||
+            entry->second.first.GetUid() != identity.GetUid() || bluetoothSearchFilters_.count(object) == 0)) {
+            return LOCATION_ERRCODE_PERMISSION_DENIED;
+        }
+    }
+    RemoveBluetoothScanCallbackDeathRecipientByCallback(object);
+    RemoveBluetoothScanCallback(object);
+    // Recheck all current users of the shared scanner at execution time. An old
+    // stop request must not stop a scanner acquired by a newer request.
+    return StoptBluetoothScan();
+#else
+    return ERRCODE_NOT_SUPPORTED;
+#endif
+}
