+static bool ReadBluetoothSearchRequest(napi_env env, napi_value request,
+    std::vector<std::string>& deviceIds, bool& hasRssiThreshold, int32_t& rssiThreshold)
+{
+    napi_value array = nullptr;
+    bool isArray = false;
+    if (napi_get_named_property(env, request, "deviceIdArray", &array) != napi_ok ||
+        napi_is_array(env, array, &isArray) != napi_ok || !isArray) {
+        return false;
+    }
+    uint32_t size = 0;
+    if (napi_get_array_length(env, array, &size) != napi_ok) {
+        return false;
+    }
+    for (uint32_t index = 0; index < size; ++index) {
+        napi_value element = nullptr;
+        napi_valuetype type = napi_undefined;
+        size_t length = 0;
+        if (napi_get_element(env, array, index, &element) != napi_ok ||
+            napi_typeof(env, element, &type) != napi_ok || type != napi_string ||
+            napi_get_value_string_utf8(env, element, nullptr, 0, &length) != napi_ok) {
+            return false;
+        }
+        std::vector<char> buffer(length + 1);
+        if (napi_get_value_string_utf8(env, element, buffer.data(), buffer.size(), &length) != napi_ok) {
+            return false;
+        }
+        deviceIds.emplace_back(buffer.data(), length);
+    }
+    bool hasProperty = false;
+    if (napi_has_named_property(env, request, "rssiThreshold", &hasProperty) != napi_ok) {
+        return false;
+    }
+    if (hasProperty) {
+        napi_value value = nullptr;
+        napi_valuetype type = napi_undefined;
+        if (napi_get_named_property(env, request, "rssiThreshold", &value) != napi_ok ||
+            napi_typeof(env, value, &type) != napi_ok) {
+            return false;
+        }
+        if (type != napi_undefined) {
+            double threshold = 0;
+            if (type != napi_number || napi_get_value_double(env, value, &threshold) != napi_ok ||
+                !std::isfinite(threshold) || std::trunc(threshold) != threshold ||
+                threshold < std::numeric_limits<int32_t>::min() || threshold > std::numeric_limits<int32_t>::max()) {
+                return false;
+            }
+            hasRssiThreshold = true;
+            rssiThreshold = static_cast<int32_t>(threshold);
+        }
+    }
+    return true;
+}
