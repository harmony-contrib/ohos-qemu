+    registration->callback->SetEnv(env);
+    registration->callback->SetHandleCb(reference);
+    sptr<IBluetoothScanResultCallback> callback = registration->callback;
+    auto errorCode = registration->client->StartBluetoothSearch(
+        deviceIds, hasRssiThreshold, rssiThreshold, callback);
+    if (errorCode != ERRCODE_SUCCESS) {
+        registration->callback->DeleteHandler();
+        HandleSyncErrCode(env, errorCode);
+        return nullptr;
+    }
+    auto holder = std::make_unique<std::shared_ptr<BluetoothSearchRegistration>>(registration);
+    if (napi_add_env_cleanup_hook(env, CleanupBluetoothSearch, holder.get()) != napi_ok) {
+        registration->callback->DeleteHandler();
+        registration->client->StopBluetoothSearch(callback);
+        HandleSyncErrCode(env, ERRCODE_SERVICE_UNAVAILABLE);
+        return nullptr;
+    }
+    registration->cleanupData = holder.release();
+    {
+        std::lock_guard<std::mutex> lock(g_bluetoothSearchMutex);
+        g_bluetoothSearches.push_back(registration);
+    }
+    return UndefinedNapiValue(env);
+}
+
+napi_value StopBluetoothSearch(napi_env env, napi_callback_info info)
+{
+    size_t argc = 2;
+    napi_value argv[2] = {nullptr};
+    NAPI_CALL(env, napi_get_cb_info(env, info, &argc, argv, nullptr, nullptr));
+    napi_valuetype callbackType = napi_undefined;
+    if (argc > 1 || (argc == 1 && (napi_typeof(env, argv[0], &callbackType) != napi_ok ||
+        (callbackType != napi_function && callbackType != napi_undefined)))) {
+        HandleSyncErrCode(env, ERRCODE_INVALID_PARAM);
+        return nullptr;
+    }
+    bool allCallbacks = argc == 0 || callbackType == napi_undefined;
+    std::lock_guard<std::mutex> lock(g_bluetoothSearchMutex);
+    for (auto iter = g_bluetoothSearches.begin(); iter != g_bluetoothSearches.end();) {
+        auto registration = *iter;
+        if (!registration->active.load()) {
+            iter = g_bluetoothSearches.erase(iter);
+            continue;
+        }
+        if (registration->env != env || (!allCallbacks && !IsBluetoothSearchCallback(env, argv[0], registration))) {
+            ++iter;
+            continue;
+        }
+        sptr<IBluetoothScanResultCallback> callback = registration->callback;
+        auto errorCode = registration->client->StopBluetoothSearch(callback);
+        if (errorCode != ERRCODE_SUCCESS) {
+            HandleSyncErrCode(env, errorCode);
+            return nullptr;
+        }
+        registration->active.store(false);
+        registration->callback->DeleteHandler();
+        auto cleanupData = registration->cleanupData;
+        if (napi_remove_env_cleanup_hook(env, CleanupBluetoothSearch, cleanupData) == napi_ok) {
+            registration->cleanupData = nullptr;
+            delete cleanupData;
+        }
+        iter = g_bluetoothSearches.erase(iter);
+    }
+    return UndefinedNapiValue(env);
+}

