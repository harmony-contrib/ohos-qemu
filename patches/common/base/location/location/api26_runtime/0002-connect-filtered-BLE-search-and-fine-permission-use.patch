+static bool IsBluetoothSearchCallback(napi_env env, napi_value callback,
+    const std::shared_ptr<BluetoothSearchRegistration>& registration)
+{
+    if (!registration->active.load() || registration->env != env) {
+        return false;
+    }
+    napi_value saved = nullptr;
+    bool equal = false;
+    auto reference = registration->callback->GetHandleCb();
+    return reference != nullptr && napi_get_reference_value(env, reference, &saved) == napi_ok &&
+        napi_strict_equals(env, saved, callback, &equal) == napi_ok && equal;
