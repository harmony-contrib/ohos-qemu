+static std::string NormalizeBluetoothDeviceId(std::string deviceId)
+{
+    std::transform(deviceId.begin(), deviceId.end(), deviceId.begin(),
+        [](unsigned char value) { return static_cast<char>(std::tolower(value)); });
+    return deviceId;
+}
