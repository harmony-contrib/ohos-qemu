+        context->errCode = context->client == nullptr ? ERRCODE_SERVICE_UNAVAILABLE :
+            context->client->GetPostProcessingTrackV9(context->sportsType, context->track);
+    };
+    context->completeFunc = [](void* data) {
+        auto context = static_cast<TrackAsyncContext*>(data);
+        if (context->errCode != ERRCODE_SUCCESS) {
+            return;
+        }
+        NAPI_CALL_RETURN_VOID(context->env,
+            napi_create_array_with_length(context->env, context->track.size(), &context->result[PARAM1]));
+        for (size_t index = 0; index < context->track.size(); ++index) {
+            napi_value value = nullptr;
+            NAPI_CALL_RETURN_VOID(context->env, napi_create_object(context->env, &value));
+            auto location = std::make_unique<Location>(context->track[index]);
+            LocationToJs(context->env, location, value);
+            NAPI_CALL_RETURN_VOID(context->env,
+                napi_set_element(context->env, context->result[PARAM1], index, value));
+        }
+    };
+    return DoAsyncWork(env, context.release(), 0, argv, 0);
+}
