+LocationErrCode LocatorImpl::GetCurrentDistrictV9(const std::string& locale, int32_t timeoutMs,
+    std::shared_ptr<GeoAddress>& address)
+{
+    address.reset();
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(std::max(0, timeoutMs));
+    if (!SaLoadWithStatistic::InitLocationSa(LOCATION_LOCATOR_SA_ID)) {
+        return ERRCODE_SERVICE_UNAVAILABLE;
+    }
+    auto proxy = GetProxy();
+    if (proxy == nullptr) {
+        return ERRCODE_SERVICE_UNAVAILABLE;
+    }
+    sptr<DistrictLocationHost> host = new (std::nothrow) DistrictLocationHost();
+    if (host == nullptr) {
+        return ERRCODE_SERVICE_UNAVAILABLE;
+    }
+    RequestConfig request;
+    request.SetFixNumber(1);
+    request.SetTimeOut(std::max(0, timeoutMs));
+    request.SetPriority(PRIORITY_FAST_FIRST_FIX);
+    // Service authorizes location permission/current user/switch before any
+    // cache is exposed. This start uses the caller's real one-shot request.
+    auto error = LocationRuntimeErrCode(proxy->StartDistrictLocating(request, host));
+    if (error != ERRCODE_SUCCESS) {
+        return error;
+    }
+    // StartLocatingProcess already offers only the caller-permitted recent
+    // cache (25s), otherwise a live fix, through this same owned callback.
+    std::unique_ptr<Location> location;
+    error = host->Wait(deadline, location);
+    auto stopError = LocationRuntimeErrCode(proxy->StopLocating(host));
+    if (error != ERRCODE_SUCCESS) {
+        return error;
+    }
+    if (stopError != ERRCODE_SUCCESS) {
+        return stopError;
+    }
+    if (!IsFreshDistrictLocation(location)) {
+        return ERRCODE_SERVICE_UNAVAILABLE;
+    }
+    if (std::chrono::steady_clock::now() >= deadline) {
+        return ERRCODE_COUNTRYCODE_FAIL;
+    }
+    bool available = false;
+    error = IsGeoServiceAvailableV9(available);
+    if (error != ERRCODE_SUCCESS) {
+        return error;
+    }
+    if (!available) {
+        return ERRCODE_NOT_SUPPORTED;
+    }
+    sptr<DistrictAddressHost> geocoder = new (std::nothrow) DistrictAddressHost();
+    if (geocoder == nullptr) {
+        return ERRCODE_SERVICE_UNAVAILABLE;
+    }
+    GeocodeConvertLocationRequest query;
+    // Use the same system locale key watched by the country-code service. An explicit
+    // locale stays part of the existing reverse-geocoder cache/request key.
+    query.SetLocale(locale.empty() ? system::GetParameter(LOCALE_KEY, "") : locale);
+    query.SetLatitude(location->GetLatitude());
+    query.SetLongitude(location->GetLongitude());
+    query.SetMaxItems(1);
+    query.SetTransId(CommonUtils::GenerateUuid());
+    error = LocationRuntimeErrCode(proxy->GetAddressByCoordinate(geocoder->AsObject(), query));
+    if (error != ERRCODE_SUCCESS) {
+        return error == ERRCODE_SERVICE_UNAVAILABLE ? error : ERRCODE_COUNTRYCODE_FAIL;
+    }
+    address = geocoder->Wait(deadline);
+    if (address == nullptr || (address->countryCode_.empty() && address->countryName_.empty() &&
+        address->administrativeArea_.empty() && address->subAdministrativeArea_.empty() &&
+        address->locality_.empty() && address->subLocality_.empty())) {
+        address.reset();
+        return ERRCODE_COUNTRYCODE_FAIL;
+    }
+    error = LocationRuntimeErrCode(proxy->CheckDistrictAccess());
+    if (error != ERRCODE_SUCCESS || std::chrono::steady_clock::now() >= deadline) {
+        address.reset();
+        return error == ERRCODE_SUCCESS ? ERRCODE_COUNTRYCODE_FAIL : error;
+    }
+    return ERRCODE_SUCCESS;
+}
