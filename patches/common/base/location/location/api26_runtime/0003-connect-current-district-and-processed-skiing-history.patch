+namespace {
+using DistrictDeadline = std::chrono::steady_clock::time_point;
+
+class DistrictLocationHost final : public LocatorCallbackHost {
+public:
+    void OnLocationReport(const std::unique_ptr<Location>& location) override
+    {
+        if (location == nullptr) {
+            return;
+        }
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!done_) {
+            location_ = std::make_unique<Location>(*location);
+            done_ = true;
+            condition_.notify_all();
+        }
+    }
+    void OnErrorReport(const int errorCode) override
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!done_) {
+            error_ = errorCode == LOCATING_FAILED_LOCATION_SWITCH_OFF ? ERRCODE_SWITCH_OFF :
+                errorCode == LOCATING_FAILED_LOCATION_PERMISSION_DENIED ? ERRCODE_PERMISSION_DENIED :
+                ERRCODE_SERVICE_UNAVAILABLE;
+            done_ = true;
+            condition_.notify_all();
+        }
+    }
+    LocationErrCode Wait(DistrictDeadline deadline, std::unique_ptr<Location>& location)
+    {
+        std::unique_lock<std::mutex> lock(mutex_);
+        if (!condition_.wait_until(lock, deadline, [this] { return done_; })) {
+            return ERRCODE_SERVICE_UNAVAILABLE;
+        }
+        location = std::move(location_);
+        return error_;
+    }
+private:
+    std::mutex mutex_;
+    std::condition_variable condition_;
+    bool done_ = false;
+    LocationErrCode error_ = ERRCODE_SUCCESS;
+    std::unique_ptr<Location> location_;
+};
+
+class DistrictAddressHost final : public GeoConvertCallbackHost {
+public:
+    void OnResults(std::list<std::shared_ptr<GeoAddress>>& results) override
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!done_) {
+            for (const auto& result : results) {
+                if (result != nullptr) {
+                    address_ = std::make_shared<GeoAddress>(*result);
+                    break;
+                }
+            }
+            done_ = true;
+            condition_.notify_all();
+        }
+    }
+    void OnErrorReport(const int errorCode) override
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        done_ = true;
+        condition_.notify_all();
+    }
+    std::shared_ptr<GeoAddress> Wait(DistrictDeadline deadline)
+    {
+        std::unique_lock<std::mutex> lock(mutex_);
+        condition_.wait_until(lock, deadline, [this] { return done_; });
+        return address_;
+    }
+private:
+    std::mutex mutex_;
+    std::condition_variable condition_;
+    bool done_ = false;
+    std::shared_ptr<GeoAddress> address_;
+};
