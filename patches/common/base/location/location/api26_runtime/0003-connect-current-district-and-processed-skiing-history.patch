+namespace {
+constexpr int64_t TRACK_RETENTION_NS = 24LL * 60 * 60 * 1000000000LL;
+constexpr double TRACK_PI = 3.14159265358979323846;
+constexpr double TRACK_EARTH_RADIUS_M = 6371008.8;
+
+double TrackDistance(double lat1, double lon1, double lat2, double lon2)
+{
+    const auto radians = TRACK_PI / 180.0;
+    const auto dlat = (lat2 - lat1) * radians;
+    const auto dlon = std::remainder(lon2 - lon1, 360.0) * radians;
+    const auto a = std::pow(std::sin(dlat / 2), 2) + std::cos(lat1 * radians) *
+        std::cos(lat2 * radians) * std::pow(std::sin(dlon / 2), 2);
+    return 2 * TRACK_EARTH_RADIUS_M * std::asin(std::sqrt(std::clamp(a, 0.0, 1.0)));
+}
+} // namespace
+
+void ReportManager::RecordSkiingTrack(const std::shared_ptr<Request>& request,
+    const std::unique_ptr<Location>& location)
+{
+    if (location == nullptr || !RequestManager::GetInstance()->IsSkiingRequestActive(request) ||
+        location->GetIsFromMock() ||
+        (location->GetLocationSourceType() != GNSS_TYPE && location->GetLocationSourceType() != RTK_TYPE) ||
+        !PermissionManager::CheckLocationPermission(request->GetTokenId(), request->GetFirstTokenId())) {
+        return;
+    }
+    auto now = CommonUtils::GetSinceBootTime();
+    auto timestamp = location->GetTimeSinceBoot();
+    if (timestamp <= 0 || timestamp > now || now - timestamp > TRACK_RETENTION_NS ||
+        !std::isfinite(location->GetLatitude()) || !std::isfinite(location->GetLongitude()) ||
+        !std::isfinite(location->GetAltitude()) || !std::isfinite(location->GetAccuracy()) ||
+        std::fabs(location->GetLatitude()) > 90 || std::fabs(location->GetLongitude()) > 180 ||
+        location->GetAccuracy() < 0) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(trackMutex_);
+    PruneSkiingTracks(now);
+    auto& history = skiingTracks_[{request->GetUid(), request->GetTokenId(), request->GetFirstTokenId()}];
+    if (history.last != nullptr && timestamp <= history.last->GetTimeSinceBoot()) {
+        return; // Same GNSS fix delivered to multiple requests, or out-of-order input.
+    }
+    auto processed = std::make_shared<Location>(*location);
+    const auto measurementVariance = std::max(1.0, std::pow(location->GetAccuracy(), 2));
+    if (history.last != nullptr) {
+        auto dt = (timestamp - history.last->GetTimeSinceBoot()) / 1e9;
+        const auto distance = TrackDistance(history.last->GetLatitude(), history.last->GetLongitude(),
+            location->GetLatitude(), location->GetLongitude());
+        // Reject isolated GNSS teleports, accounting for stated uncertainty.
+        if (distance > std::max(120.0 * dt, 3 * (location->GetAccuracy() + history.last->GetAccuracy()))) {
+            return;
+        }
+        if (dt <= 60) {
+            auto priorVariance = history.variance + 36 * dt * dt;
+            auto gain = std::clamp(priorVariance / (priorVariance + measurementVariance), 0.2, 0.95);
+            processed->SetLatitude(history.last->GetLatitude() + gain *
+                (location->GetLatitude() - history.last->GetLatitude()));
+            processed->SetLongitude(std::remainder(history.last->GetLongitude() + gain *
+                std::remainder(location->GetLongitude() - history.last->GetLongitude(), 360.0), 360.0));
+            processed->SetAltitude(history.last->GetAltitude() + gain *
+                (location->GetAltitude() - history.last->GetAltitude()));
+            processed->SetAccuracy(std::sqrt((1 - gain) * priorVariance));
+            processed->SetSpeed(TrackDistance(history.last->GetLatitude(), history.last->GetLongitude(),
+                processed->GetLatitude(), processed->GetLongitude()) / dt);
+            const auto radians = TRACK_PI / 180.0;
+            const auto dlon = std::remainder(processed->GetLongitude() - history.last->GetLongitude(), 360.0) * radians;
+            const auto y = std::sin(dlon) * std::cos(processed->GetLatitude() * radians);
+            const auto x = std::cos(history.last->GetLatitude() * radians) * std::sin(processed->GetLatitude() * radians) -
+                std::sin(history.last->GetLatitude() * radians) * std::cos(processed->GetLatitude() * radians) * std::cos(dlon);
+            processed->SetDirection(std::fmod(std::atan2(y, x) / radians + 360.0, 360.0));
+            history.variance = (1 - gain) * priorVariance;
+        } else {
+            history.variance = measurementVariance;
+        }
+    } else {
+        history.variance = measurementVariance;
+    }
+    history.last = processed;
+    history.unread.emplace_back(++history.sequence, processed);
+}
+
+void ReportManager::PruneSkiingTracks(int64_t now)
+{
+    for (auto iter = skiingTracks_.begin(); iter != skiingTracks_.end();) {
+        auto& history = iter->second;
+        while (!history.unread.empty() && now - history.unread.front().second->GetTimeSinceBoot() > TRACK_RETENTION_NS) {
+            history.unread.pop_front();
+        }
+        if (history.last == nullptr || now - history.last->GetTimeSinceBoot() > TRACK_RETENTION_NS) {
+            iter = skiingTracks_.erase(iter);
+        } else {
+            ++iter;
+        }
+    }
+}
+
+LocationErrCode ReportManager::GetPostProcessingTrack(const AppIdentity& identity, std::vector<Location>& track)
+{
+    track.clear();
+    std::lock_guard<std::mutex> lock(trackMutex_);
+    PruneSkiingTracks(CommonUtils::GetSinceBootTime());
+    auto iter = skiingTracks_.find({identity.GetUid(), identity.GetTokenId(), identity.GetFirstTokenId()});
+    if (iter == skiingTracks_.end()) {
+        return ERRCODE_SERVICE_UNAVAILABLE;
+    }
+    auto& history = iter->second;
+    for (const auto& record : history.unread) {
+        if (record.first > history.cursor) {
+            track.push_back(*record.second);
+        }
+    }
+    history.cursor = history.sequence;
+    history.unread.clear(); // Already-consumed records never replay and do not occupy the 24h queue.
+    return ERRCODE_SUCCESS;
 }

