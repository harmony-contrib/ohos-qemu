+bool IsFreshDistrictLocation(const std::unique_ptr<Location>& location)
+{
+    if (location == nullptr || !std::isfinite(location->GetLatitude()) ||
+        !std::isfinite(location->GetLongitude()) || std::fabs(location->GetLatitude()) > 90 ||
+        std::fabs(location->GetLongitude()) > 180) {
+        return false;
+    }
+    constexpr int64_t MAX_AGE_NS = 30LL * 1000000000LL;
+    auto age = CommonUtils::GetSinceBootTime() - location->GetTimeSinceBoot();
+    return location->GetTimeSinceBoot() > 0 && age >= 0 && age <= MAX_AGE_NS;
+}
