+napi_value GetCurrentDistrict(napi_env env, napi_callback_info info)
+{
+    size_t argc = 2;
+    napi_value argv[2] = {nullptr};
+    NAPI_CALL(env, napi_get_cb_info(env, info, &argc, argv, nullptr, nullptr));
+    auto context = std::make_unique<DistrictAsyncContext>(env);
+    if (argc > 1 || (argc == 1 && !ReadOptionalDistrictRequest(env, argv[0], *context))) {
+        HandleSyncErrCode(env, ERRCODE_INVALID_PARAM);
+        return nullptr;
+    }
+    context->client = Locator::GetInstance();
+    NAPI_CALL(env, napi_create_string_utf8(env, "getCurrentDistrict", NAPI_AUTO_LENGTH, &context->resourceName));
+    context->executeFunc = [](void* data) {
+        auto context = static_cast<DistrictAsyncContext*>(data);
+        context->errCode = context->client == nullptr ? ERRCODE_SERVICE_UNAVAILABLE :
+            context->client->GetCurrentDistrictV9(context->locale, context->timeoutMs, context->address);
+    };
+    context->completeFunc = [](void* data) {
+        auto context = static_cast<DistrictAsyncContext*>(data);
+        if (context->errCode != ERRCODE_SUCCESS || context->address == nullptr) {
+            return;
+        }
+        NAPI_CALL_RETURN_VOID(context->env, napi_create_object(context->env, &context->result[PARAM1]));
+        const auto& address = context->address;
+        for (const auto& field : std::vector<std::pair<const char*, std::string>> {
+            {"locale", address->locale_}, {"countryCode", address->countryCode_}, {"countryName", address->countryName_},
+            {"administrativeArea", address->administrativeArea_}, {"subAdministrativeArea", address->subAdministrativeArea_},
+            {"locality", address->locality_}, {"subLocality", address->subLocality_}}) {
+            if (!field.second.empty()) {
+                SetValueUtf8String(context->env, field.first, field.second.c_str(), context->result[PARAM1]);
+            }
+        }
+    };
+    // Promise-only API: its optional request is never treated as a JS callback.
+    return DoAsyncWork(env, context.release(), 0, argv, 0);
+}
