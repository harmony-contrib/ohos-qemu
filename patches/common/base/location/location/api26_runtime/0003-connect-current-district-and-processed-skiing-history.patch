+ErrCode LocatorAbility::StartLocatingWithSportsType(const RequestConfig& requestConfig, int32_t sportsType,
+    const sptr<ILocatorCallback>& cb)
+{
+    if (sportsType < RUNNING || sportsType > SKIING) {
+        return ERRCODE_INVALID_PARAM;
+    }
+    RequestConfig continuous;
+    continuous.Set(const_cast<RequestConfig&>(requestConfig));
+    // SDK sportsType is effective only for UserActivityScenario.SPORT.
+    continuous.SetSportsType(requestConfig.GetScenario() == LOCATION_SCENE_SPORT ? sportsType : 0);
+    if (continuous.GetSportsType() == SKIING) {
+#ifndef FEATURE_GNSS_SUPPORT
+        return ERRCODE_NOT_SUPPORTED;
+#else
+        AppIdentity identity;
+        GetAppIdentityInfo(identity);
+        if (!PermissionManager::CheckLocationPermission(identity.GetTokenId(), identity.GetFirstTokenId())) {
+            return LOCATION_ERRCODE_PERMISSION_DENIED;
+        }
+        continuous.SetLocationSourceType(GNSS_TYPE);
+        continuous.SetFixNumber(0);
+#endif
+    }
+    return StartLocating(continuous, cb);
+}
