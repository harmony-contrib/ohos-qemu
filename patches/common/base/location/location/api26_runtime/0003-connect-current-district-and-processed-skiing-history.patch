+static bool ReadOptionalDistrictRequest(napi_env env, napi_value request, DistrictAsyncContext& context)
+{
+    napi_valuetype type = napi_undefined;
+    if (napi_typeof(env, request, &type) != napi_ok) {
+        return false;
+    }
+    if (type == napi_undefined) {
+        return true;
+    }
+    if (type != napi_object) {
+        return false;
+    }
+    for (const auto* name : {"locale", "timeoutMs"}) {
+        bool present = false;
+        napi_value value = nullptr;
+        if (napi_has_named_property(env, request, name, &present) != napi_ok) {
+            return false;
+        }
+        if (!present) {
+            continue;
+        }
+        if (napi_get_named_property(env, request, name, &value) != napi_ok ||
+            napi_typeof(env, value, &type) != napi_ok) {
+            return false;
+        }
+        if (type == napi_undefined) {
+            continue;
+        }
+        if (std::string(name) == "locale") {
+            size_t length = 0;
+            if (type != napi_string || napi_get_value_string_utf8(env, value, nullptr, 0, &length) != napi_ok ||
+                length > MAX_BUF_LEN) {
+                return false;
+            }
+            std::vector<char> buffer(length + 1);
+            if (napi_get_value_string_utf8(env, value, buffer.data(), buffer.size(), &length) != napi_ok) {
+                return false;
+            }
+            context.locale.assign(buffer.data(), length);
+        } else {
+            double timeout = 0;
+            if (type != napi_number || napi_get_value_double(env, value, &timeout) != napi_ok ||
+                !std::isfinite(timeout) || std::trunc(timeout) != timeout ||
+                timeout < std::numeric_limits<int32_t>::min() || timeout > std::numeric_limits<int32_t>::max()) {
+                return false;
+            }
+            context.timeoutMs = static_cast<int32_t>(timeout);
+        }
+    }
+    return true;
+}
