+ErrCode LocatorAbility::CheckDistrictAccess()
+{
+    AppIdentity identity;
+    GetAppIdentityInfo(identity);
+    if (!CheckRequestAvailable(LocatorInterfaceCode::START_DISTRICT_LOCATING, identity) ||
+        (!PermissionManager::CheckApproximatelyPermission(identity.GetTokenId(), identity.GetFirstTokenId()) &&
+        !PermissionManager::CheckLocationPermission(identity.GetTokenId(), identity.GetFirstTokenId()))) {
+        return LOCATION_ERRCODE_PERMISSION_DENIED;
