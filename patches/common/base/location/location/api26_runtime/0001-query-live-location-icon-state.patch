+bool RequestManager::IsLocatingInCurrentAccount()
+{
+    // Keep the same request -> permission lock order as request deletion.
+    std::unique_lock<ffrt::mutex> requestsLock(requestMutex_);
+    std::unique_lock<ffrt::mutex> permissionLock(permissionRecordMutex_);
+    auto locator = LocatorAbility::GetInstance();
+    auto requests = locator->GetRequests();
+    if (requests == nullptr) {
+        return false;
+    }
+    for (const auto& entry : *requests) {
+        if (entry.first != GNSS_ABILITY && entry.first != NETWORK_ABILITY && entry.first != FUSED_ABILITY) {
+            continue;
+        }
+        for (auto request : entry.second) {
+            if (request == nullptr || request->GetRequestConfig() == nullptr ||
+                !request->GetApproximatelyPermState() || !IsRequestAvailable(request)) {
+                continue;
+            }
+            AppIdentity identity;
+            identity.SetUid(request->GetUid());
+            identity.SetTokenId(request->GetTokenId());
+            if (!CommonUtils::IsAppBelongCurrentAccount(identity)) {
+                continue;
+            }
+            auto tokenId = request->GetTokenId();
+            auto firstTokenId = request->GetFirstTokenId();
+            if (!PermissionManager::CheckLocationPermission(tokenId, firstTokenId) &&
+                !PermissionManager::CheckApproximatelyPermission(tokenId, firstTokenId)) {
+                continue;
+            }
+            auto userId = CommonUtils::GetUserIdByUid(request->GetUid());
+            if (LocationDataRdbManager::QuerySwitchStateForUser(userId) == ENABLED ||
+                locator->GetLocationSwitchIgnoredFlag(tokenId)) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
