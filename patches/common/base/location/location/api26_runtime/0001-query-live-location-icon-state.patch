+ErrCode LocatorAbility::GetLocationIconStatus(int32_t& status)
+{
+    AppIdentity identity;
+    GetAppIdentityInfo(identity);
+    if (!PermissionManager::CheckSystemPermission(identity.GetTokenId(), identity.GetTokenIdEx())) {
+        return LOCATION_ERRCODE_SYSTEM_PERMISSION_DENIED;
+    }
+    if (!CheckRequestAvailable(LocatorInterfaceCode::GET_LOCATION_ICON_STATUS, identity)) {
+        return ERRCODE_SERVICE_UNAVAILABLE;
+    }
+    // This source has normal GNSS/network providers, with no HD provider state.
+    // Never infer HD from an accuracy number or a requested priority.
+    status = RequestManager::GetInstance()->IsLocatingInCurrentAccount() ? 1 : 0;
+    return ERRCODE_SUCCESS;
 }

