+// Cleanup hooks and listener removal serialize with service-thread queueing. No
+// N-API reference from an inactive registration may be used by queued work.
+static void CleanupRttCallback(void* data)
+{
+    std::unique_ptr<std::shared_ptr<RttCallbackRegistration>> holder(
+        static_cast<std::shared_ptr<RttCallbackRegistration>*>(data));
+    auto registration = *holder;
+    std::lock_guard<std::mutex> lock(registration->callbackMutex);
+    registration->active.store(false);
+    registration->cleanupData = nullptr;
+}
+
+static void DeleteRttCallbackReferences(EventCallback& callback)
+{
+    if (callback.callbackRef != nullptr) {
+        napi_delete_reference(callback.env, callback.callbackRef);
+    }
+    if (callback.thisVar != nullptr) {
+        napi_delete_reference(callback.env, callback.thisVar);
+    }
+    callback = {};
+}
+
+static void RegisterRttCallback(std::vector<std::shared_ptr<RttCallbackRegistration>>& callbacks,
+    EventCallback eventCallback, std::mutex& callbackMutex)
+{
+    std::lock_guard<std::mutex> lock(callbackMutex);
+    for (auto iter = callbacks.begin(); iter != callbacks.end();) {
+        if (!(*iter)->active.load()) {
+            iter = callbacks.erase(iter);
+            continue;
+        }
+        const auto& current = (*iter)->callback;
+        if (current.env == eventCallback.env) {
+            napi_value currentCallback = nullptr;
+            napi_value newCallback = nullptr;
+            bool equal = false;
+            napi_get_reference_value(current.env, current.callbackRef, &currentCallback);
+            napi_get_reference_value(eventCallback.env, eventCallback.callbackRef, &newCallback);
+            napi_strict_equals(current.env, currentCallback, newCallback, &equal);
+            if (equal) {
+                DeleteRttCallbackReferences(eventCallback);
+                return;
+            }
+        }
+        ++iter;
+    }
+    auto registration = std::make_shared<RttCallbackRegistration>();
+    registration->callback = eventCallback;
+    auto holder = std::make_unique<std::shared_ptr<RttCallbackRegistration>>(registration);
+    if (napi_add_env_cleanup_hook(eventCallback.env, CleanupRttCallback, holder.get()) != napi_ok) {
+        DeleteRttCallbackReferences(eventCallback);
+        napi_throw_error(registration->callback.env, nullptr, "Failed to register RTT environment cleanup");
+        return;
+    }
+    registration->cleanupData = holder.release();
+    callbacks.push_back(registration);
+}
+
+static void UnregisterRttCallback(std::vector<std::shared_ptr<RttCallbackRegistration>>& callbacks,
+    napi_env env, napi_value callback, std::mutex& callbackMutex)
+{
+    std::lock_guard<std::mutex> lock(callbackMutex);
+    for (auto iter = callbacks.begin(); iter != callbacks.end();) {
+        auto registration = *iter;
+        std::lock_guard<std::mutex> registrationLock(registration->callbackMutex);
+        if (!registration->active.load()) {
+            iter = callbacks.erase(iter);
+            continue;
+        }
+        auto& current = registration->callback;
+        bool equal = callback == nullptr;
+        if (current.env == env && callback != nullptr) {
+            napi_value currentCallback = nullptr;
+            napi_get_reference_value(env, current.callbackRef, &currentCallback);
+            napi_strict_equals(env, currentCallback, callback, &equal);
+        }
+        if (current.env != env || !equal) {
+            ++iter;
+            continue;
+        }
+        registration->active.store(false);
+        auto cleanupData = registration->cleanupData;
+        if (napi_remove_env_cleanup_hook(env, CleanupRttCallback, cleanupData) == napi_ok) {
+            registration->cleanupData = nullptr;
+            delete cleanupData;
+        }
+        DeleteRttCallbackReferences(current);
+        iter = callbacks.erase(iter);
+    }
+}
+
