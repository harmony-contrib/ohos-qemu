    "$NUMBER_IDENTITY_ROOT/utils/log/include",
    "$NUMBER_IDENTITY_ROOT/frameworks/extension/core/include",
    "$NUMBER_IDENTITY_ROOT/frameworks/extension/napi_helper/include",
  ]

  defines = [
    "NUMBER_IDENTITY_LOG_TAG = \"NumberIdentity\"",
    "LOG_DOMAIN = 0xD001F1A",
  ]

  if (build_variant != "user") {
    defines += [ "NUMBER_IDENTITY_DEBUG" ]
  }

  external_deps = [
