import("//build/ohos.gni")
import("signature/pm.gni")

NUMBER_IDENTITY_ROOT = "./"

ohos_app("NumberIdentity") {
  deps = [
    ":Number_location_Ability_js_assets",
    ":Number_Location_Ability_resources",
  ]

  publicity_file = "publicity.xml"
  certificate_profile = "./signature/NumberIdentity.hapRelease.p7b"
  hap_name = "NumberIdentity"
  part_name = "number_identity"
  subsystem_name = "telephony"
  module_install_dir = "app/com.ohos.numberidentityability"
#  hvigor_home = "//commandline-tools/command-line-tools/hvigor"
#  sdk_home = "//commandline-tools/command-line-tools/sdk"
#  sdk_type_name = [ "hwsdk.dir" ]
  system_lib_deps = [
    "//base/telephony/number_identity:number_identity"
  ]
  assemble_type = "assembleHap"
  js_build_mode = "release"
  build_level = "module"
  build_modules = [ "numberidentity" ]
  if (defined(sign_hap_py_path)) {
    certificate_profile = "${certificate_profile_path}"
    key_alias = "NumberIdentity"
    private_key_path = "NumberIdentity"
    compatible_version = "11"
  }
}

ohos_app_scope("Number_Location_Ability_app_profile") {
  app_profile = "AppScope/app.json"
  sources = [ "AppScope/resources" ]
}

ohos_js_assets("Number_location_Ability_js_assets") {
  ets2abc = true
  source_dir = "entry/src/main/ets"
}

ohos_resources("Number_Location_Ability_resources") {
  sources = [ "entry/src/main/resources" ]
  deps = [ ":Number_Location_Ability_app_profile" ]
  hap_profile = "entry/src/main/module.json"
}

ohos_shared_library("number_identity") {
  install_enable = true
  sources = [
    "$NUMBER_IDENTITY_ROOT/shared/src/number_identity_database.cpp",
    "$NUMBER_IDENTITY_ROOT/shared/src/number_identity_datashare_transform.cpp",
    "$NUMBER_IDENTITY_ROOT/shared/src/number_identity_hsdr_helper.cpp",
    "$NUMBER_IDENTITY_ROOT/shared/src/number_identity_json_helper.cpp",
    "$NUMBER_IDENTITY_ROOT/shared/src/number_identity_pinyin_helper.cpp",
    "$NUMBER_IDENTITY_ROOT/shared/src/number_identity_models.cpp",
    "$NUMBER_IDENTITY_ROOT/shared/src/number_identity_service_extension_client.cpp",
    "$NUMBER_IDENTITY_ROOT/shared/src/number_identity_settings.cpp",
    "$NUMBER_IDENTITY_ROOT/shared/src/number_identity_utils.cpp",
    "$NUMBER_IDENTITY_ROOT/number_location/src/fix_phone_number.cpp",
    "$NUMBER_IDENTITY_ROOT/number_location/src/mobile_phone_number.cpp",
    "$NUMBER_IDENTITY_ROOT/number_location/src/number_location_ability.cpp",
    "$NUMBER_IDENTITY_ROOT/number_location/src/number_location_db_parse.cpp",
    "$NUMBER_IDENTITY_ROOT/number_location/src/number_location_parser.cpp",
    "$NUMBER_IDENTITY_ROOT/number_location/src/number_location_result_set_bridge.cpp",
    "$NUMBER_IDENTITY_ROOT/number_location/src/number_identity_datashare_stub_impl.cpp",
    "$NUMBER_IDENTITY_ROOT/number_location/src/number_location_manager.cpp",
    "$NUMBER_IDENTITY_ROOT/number_location/src/number_location_utils.cpp",
    "$NUMBER_IDENTITY_ROOT/number_mark/src/number_mark_ability.cpp",
    "$NUMBER_IDENTITY_ROOT/number_mark/src/number_mark_caller_info.cpp",
    "$NUMBER_IDENTITY_ROOT/number_mark/src/number_mark_manager.cpp",
    "$NUMBER_IDENTITY_ROOT/number_mark/src/number_mark_result_set_bridge.cpp",
    "$NUMBER_IDENTITY_ROOT/yellow_page/src/yellow_page_parser.cpp",
    "$NUMBER_IDENTITY_ROOT/number_location/src/download_file.cpp",
    "$NUMBER_IDENTITY_ROOT/number_location/src/download_file_ability.cpp",
    "$NUMBER_IDENTITY_ROOT/number_location/src/download_file_result_set_bridge.cpp",
    "$NUMBER_IDENTITY_ROOT/number_location/src/download_file_rdb.cpp",
    "$NUMBER_IDENTITY_ROOT/number_location/src/parse_number_identity_config.cpp",
  ]

  include_dirs = [
    "$NUMBER_IDENTITY_ROOT/shared/include",
    "$NUMBER_IDENTITY_ROOT/number_location/include",
    "$NUMBER_IDENTITY_ROOT/yellow_page/include",
    "$NUMBER_IDENTITY_ROOT/number_mark/include",
