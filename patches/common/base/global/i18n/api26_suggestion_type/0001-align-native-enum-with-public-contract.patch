+// The public dynamic SDK numbers differ from the internal native enum.
+// Keep the native ABI and sorting semantics unchanged; translate at this boundary.
+static bool ToPublicSuggestionType(SuggestionType type, int32_t &value)
+{
+    switch (type) {
+        case SUGGESTION_TYPE_NONE:
+            value = 0;
+            return true;
+        case SUGGESTION_TYPE_RELATED:
+            value = 1;
+            return true;
+        case SUGGESTION_TYPE_SIM:
+            value = 2;
+            return true;
+        default:
+            return false;
+    }
+}
+
+static napi_status RegisterSuggestionType(napi_env env, napi_value exports)
+{
+    const SuggestionType nativeTypes[] = {
+        SUGGESTION_TYPE_NONE, SUGGESTION_TYPE_RELATED, SUGGESTION_TYPE_SIM
+    };
+    const char *names[] = {
+        "SUGGESTION_TYPE_NONE", "SUGGESTION_TYPE_RELATED", "SUGGESTION_TYPE_SIM"
+    };
+    napi_value result = nullptr;
+    napi_status status = napi_create_object(env, &result);
+    if (status != napi_ok) {
+        return status;
+    }
+    for (size_t index = 0; index < sizeof(nativeTypes) / sizeof(nativeTypes[0]); ++index) {
+        int32_t number = 0;
+        if (!ToPublicSuggestionType(nativeTypes[index], number)) {
+            return napi_invalid_arg;
+        }
+        napi_value member = nullptr;
+        status = napi_create_int32(env, number, &member);
+        if (status != napi_ok) {
+            return status;
+        }
+        status = napi_set_named_property(env, result, names[index], member);
+        if (status != napi_ok) {
+            return status;
+        }
+    }
+    return napi_set_named_property(env, exports, "SuggestionType", result);
+}
