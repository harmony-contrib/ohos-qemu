+static void ExitRendererOnTermination(int signalNumber)
+{
+    // Only async-signal-safe operations: Chromium observes the process exit
+    // and reports it to the browser, which owns renderer recovery.
+    _exit(128 + signalNumber);
+}
+
+static bool EnableRendererNamespaceTermination(const std::string &processType)
+{
+    if (processType != "render" || getpid() != 1) {
+        return true;
+    }
+    // Namespace init ignores default-action SIGTERM, including M144's
+    // kill(getpid(), SIGTERM). An explicit disposition keeps PID isolation
+    // intact while making the public terminateRenderProcess API effective.
+    struct sigaction previous {};
+    if (sigaction(SIGTERM, nullptr, &previous) != 0) {
+        APPSPAWN_LOGE("query renderer SIGTERM disposition failed: %{public}d", errno);
+        return false;
+    }
+    if (previous.sa_handler == SIG_IGN) {
+        APPSPAWN_LOGE("renderer SIGTERM was explicitly ignored");
+        return false;
+    }
+    if (previous.sa_handler != SIG_DFL) {
+        return true; // Preserve an engine-owned explicit handler.
+    }
+    struct sigaction action {};
+    action.sa_handler = ExitRendererOnTermination;
+    if (sigemptyset(&action.sa_mask) != 0 || sigaction(SIGTERM, &action, nullptr) != 0) {
+        APPSPAWN_LOGE("install renderer SIGTERM disposition failed: %{public}d", errno);
+        return false;
+    }
+    return true;
+}
