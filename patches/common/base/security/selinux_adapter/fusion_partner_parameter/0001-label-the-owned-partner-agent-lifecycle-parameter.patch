diff --git a/base/security/selinux_adapter/sepolicy/ohos_policy/communication/fusion_connectivity/public/parameter_contexts b/base/security/selinux_adapter/sepolicy/ohos_policy/communication/fusion_connectivity/public/parameter_contexts
