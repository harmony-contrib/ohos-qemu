diff --git a/base/security/selinux_adapter/sepolicy/whitelist/qemu_cpu_sh.baseline b/base/security/selinux_adapter/sepolicy/whitelist/qemu_cpu_sh.baseline
new file mode 100644
--- /dev/null
+++ b/base/security/selinux_adapter/sepolicy/whitelist/qemu_cpu_sh.baseline
@@ -0,0 +1,10 @@
+# Exact QEMU CPU developer-shell baseline; no policy permissions are added.
+# Only the concrete type/class/permission tuples observed in Build09 are recorded.
+developer_only(`
+(allow sh qemu_voice_cpu_data (dir (open getattr search remove_name read write add_name)))
+(allow sh qemu_voice_cpu_data (file (create getattr write append unlink open setattr read rename lock)))
+(allow sh qemu_spatial_trace_file (dir (open getattr search remove_name read write add_name)))
+(allow sh qemu_spatial_trace_file (file (create getattr write append unlink open setattr read)))
+(allow sh qemu_voice_models_file (dir (open getattr search read)))
+(allow sh qemu_voice_models_file (file (open getattr read)))
+')
