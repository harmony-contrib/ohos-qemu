+    EXPECT_TRUE(manager.HasRight(OTHER_PORT, TEST_BUNDLE, TEST_TOKEN, TEST_USER));
+    EXPECT_TRUE(manager.HasRight(OTHER_PORT, TEST_BUNDLE, OTHER_TOKEN, OTHER_USER));
