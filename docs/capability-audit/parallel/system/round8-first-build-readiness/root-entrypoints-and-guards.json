      "lines": 72,
      "anchors": [
        {
          "line": 12,
          "text": "INPUT_DIRECTORIES = (\"scripts\", \"patches\", \"ci/capability-audit\", \"ci/qemu-smoke\")"
        },
        {
          "line": 13,
          "text": "INPUT_FILES = ("
        },
        {
          "line": 26,
          "text": "        for directory in INPUT_DIRECTORIES"
        },
        {
          "line": 31,
          "text": "                  for name in INPUT_FILES if (root / name).is_file()})"
        },
        {
          "line": 35,
          "text": "def snapshot(source: Path, destination: Path) -> dict:"
        },
        {
          "line": 36,
          "text": "    source, destination = source.resolve(), destination.resolve()"
        },
        {
          "line": 37,
          "text": "    if destination == source or destination.is_relative_to(source):"
        },
        {
          "line": 38,
          "text": "        raise ValueError(\"build input snapshot must be outside the source repository\")"
        },
        {
          "line": 39,
          "text": "    if not destination.is_dir() or any(destination.iterdir()):"
        },
        {
          "line": 40,
          "text": "        raise ValueError(\"snapshot destination must be an existing empty directory\")"
        },
        {
          "line": 42,
          "text": "    for directory in INPUT_DIRECTORIES:"
        },
        {
          "line": 44,
          "text": "            shutil.copytree(source / directory, destination / directory,"
        },
        {
          "line": 46,
          "text": "    for name in INPUT_FILES:"
        },
        {
          "line": 48,
          "text": "            (destination / name).parent.mkdir(parents=True, exist_ok=True)"
        },
        {
          "line": 49,
          "text": "            shutil.copy2(source / name, destination / name)"
        },
        {
          "line": 50,
          "text": "    copied = digest_files(destination)"
        },
        {
          "line": 59,
          "text": "        \"tree_sha256\": hashlib.sha256(json.dumps(copied, sort_keys=True).encode()).hexdigest(),"
        },
        {
          "line": 62,
          "text": "    (destination / \"build-inputs.json\").write_text(json.dumps(document, indent=2) + \"\\n\", encoding=\"utf-8\")"
        },
        {
          "line": 69,
          "text": "    parser.add_argument(\"--destination\", type=Path, required=True)"
        },
        {
          "line": 71,
          "text": "    result = snapshot(args.source, args.destination)"
        },
        {
          "line": 72,
          "text": "    print(f\"frozen build inputs: {args.destination} sha256={result['tree_sha256']}\")"
        }
      ]
    },
