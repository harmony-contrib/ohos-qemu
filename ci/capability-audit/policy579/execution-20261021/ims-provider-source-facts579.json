  "root_reviewed_findings": [
    "Both fixed release and current official tel_ims BUILD.gn select the six IMS demo translation units and SA4014 profile names libtel_ims.z.so.",
    "Demo request functions directly invoke local response callbacks; these source files do not implement real carrier IMS transport, registration, negotiated RTT session or RTT messages. Public client interfaces are preserved and are not an IMS provider.",
    "The corresponding official Telephony SIG describes the framework/vendor service boundary; enabling these same demo sources would not provide the missing transport.",
    "This disposition is confined to that fixed product/vendor provider scope. Fresh complete current source and independently read package image native-library/profile/init trees must still establish the same boundary. A new or changed provider invalidates the disposition."
  ],
  "unsupported_positive_scope": [
    "actual carrier IMS registration/negotiation behind current SA4014 vendor provider",
    "real IMS RTT session and messages requiring that provider"
  ],
  "mandatory_supported_scope": [
    "current actual AT/SIM/service/PTY/native source identities",
    "original full APN UI CRUD",
    "real CS incoming/outgoing/callbacks and modem failures/timeouts",
    "SMS actual submit/status-report/send/delivery/error",
    "two real UID CellularNetHandle IP packets and carrier loss/reattach",
    "RIL device reset/rebind and actual caller generation reconstruction",
    "original complete RTT10 permissions/invalid/no-session/no-modem/local-capability/listener cases",
    "original explicit5A URCs, false reset, off/crossUID/cache/queued-off/revoke/exit and full quiet/cleanup"
  ],
  "whole_id_unsupported": false,
  "repaired": false,
  "runtime_pass": false,
  "new_formal_closure": false,
  "passable_without_new_runtime": false
}
