#include "qemu_audio_provenance505.h"
#include <atomic>
#include <chrono>
#include <condition_variable>
#include <deque>
#include <list>
#include <map>
#include <iostream>
#define MEDIA_LOG_D(...) ((void)0)
#define MEDIA_LOG_D_T(...) ((void)0)
#define MEDIA_LOG_D_SHORT(...) ((void)0)
#define MEDIA_LOG_DD(...) ((void)0)
#define MEDIA_LOG_I(...) ((void)0)
#define MEDIA_LOG_I_T(...) ((void)0)
#define MEDIA_LOG_W(...) ((void)0)
#define MEDIA_LOG_E_T(...) ((void)0)
#define FALSE_RETURN_V_MSG(ok,value,...) do{if(!(ok))return(value);}while(0)
#define FALSE_RETURN_V_MSG_W(ok,value,...) FALSE_RETURN_V_MSG(ok,value)
static std::vector<std::string> raw;
static void Capture(const std::string&row){raw.push_back(row);}
static void Need(bool okay,const char*message){if(!okay){std::cerr<<message<<'\n';std::exit(1);}}
namespace MediaAVCodec{struct AVCodecTrace{explicit AVCodecTrace(const std::string&){};};}
namespace OHOS {
namespace AudioStandard {
enum class RendererState{RENDERER_INVALID,RENDERER_RUNNING,RENDERER_PAUSED,RENDERER_STOPPED};
enum class AudioSampleFormat{SAMPLE_S16LE,SAMPLE_F32LE};
struct AudioRendererParams{AudioSampleFormat sampleFormat=AudioSampleFormat::SAMPLE_S16LE;int channelCount=2;};
}
namespace Media {
struct Memory {std::vector<uint8_t>bytes;uint8_t*GetAddr(){return bytes.data();}size_t GetSize(){return bytes.size();}};
struct AVBuffer {std::shared_ptr<Memory>memory_;};
namespace Plugins {
enum class Status{OK,ERROR_AGAIN,ERROR_UNKNOWN,ERROR_NULL_POINTER,ERROR_WRONG_STATE};
enum class Seekable{SEEKABLE,INVALID};
struct MimeType{static constexpr const char*AUDIO_AVS3DA="vivid";};
@ACTUAL_CONSTANTS@
inline int64_t GetCurrentMillisecond(){static int64_t time=0;return ++time;}
struct FakeRenderer {
 using State=AudioStandard::RendererState;
 struct Action{int returned;State after;};std::deque<Action>actions;std::vector<uint8_t>received;
 State state=State::RENDERER_RUNNING;uint32_t session=71;int query=0;bool flush=true;
 State GetStatus(){return state;}
 int GetAudioStreamId(uint32_t&id)const{id=session;return query;}
 int Write(uint8_t*data,size_t bytes){Action action=actions.empty()?Action{static_cast<int>(bytes),state}:actions.front();if(!actions.empty())actions.pop_front();
  if(action.returned>0)received.insert(received.end(),data,data+std::min<size_t>(bytes,action.returned));state=action.after;return action.returned;}
 bool Flush(){return flush;}
};
class AudioServerSinkPlugin {
public:
 using State=AudioStandard::RendererState;
 std::unique_ptr<FakeRenderer>audioRenderer_{new FakeRenderer};AudioStandard::AudioRendererParams rendererParams_;
 std::mutex mutex_;std::condition_variable writeCond_;std::atomic<bool>isInterruptNeeded_{false};
 bool isForcePaused_=false;Seekable seekable_=Seekable::SEEKABLE;std::string mimeType_="pcm";int64_t writeDuration_=0;
#if QAP505_AFTER
 std::list<Qap505::Cached>cachedBuffers_;Qap505::Ledger provenance505_{Capture};
 void CacheData(uint8_t*,size_t,const Qap505::Slice&);
 size_t WriteAudioBuffer(uint8_t*,size_t,bool&,const Qap505::Slice&);
 void BindSourceProvenance505(const std::string&);void DropCachedProvenance505(const char*);
#else
 std::list<std::vector<uint8_t>>cachedBuffers_;
 void CacheData(uint8_t*,size_t);size_t WriteAudioBuffer(uint8_t*,size_t,bool&);
#endif
 Status DrainCacheData(bool);Status Write(const std::shared_ptr<OHOS::Media::AVBuffer>&);Status Flush();
 int WriteAudioVivid(const std::shared_ptr<OHOS::Media::AVBuffer>&){return 0;}
 void Bind(uint64_t generation){Qap505::Source s;s.pid=100;s.birth=200;s.generation=generation;
#if QAP505_AFTER
  BindSourceProvenance505(Qap505::Encode(s));
#endif
 }
 void Add(std::vector<uint8_t>bytes){
#if QAP505_AFTER
  auto slice=provenance505_.Input(bytes.data(),bytes.size());CacheData(bytes.data(),bytes.size(),slice);
#else
  CacheData(bytes.data(),bytes.size());
#endif
 }
};
@REAL_METHODS@
std::shared_ptr<AVBuffer> Buffer(unsigned seed,size_t length=16){auto b=std::make_shared<AVBuffer>();b->memory_=std::make_shared<Memory>();for(size_t i=0;i<length;++i)b->memory_->bytes.push_back(seed+i);return b;}
using State=AudioStandard::RendererState;
void Result(const char*name,Status result,AudioServerSinkPlugin&p){
 std::cout<<"{\"case\":\""<<name<<"\",\"status\":"<<static_cast<int>(result)<<",\"cache\":"<<p.cachedBuffers_.size()<<",\"received_bytes\":"<<(p.audioRenderer_?p.audioRenderer_->received.size():0)<<",\"received_sha256\":\""<<Qap505::SampleSha256(p.audioRenderer_?p.audioRenderer_->received.data():nullptr,p.audioRenderer_?p.audioRenderer_->received.size():0)<<"\"}\n";
}
int Run(){
 {AudioServerSinkPlugin p;p.Bind(1);auto r=p.Write(Buffer(1));Need(r==Status::OK&&p.audioRenderer_->received.size()==16,"full write");Result("full",r,p);}
 {AudioServerSinkPlugin p;p.Bind(2);p.audioRenderer_->actions={{4,State::RENDERER_RUNNING},{12,State::RENDERER_RUNNING}};auto r=p.Write(Buffer(2));Need(r==Status::OK&&p.audioRenderer_->received.size()==16,"partial writes");Result("partial",r,p);}
 {AudioServerSinkPlugin p;p.Bind(3);p.audioRenderer_->actions={{24,State::RENDERER_RUNNING}};auto r=p.Write(Buffer(3));Need(r==Status::OK,"original overlarge return clamp behavior changed");Result("overlarge-original",r,p);}
 {AudioServerSinkPlugin p;p.Bind(4);p.audioRenderer_->actions={{-1,State::RENDERER_PAUSED}};auto r=p.Write(Buffer(4));Need(r==Status::ERROR_UNKNOWN&&p.cachedBuffers_.size()==1,"paused write cache");
  Need(p.DrainCacheData(true)==Status::ERROR_AGAIN,"paused drain");p.audioRenderer_->state=State::RENDERER_RUNNING;p.audioRenderer_->actions={{4,State::RENDERER_RUNNING},{-1,State::RENDERER_PAUSED}};
  Need(p.DrainCacheData(true)==Status::ERROR_AGAIN&&p.cachedBuffers_.front().size()==12,"partial cached split");
#if QAP505_AFTER
  Need(p.cachedBuffers_.front().provenance.begin==4&&p.cachedBuffers_.front().provenance.bytes==12,"actual cache source slice split");
#endif
  p.audioRenderer_->state=State::RENDERER_RUNNING;auto done=p.DrainCacheData(true);Need(done==Status::OK&&p.cachedBuffers_.empty(),"cached completion");Result("cache-split",done,p);}
 {AudioServerSinkPlugin p;p.Bind(5);p.audioRenderer_->actions={{-1,State::RENDERER_RUNNING}};auto r=p.Write(Buffer(5));Need(r==Status::ERROR_UNKNOWN&&p.cachedBuffers_.empty(),"hard error drop");Result("hard-error",r,p);}
 {AudioServerSinkPlugin p;p.Bind(6);p.Add(Buffer(6)->memory_->bytes);p.Bind(7);auto r=p.Write(Buffer(7));Need(r==Status::OK&&p.audioRenderer_->received.size()==32,"old cache actual bytes still drain");Result("old-generation",r,p);}
 {AudioServerSinkPlugin p;p.Bind(8);for(unsigned i=0;i<DEFAULT_BUFFER_NUM+2;++i)p.Add(Buffer(i)->memory_->bytes);Need(p.cachedBuffers_.size()==DEFAULT_BUFFER_NUM,"bounded original cache limit");auto r=p.DrainCacheData(false);Need(r==Status::OK&&p.cachedBuffers_.empty(),"clear cache");Result("cache-limit-clear",r,p);}
 {AudioServerSinkPlugin p;p.Bind(9);p.Add(Buffer(9)->memory_->bytes);p.audioRenderer_->state=State::RENDERER_INVALID;auto r=p.DrainCacheData(true);Need(r==Status::ERROR_UNKNOWN&&p.cachedBuffers_.empty(),"invalid renderer drops cache");Result("invalid-state",r,p);}
 {AudioServerSinkPlugin p;p.Bind(10);p.isInterruptNeeded_=true;auto r=p.Write(Buffer(10));Need(r==Status::OK&&p.audioRenderer_->received.empty(),"original interrupt return");Result("interrupt",r,p);}
 {AudioServerSinkPlugin p;p.Bind(11);p.Add(Buffer(11)->memory_->bytes);p.audioRenderer_->actions={{-1,State::RENDERER_RUNNING}};auto r=p.Write(Buffer(12));Need(r==Status::ERROR_UNKNOWN&&p.cachedBuffers_.empty(),"failed cached drain drops input");Result("drain-failure",r,p);}
 {AudioServerSinkPlugin p;p.Bind(12);p.Add(Buffer(12)->memory_->bytes);auto r=p.Flush();Need(r==Status::OK&&p.cachedBuffers_.empty(),"actual Flush clears cache");Result("flush",r,p);}
 {AudioServerSinkPlugin p;p.Bind(13);p.audioRenderer_->flush=false;auto r=p.Flush();Need(r==Status::ERROR_UNKNOWN,"Flush error preserved");Result("flush-error",r,p);}
 {AudioServerSinkPlugin p;p.Bind(14);p.mimeType_="vivid";auto r=p.Write(Buffer(14));Need(r==Status::OK&&p.audioRenderer_->received.empty(),"other codec unchanged");Result("other-codec",r,p);}
 {AudioServerSinkPlugin p;p.Bind(15);p.audioRenderer_->query=-22;auto r=p.Write(Buffer(15));Need(r==Status::OK,"observer session query must not change playback return");Result("query-error",r,p);}
 {AudioServerSinkPlugin p;p.Bind(16);p.audioRenderer_.reset();auto r=p.Write(Buffer(16));Need(r==Status::ERROR_NULL_POINTER,"null renderer return preserved");Result("null-renderer",r,p);}
 {AudioServerSinkPlugin p;p.Bind(17);p.Add(Buffer(17)->memory_->bytes);p.audioRenderer_->session=72;p.Bind(18);auto r=p.Write(Buffer(18));Need(r==Status::OK&&p.audioRenderer_->received.size()==32,"new session must preserve old bytes and ordinary return");Result("renderer-session-change",r,p);}
 {AudioServerSinkPlugin p;p.audioRenderer_->query=-22;p.Bind(19);p.audioRenderer_->query=0;auto r=p.Write(Buffer(19));Need(r==Status::OK,"late successful session query cannot change ordinary return");Result("late-renderer-session",r,p);}
#if QAP505_AFTER
 bool late=false;for(const auto&r:raw)late|=r.find("\"query_status\":-22")!=std::string::npos&&r.find("\"write_renderer_session_known\":true")!=std::string::npos;
 Need(late,"metadata-time unknown session must retain actual successful Write-time session query");
 bool old=false,split=false,drop=false;for(const auto&r:raw){Need(r.find("\"accepted\":false")!=std::string::npos,"raw never accepts");old|=r.find("\"old_generation\":true")!=std::string::npos;split|=r.find("\"kind\":\"cache_split\"")!=std::string::npos;drop|=r.find("\"kind\":\"drop\"")!=std::string::npos;}
 Need(old&&split&&drop,"actual methods must emit generation/split/drop observations");
 std::cerr<<"raw_rows="<<raw.size()<<" onset=false\n";
#endif
 return 0;
}
}}}
int main(){return OHOS::Media::Plugins::Run();}
