#include "qemu_audio_provenance505.h"
#include <map>
#include <variant>
#include <iostream>
#define FALSE_RETURN_V_NOLOG(ok,value) do{if(!(ok))return(value);}while(0)
using Value=std::variant<int64_t,std::string>;
struct Meta {
 std::map<std::string,Value>values;auto begin(){return values.begin();}auto end(){return values.end();}
 void SetData(const std::string&key,const Value&value){values[key]=value;}
 bool GetData(const std::string&key,std::string&value){auto i=values.find(key);if(i==values.end()||!std::holds_alternative<std::string>(i->second))return false;value=std::get<std::string>(i->second);return true;}
};
using MapIt=std::map<std::string,Value>::iterator;
namespace Tag{constexpr const char*APP_PID="pid";constexpr const char*APP_UID="uid";}
struct Sink {std::vector<std::map<std::string,Value>>calls;void SetParameter(const std::shared_ptr<Meta>&value){calls.push_back(value->values);}};
struct Demuxer {std::shared_ptr<Meta>meta=std::make_shared<Meta>();std::shared_ptr<Meta>GetGlobalMetaInfo(){return meta;}};
static std::vector<std::string>rows;static void EmitProvenance505(const std::string&row){rows.push_back(row);}
static void Need(bool okay,const char*message){if(!okay){std::cerr<<message<<'\n';std::exit(1);}}
class HiPlayerImpl {
public:
 std::shared_ptr<Meta>audioRenderInfo_=std::make_shared<Meta>(),audioInterruptMode_=std::make_shared<Meta>();
 std::shared_ptr<Sink>audioSink_=std::make_shared<Sink>();std::shared_ptr<Demuxer>demuxer_=std::make_shared<Demuxer>();
 std::shared_ptr<const std::string>audioSourceProvenance505_;int appPid_=17,appUid_=20000017,volumeMode_=3,volumeCalls=0;
 void SetVolumeMode(int){volumeCalls++;}
 void SetAudioRendererParameter();
#if QAP505_AFTER
 void ApplyAudioSourceProvenance505();
#endif
};
@REAL_METHODS@
int main(){
 HiPlayerImpl p;p.demuxer_->meta->SetData("rate",int64_t{48000});p.demuxer_->meta->SetData("channels",int64_t{2});p.demuxer_->meta->SetData("duration",int64_t{60000000});
 p.audioRenderInfo_->SetData("usage",int64_t{11});p.audioRenderInfo_->SetData("format",std::string{"S16LE"});p.audioInterruptMode_->SetData("interrupt",int64_t{5});
 p.SetAudioRendererParameter();Need(p.volumeCalls==1&&p.audioSink_->calls.size()==3,"original initialization calls");
 auto ordinary=p.audioSink_->calls.back();Need(ordinary.size()==8&&std::get<int64_t>(ordinary["pid"])==17&&std::get<int64_t>(ordinary["uid"])==20000017,"complete original metadata retained");
 std::cout<<"{\"ordinary_fields\":"<<ordinary.size()<<",\"volume_calls\":"<<p.volumeCalls<<"}\n";
#if QAP505_AFTER
 Qap505::Source source;source.pid=17;source.birth=100;source.generation=9;auto descriptor=Qap505::Encode(source);
 std::atomic_store(&p.audioSourceProvenance505_,std::make_shared<const std::string>(descriptor));
 // Simulate GetGlobalMetaInfo returning a fresh basic map, not the map previously enriched.
 p.demuxer_->meta=std::make_shared<Meta>();p.demuxer_->meta->SetData("rate",int64_t{48000});p.demuxer_->meta->SetData("channels",int64_t{2});p.demuxer_->meta->SetData("duration",int64_t{60000000});
 p.audioRenderInfo_->SetData(Qap505::KEY,std::string{"stale-other-generation"});
 p.ApplyAudioSourceProvenance505();auto forwarded=p.audioSink_->calls.back();
 Need(forwarded.size()==1,"late provenance must be strictly one private key");
 Need(std::get<std::string>(forwarded.at(Qap505::KEY))==descriptor,"native source generation must override stale metadata key");Need(p.volumeCalls==1,"observer must not repeat volume-mode API");
 p.SetAudioRendererParameter();Need(std::get<std::string>(p.audioSink_->calls.back().at(Qap505::KEY))==descriptor,"sink recreation must keep current provenance");
 std::atomic_store(&p.audioSourceProvenance505_,std::make_shared<const std::string>());p.ApplyAudioSourceProvenance505();Need(std::get<std::string>(p.audioSink_->calls.back().at(Qap505::KEY)).empty(),"seek must retire source mapping");
 std::atomic_store(&p.audioSourceProvenance505_,std::shared_ptr<const std::string>{});p.SetAudioRendererParameter();Need(std::get<std::string>(p.audioSink_->calls.back().at(Qap505::KEY)).empty(),"old Meta cannot resurrect previous generation");
 auto saved=p.audioSink_;size_t before=saved->calls.size();p.audioSink_.reset();p.ApplyAudioSourceProvenance505();Need(saved->calls.size()==before,"missing sink preserves pending provenance without business calls");p.audioSink_=saved;
 for(const auto&row:rows)Need(row.find("\"onset_proven\":false")!=std::string::npos,"forwarding may not claim onset");
 std::cerr<<"late_Meta/source_recreation/stale_generation/seek/no_source checks=7 onset=false\n";
#endif
 return 0;
}
