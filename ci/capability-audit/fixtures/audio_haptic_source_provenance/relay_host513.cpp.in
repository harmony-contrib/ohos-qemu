#include "qemu_audio_provenance505.h"
#include <functional>
#include <map>
#include <variant>
#include <iostream>
#define MEDIA_LOG_I_T(...) ((void)0)
#define MEDIA_LOG_D_T(...) ((void)0)
#define FALSE_RETURN_V(ok,value) do{if(!(ok))return(value);}while(0)
#define FALSE_RETURN_V_MSG_E(ok,value,...) FALSE_RETURN_V(ok,value)
static void Need(bool okay,const char*message){if(!okay){std::cerr<<message<<'\n';std::exit(1);}}
using ValueType=std::variant<int32_t,std::string>;
using AudioInterruptMode=int32_t;
namespace AudioStandard{using InterruptMode=int32_t;}
struct Any{template<class T>static bool IsSameTypeWith(const ValueType &v){return std::holds_alternative<T>(v);}};
template<class T>T AnyCast(const ValueType&v){return std::get<T>(v);}
namespace Tag{constexpr const char*APP_PID="pid";constexpr const char*APP_UID="uid";constexpr const char*AUDIO_INTERRUPT_MODE="interrupt";}
struct Meta{
 std::map<std::string,ValueType>values;auto begin(){return values.begin();}auto end(){return values.end();}
 void SetData(const std::string&key,const ValueType&v){values[key]=v;}
 template<class T>bool GetData(const std::string&key,T&v){auto it=values.find(key);if(it==values.end()||!std::holds_alternative<T>(it->second))return false;v=std::get<T>(it->second);return true;}
};
using MapIt=std::map<std::string,ValueType>::iterator;
enum class Status{OK,ERROR_NULL_POINTER,ERROR_MISMATCHED_TYPE};
void AudioInterruptMode2InterruptMode(int input,int&output){output=input;}
struct Renderer{int interruptCalls=0,last=-1;void SetInterruptMode(int mode){interruptCalls++;last=mode;}};
class AudioServerSinkPlugin{
public:
 std::map<std::string,std::function<Status(const ValueType&)>>paramsSetterMap_;
 std::shared_ptr<Renderer>audioRenderer_=std::make_shared<Renderer>();int audioInterruptMode_=0,appUid_=0,uidSetterCalls=0,otherSetterCalls=0,provenanceCalls=0;std::string descriptor;
 AudioServerSinkPlugin(){SetUpAudioInterruptModeSetter();SetUpAppUidSetter();auto uid=paramsSetterMap_[Tag::APP_UID];paramsSetterMap_[Tag::APP_UID]=[this,uid](const ValueType&v){uidSetterCalls++;return uid(v);};paramsSetterMap_["sample"]=[this](const ValueType&){otherSetterCalls++;return Status::OK;};paramsSetterMap_[Qap505::KEY]=[this](const ValueType&v){provenanceCalls++;if(!Any::IsSameTypeWith<std::string>(v))return Status::ERROR_MISMATCHED_TYPE;descriptor=AnyCast<std::string>(v);return Status::OK;};}
 Status SetParameter(const std::shared_ptr<Meta>&meta);void SetUpAudioInterruptModeSetter();void SetUpAppUidSetter();void SetInterruptMode(AudioStandard::InterruptMode);
};
class AudioSink{
public:
 std::shared_ptr<Meta>globalMeta_;std::shared_ptr<AudioServerSinkPlugin>plugin_=std::make_shared<AudioServerSinkPlugin>();int appPid_=0,appUid_=0,timeRangeCalls=0;
 void UpdateMediaTimeRange(const std::shared_ptr<Meta>&){timeRangeCalls++;}
 Status SetParameter(const std::shared_ptr<Meta>&);
};
class AudioSinkFilter{
public:
 std::shared_ptr<Meta>globalMeta_;std::shared_ptr<AudioSink>audioSink_=std::make_shared<AudioSink>();
 void SetParameter(const std::shared_ptr<Meta>&);
};
struct Demuxer{std::shared_ptr<Meta>meta=std::make_shared<Meta>();std::shared_ptr<Meta>GetGlobalMetaInfo(){return meta;}};
static void EmitProvenance505(const std::string&){}
class HiPlayerImpl{
public:
 std::shared_ptr<Meta>audioRenderInfo_=std::make_shared<Meta>(),audioInterruptMode_=std::make_shared<Meta>();std::shared_ptr<AudioSinkFilter>audioSink_=std::make_shared<AudioSinkFilter>();std::shared_ptr<Demuxer>demuxer_=std::make_shared<Demuxer>();std::shared_ptr<const std::string>audioSourceProvenance505_;int appPid_=17,appUid_=20000017,volumeMode_=3,volumeCalls=0;
 void SetVolumeMode(int){volumeCalls++;}void SetAudioRendererParameter();void ApplyAudioSourceProvenance505();
};
@REAL_METHODS@
int main(int argc,char**argv){
 HiPlayerImpl p;p.demuxer_->meta->SetData("sample",int32_t{48000});p.demuxer_->meta->SetData("duration",int32_t{6000});p.audioRenderInfo_->SetData("format",std::string{"S16LE"});p.audioInterruptMode_->SetData(Tag::AUDIO_INTERRUPT_MODE,int32_t{5});
 p.SetAudioRendererParameter();auto filter=p.audioSink_;auto sink=filter->audioSink_;auto plugin=sink->plugin_;auto full=filter->globalMeta_;auto original=full->values;
 Need(plugin->audioRenderer_->interruptCalls==2&&plugin->uidSetterCalls==1&&plugin->otherSetterCalls==1&&sink->timeRangeCalls==3&&p.volumeCalls==1,"original ordinary full-Meta trace changed");
 Qap505::Source source;source.pid=17;source.birth=100;source.generation=9;auto descriptor=Qap505::Encode(source);std::atomic_store(&p.audioSourceProvenance505_,std::make_shared<const std::string>(descriptor));p.ApplyAudioSourceProvenance505();
 Need(plugin->descriptor==descriptor&&plugin->provenanceCalls==1,"private descriptor not delivered to plugin");
 bool replay=plugin->audioRenderer_->interruptCalls!=2||plugin->uidSetterCalls!=1||plugin->otherSetterCalls!=1||sink->timeRangeCalls!=3;
#if QAP513_AFTER
 Need(!replay,"late observer replayed an ordinary setter or range update");Need(filter->globalMeta_==full&&sink->globalMeta_==full&&full->values==original,"private Meta replaced or altered globalMeta");
 std::atomic_store(&p.audioSourceProvenance505_,std::make_shared<const std::string>());p.ApplyAudioSourceProvenance505();Need(plugin->descriptor.empty()&&plugin->audioRenderer_->interruptCalls==2,"retire must not replay native setter");
 auto wrong=std::make_shared<Meta>();wrong->SetData(Qap505::KEY,int32_t{4});filter->SetParameter(wrong);Need(sink->SetParameter(wrong)==Status::ERROR_MISMATCHED_TYPE,"private key type must be checked");Need(filter->globalMeta_==full&&sink->globalMeta_==full&&plugin->provenanceCalls==2&&sink->timeRangeCalls==3,"wrong type changed business state");
 auto packet=std::make_shared<Meta>();packet->SetData(Qap505::KEY,descriptor);sink->plugin_.reset();Need(sink->SetParameter(packet)==Status::ERROR_NULL_POINTER&&sink->globalMeta_==full&&sink->timeRangeCalls==3,"unprepared plugin must preserve business state");sink->plugin_=plugin;
 filter->audioSink_.reset();filter->SetParameter(packet);Need(filter->globalMeta_==full,"unprepared sink must preserve filter Meta");filter->audioSink_=sink;
 // Two keys are ordinary metadata, even when one is private; no broad bypass.
 auto mixed=std::make_shared<Meta>();mixed->SetData(Qap505::KEY,descriptor);mixed->SetData(Tag::APP_UID,int32_t{111});filter->SetParameter(mixed);Need(filter->globalMeta_==mixed&&sink->globalMeta_==mixed&&sink->appUid_==111&&plugin->uidSetterCalls==2&&sink->timeRangeCalls==4,"multi-key ordinary path was skipped");
 // On recreation the original ordinary full-Meta path configures the new sink.
 p.audioSink_=std::make_shared<AudioSinkFilter>();p.SetAudioRendererParameter();auto fresh=p.audioSink_->audioSink_;Need(fresh->plugin_->audioRenderer_->interruptCalls==2&&fresh->plugin_->uidSetterCalls==1&&fresh->timeRangeCalls==3,"recreated ordinary setter trace changed");
 auto saved=p.audioSink_;p.audioSink_.reset();p.ApplyAudioSourceProvenance505();p.audioSink_=saved;
#endif
 std::cout<<"{\"ordinary_interrupt_calls\":2,\"ordinary_uid_calls\":1,\"ordinary_other_calls\":1,\"ordinary_time_range_calls\":3,\"late_replayed\":"<<(replay?"true":"false")<<",\"accepted\":false,\"onset_proven\":false}\n";
 if(argc==2&&std::string(argv[1])=="require-no-replay"&&replay){std::cerr<<"actual rejected full-Meta helper replays native SetInterruptMode/UID/other setter/range\n";return 1;}
 return 0;
}
