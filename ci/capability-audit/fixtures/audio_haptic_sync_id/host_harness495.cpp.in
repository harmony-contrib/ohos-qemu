#include <atomic>
#include <condition_variable>
#include <cstdint>
#include <functional>
#include <iostream>
#include <memory>
#include <mutex>
#include <stdexcept>
#include <string>
#include <thread>
#include <vector>
#define AUDIO_INFO_LOG(...) ((void)0)
#define CHECK_AND_RETURN_RET_LOG(ok,code,...) do { if (!(ok)) return (code); } while (0)
#define CHECK_AND_RETURN_RET(ok,code) do { if (!(ok)) return (code); } while (0)
#define CHECK_AND_CALL_FUNC_RETURN_RET_LOG(ok,code,...) CHECK_AND_RETURN_RET(ok,code)
#define CHECK_AND_CALL_FUNC_RETURN_RET_REPORT(ok,code,...) CHECK_AND_RETURN_RET(ok,code)
constexpr int SUCCESS=0,ERR_OPERATION_FAILED=-2,ERR_ILLEGAL_STATE=-3;
constexpr int STREAM_STARTING=4,AUDIO_STREAM_START=10,SESSION_OPERATION_START=11;
constexpr int SESSION_OP_MSG_FAST_CHANGE_TO_NORMAL=12,SESSION_OP_MSG_DEFAULT=13,AUDIO_OUTPUT_FLAG_FAST=1;
enum ManagerType { PLAYBACK,DIRECT_PLAYBACK,VOIP_PLAYBACK,EAC3_PLAYBACK,AUDIO_VIVID_3DA_DIRECT_PLAYBACK };
constexpr int NORMAL_PLAYBACK=0,INJECT_TO_VOICE_COMMUNICATION_CAPTURE=1;
std::vector<std::string> trace;
struct CoreServiceHandler {
 int policy=0;
 static CoreServiceHandler& GetInstance(){static CoreServiceHandler c;return c;}
 int UpdateSessionOperation(uint32_t,int,int=0){trace.push_back("policy");return policy;}
 int StartInjection(uint32_t){trace.push_back("injection");return policy;}
};
struct ClockTime {static uint64_t GetCurNano(){return 1;}};
struct AudioPerformanceMonitor {
 static AudioPerformanceMonitor& GetInstance(){static AudioPerformanceMonitor a;return a;}
 void StartSilenceMonitor(uint32_t,int,int){trace.push_back("silence");}
};
struct Checker{void MonitorOnAllCallback(int,bool){trace.push_back("monitor");}};
struct Buffer{std::atomic<int> status{0};std::atomic<int>*GetStreamStatus(){return &status;}};
// External backend test surface. No fabricated renderer/PCM/HW data is produced.
struct Backend {
 int result=0;std::function<void()>during;std::vector<int>ids;
 virtual ~Backend()=default;
 virtual int Start(){trace.push_back("stream-start");ids.push_back(0);if(during)during();return result;}
 virtual int StartWithSyncId(const int32_t &id){trace.push_back("stream-sync");ids.push_back(id);if(during)during();return result;}
};
// Actual IStream default fallback contract, with its external Start controlled.
struct PaBackend final:Backend {int StartWithSyncId(const int32_t &)override{return Start();}};
struct IStreamManager {
 Backend backend;std::vector<int>ids;int result=0;std::function<void()>during;
 static IStreamManager& GetPlaybackManager(ManagerType){static IStreamManager m;return m;}
 int StartRender(uint32_t){trace.push_back("manager-start");ids.push_back(0);if(during)during();return result;}
 int StartRenderWithSyncId(uint32_t,const int32_t&id){trace.push_back("manager-sync");ids.push_back(id);if(during)during();return result;}
};
struct RendererInServer {
 ManagerType managerType_=PLAYBACK;std::shared_ptr<Backend> stream_=std::make_shared<Backend>();
 std::atomic<int32_t>audioHapticsSyncId_{0};uint32_t streamIndex_=37;
 std::shared_ptr<Buffer>audioServerBuffer_=std::make_shared<Buffer>();
 int standByCounter_=0,needForceWrite_=0,lastTarget_=NORMAL_PLAYBACK;std::atomic<bool>isOffloadJankReport{true};
 uint64_t startedTime_=0,enterStandbyTime_=9;bool standByEnable_=false;
 int validate=SUCCESS,setup=SUCCESS,standby=SUCCESS;
 struct {struct {int audioFlag=0;}rendererInfo;struct {int appUid=1,appTokenId=2,appPid=3;}appInfo;}processConfig_;
 std::shared_ptr<Checker>audioStreamChecker_=std::make_shared<Checker>();
 int Standby(bool){trace.push_back("standby-off");return standby;}
 void RecordStandbyTime(bool,bool){trace.push_back("record-standby");}
 int ValidateStartState(){trace.push_back("validate");return validate;}
 int ValidateAndSetupBufferForStart(){trace.push_back("buffers");return setup;}
 void WaitForDataConnection(){trace.push_back("wait");}
 void UpdateStartTimeInfo(){trace.push_back("update-time");}
 void StartStreamByType(){trace.push_back("dup-start");}
 void dualToneStreamInStart(){trace.push_back("dual-start");}
 int32_t StartInnerDuringStandby();int32_t StartInner(bool);
};
@REAL_FUNCTIONS@

void need(bool ok,const char*msg){if(!ok)throw std::runtime_error(msg);}
void reset(){trace.clear();auto&m=IStreamManager::GetPlaybackManager(PLAYBACK);m.ids.clear();m.result=0;m.during={};CoreServiceHandler::GetInstance().policy=0;}
bool managerBranch(ManagerType t,bool standby){return t==DIRECT_PLAYBACK||t==VOIP_PLAYBACK||(!standby&&(t==EAC3_PLAYBACK||t==AUDIO_VIVID_3DA_DIRECT_PLAYBACK));}
int run(RendererInServer&r,bool standby){return standby?r.StartInnerDuringStandby():r.StartInner(false);}
size_t where(const std::string&s){for(size_t i=0;i<trace.size();++i)if(trace[i]==s)return i;return trace.size();}
int checks=0;
void testPaths(bool propagation){
 for(bool standby:{false,true})for(auto type:{PLAYBACK,DIRECT_PLAYBACK,VOIP_PLAYBACK,EAC3_PLAYBACK,AUDIO_VIVID_3DA_DIRECT_PLAYBACK})for(int id:{0,-9,731}){
  reset();RendererInServer r;r.managerType_=type;r.audioHapticsSyncId_=id;
  need(run(r,standby)==0,"backend success changed");bool manager=managerBranch(type,standby);
  auto&ids=manager?IStreamManager::GetPlaybackManager(type).ids:r.stream_->ids;
  need(ids.size()==1,"exact one backend start required");need(ids[0]==((id>0&&propagation)?id:0),"positive sync ID not propagated");
  need(r.audioHapticsSyncId_==id,"stored private ID lifecycle changed");
  need(where("policy")<where(manager?(id>0&&propagation?"manager-sync":"manager-start"):(id>0&&propagation?"stream-sync":"stream-start")),"backend moved before policy");
  if(!standby)need(where("policy")<where("wait")&&where("wait")<where(manager?(id>0&&propagation?"manager-sync":"manager-start"):(id>0&&propagation?"stream-sync":"stream-start")),"connection wait order changed");
  checks++;
 }
}
void testFailures(bool propagation){
 for(bool standby:{false,true})for(bool manager:{false,true}){
  reset();RendererInServer r;r.managerType_=manager?DIRECT_PLAYBACK:PLAYBACK;r.audioHapticsSyncId_=52;
  r.stream_->result=-77;IStreamManager::GetPlaybackManager(PLAYBACK).result=-77;
  need(run(r,standby)==-77,"backend error was normalized");need(r.audioHapticsSyncId_==52,"failed start lost pending ID");
  auto&ids=manager?IStreamManager::GetPlaybackManager(PLAYBACK).ids:r.stream_->ids;need(ids==std::vector<int>{propagation?52:0},"failure path ID differs");
  if(!standby)need(where("update-time")==trace.size(),"failed start ran success continuation");
  checks++;
 }
 for(bool standby:{false,true}){
  reset();RendererInServer r;r.audioHapticsSyncId_=88;CoreServiceHandler::GetInstance().policy=-91;
  need(run(r,standby)==-91,"policy error changed");need(r.stream_->ids.empty()&&r.audioHapticsSyncId_==88,"policy failure started backend or changed ID");checks++;
 }
 for(int state:{ERR_ILLEGAL_STATE,ERR_OPERATION_FAILED}){
  reset();RendererInServer r;r.audioHapticsSyncId_=73;r.validate=state;
  need(run(r,false)==ERR_ILLEGAL_STATE,"invalid/released/stopped-state admission changed");need(r.stream_->ids.empty(),"invalid state reached backend");checks++;
 }
}
void testConcurrency(bool propagation){
 for(bool standby:{false,true})for(bool manager:{false,true}){
  reset();RendererInServer r;r.managerType_=manager?DIRECT_PLAYBACK:PLAYBACK;r.audioHapticsSyncId_=701;
  std::mutex mu;std::condition_variable cv;bool entered=false,resume=false;
  auto pause=[&]{std::unique_lock<std::mutex>l(mu);entered=true;cv.notify_one();cv.wait(l,[&]{return resume;});};
  if(manager)IStreamManager::GetPlaybackManager(PLAYBACK).during=pause;else r.stream_->during=pause;
  int result=999;std::thread t([&]{result=run(r,standby);});
  {std::unique_lock<std::mutex>l(mu);cv.wait(l,[&]{return entered;});r.audioHapticsSyncId_.store(702);resume=true;cv.notify_one();}
  t.join();need(result==0&&r.audioHapticsSyncId_==702,"in-flight start overwrote later setter");
  if(manager)IStreamManager::GetPlaybackManager(PLAYBACK).during={};else r.stream_->during={};
  need(run(r,standby)==0,"reuse start failed");auto&ids=manager?IStreamManager::GetPlaybackManager(PLAYBACK).ids:r.stream_->ids;
  need(ids==std::vector<int>({propagation?701:0,propagation?702:0}),"atomic snapshot/later start ID changed");checks++;
 }
}
void testFallback(){
 for(bool standby:{false,true}){
  reset();RendererInServer r;r.stream_=std::make_shared<PaBackend>();r.audioHapticsSyncId_=81;
  need(run(r,standby)==0&&r.stream_->ids==std::vector<int>{0},"PA/default Start fallback changed");checks++;
 }
}
int main(int argc,char**argv){
 if(argc==2&&std::string(argv[1])=="--probe-propagation"){
  int missing=0;
  for(bool standby:{false,true})for(bool manager:{false,true}){
   reset();RendererInServer r;r.managerType_=manager?DIRECT_PLAYBACK:PLAYBACK;r.audioHapticsSyncId_=495;
   int rc=run(r,standby);auto&ids=manager?IStreamManager::GetPlaybackManager(PLAYBACK).ids:r.stream_->ids;
   if(rc!=0||ids!=std::vector<int>{495})missing++;
  }
  std::cout<<"{\"positive_ID_routes_missing\":"<<missing<<",\"accepted\":false,\"onset_proven\":false}"<<std::endl;
  return missing?1:0;
 }
 bool propagation=argc==2&&std::string(argv[1])=="--expect-propagation";
 try{testPaths(propagation);testFailures(propagation);testConcurrency(propagation);testFallback();
  std::cout<<"{\"checks\":"<<checks<<",\"scope\":\"extracted_two_real_functions_with_controlled_external_backends_ONLY\",\"onset_proven\":false,\"accepted\":false}"<<std::endl;return 0;
 }catch(const std::exception&e){std::cerr<<e.what()<<std::endl;return 1;}
}
