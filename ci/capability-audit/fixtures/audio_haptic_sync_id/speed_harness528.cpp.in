#include "audio_speed.h"
#include "audio_errors.h"
#include <cassert>
#include <cmath>
#include <cstring>
#include <iostream>
#include <vector>
using namespace OHOS::AudioStandard;
int bytes(int f){return f==SAMPLE_U8?1:f==SAMPLE_S16LE?2:f==SAMPLE_S24LE?3:4;}
std::vector<uint8_t> audio(int f,int ch,int frames){int b=bytes(f);std::vector<uint8_t>v(size_t(frames)*ch*b);for(int i=0;i<frames*ch;i++){float x=std::sin(i*.031f)*.25f;
 if(f==SAMPLE_U8)v[i]=uint8_t(128+x*100);else if(f==SAMPLE_S16LE){int16_t n=int16_t(x*32767);std::memcpy(v.data()+i*b,&n,b);}else if(f==SAMPLE_S24LE){int32_t n=int32_t(x*8388607);v[i*b]=n;v[i*b+1]=n>>8;v[i*b+2]=n>>16;}else if(f==SAMPLE_S32LE){int32_t n=int32_t(x*2147483647);std::memcpy(v.data()+i*b,&n,b);}else std::memcpy(v.data()+i*b,&x,b);}return v;}
std::vector<uint8_t> convert(std::vector<uint8_t>&in,int f,int ch,float rate,int cap,float pitch=1.f){AudioSpeed s(8000,f,ch,cap);assert(s.SetSpeed(rate)==SUCCESS);assert(s.SetPitch(pitch)==SUCCESS);auto out=std::make_unique<uint8_t[]>(cap);int n=-1;assert(s.ChangeSpeedFunc(in.data(),in.size(),out,n)==int(in.size()));assert(n>=0&&n<=cap&&n%(bytes(f)*ch)==0);std::vector<uint8_t>all(out.get(),out.get()+n);
 do{assert(s.ReadOutput(out,n)==SUCCESS);assert(n>=0&&n<=cap&&n%(bytes(f)*ch)==0);all.insert(all.end(),out.get(),out.get()+n);}while(n);
 assert(s.Finish()==SUCCESS);do{assert(s.ReadOutput(out,n)==SUCCESS);assert(n>=0&&n<=cap&&n%(bytes(f)*ch)==0);all.insert(all.end(),out.get(),out.get()+n);}while(n);
 assert(s.Finish()==SUCCESS);assert(s.ReadOutput(out,n)==SUCCESS&&n==0);return all;}
int main(){int cases=0;
 for(int f:{SAMPLE_U8,SAMPLE_S16LE,SAMPLE_S24LE,SAMPLE_S32LE,SAMPLE_F32LE})for(int ch:{1,2,8})for(float rate:{.125f,.5f,1.f,2.f}){
  auto in=audio(f,ch,3200);auto expected=convert(in,f,ch,rate,8*1024*1024);assert(!expected.empty());for(int cap:{61,64}){assert(convert(in,f,ch,rate,cap)==expected);cases++;}}
 {AudioSpeed s(8000,SAMPLE_S16LE,1,64);s.SetSpeed(.125f);s.SetPitch(.75f);auto in=audio(SAMPLE_S16LE,1,3200);auto out=std::make_unique<uint8_t[]>(64);int n;assert(s.ChangeSpeedFunc(in.data(),in.size(),out,n)==int(in.size()));assert(s.Reconfigure(16000,SAMPLE_F32LE,2)==SUCCESS);assert(s.GetSpeed()==.125f);assert(s.ReadOutput(out,n)==SUCCESS&&n==0);auto fresh=audio(SAMPLE_F32LE,2,100);assert(s.ChangeSpeedFunc(fresh.data(),fresh.size(),out,n)==int(fresh.size()));assert(s.Flush()==SUCCESS);assert(s.ReadOutput(out,n)==SUCCESS&&n==0);cases++;}
 {AudioSpeed s(8000,SAMPLE_S16LE,1,64);s.SetSpeed(.5f);auto out=std::make_unique<uint8_t[]>(64);auto in=audio(SAMPLE_S16LE,1,10);int n;assert(s.ChangeSpeedFunc(in.data(),in.size(),out,n)==int(in.size()));assert(n==0);assert(s.Finish()==SUCCESS);assert(s.ReadOutput(out,n)==SUCCESS&&n>0);cases++;}
 // Legal full-scale S16 boundary: signed DC, alternating rails and sparse opposite rail.
 for(int pattern:{0,1,2,3})for(int ch:{1,2,8})for(float speed:{.125f,.5f,1.f,2.f})for(float pitch:{.5f,.75f,1.f,2.f}){
  std::vector<uint8_t>in(size_t(3200)*ch*2);
  for(int i=0;i<3200*ch;i++){int16_t v=pattern==0?32767:pattern==1?-32768:pattern==2?(i%2?32767:-32768):(i%17?32767:-32768);std::memcpy(in.data()+i*2,&v,2);}
  auto expected=convert(in,SAMPLE_S16LE,ch,speed,8*1024*1024,pitch);assert(!expected.empty());
  for(int cap:{63,64}){assert(convert(in,SAMPLE_S16LE,ch,speed,cap,pitch)==expected);cases++;}
 }
 std::cout<<"SPEED537 complete AudioSpeed + separately certified Sonic "<<cases<<" normal bounded-read/format/low-speed/finish/reconfigure cases PASS\n";
}
