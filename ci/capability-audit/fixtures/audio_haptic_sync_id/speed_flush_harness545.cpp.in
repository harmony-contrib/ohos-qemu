#include "audio_speed.h"
#include "audio_errors.h"
#include "sonic.h"
#include <cassert>
#include <cmath>
#include <cstring>
#include <iostream>
#include <vector>
using namespace OHOS::AudioStandard;

// Host dependency seam: the complete certified Sonic C is compiled with only
// its create/destroy symbols renamed. Successful calls run those real functions;
// a requested create failure returns null before any C allocation. No production
// bytes, Sonic algorithm or AudioSpeed function are replaced.
extern "C" sonicStream sonicCreateStreamActual545(int, int);
extern "C" void sonicDestroyStreamActual545(sonicStream);
static int failCreates545 = 0, active545 = 0, createCalls545 = 0;
extern "C" sonicStream sonicCreateStream(int rate, int channels)
{
    ++createCalls545;
    if (failCreates545 > 0) { --failCreates545; return nullptr; }
    auto stream = sonicCreateStreamActual545(rate, channels);
    if (stream != nullptr) { ++active545; }
    return stream;
}
extern "C" void sonicDestroyStream(sonicStream stream)
{
    assert(stream != nullptr && active545 > 0);
    --active545;
    sonicDestroyStreamActual545(stream);
}
static int width545(int f)
{
    return f == SAMPLE_U8 ? 1 : f == SAMPLE_S16LE ? 2 : f == SAMPLE_S24LE ? 3 : 4;
}
static std::vector<uint8_t> input545(int f, int channels, int frames, double phase)
{
    int width = width545(f);
    std::vector<uint8_t> bytes(size_t(frames) * channels * width);
    for (int i = 0; i < frames * channels; ++i) {
        float value = float(std::sin(i * .031 + phase) * .25);
        if (f == SAMPLE_U8) { bytes[i] = uint8_t(128 + value * 100); }
        else if (f == SAMPLE_S16LE) {
            int16_t n = int16_t(value * 32767); std::memcpy(bytes.data() + i * width, &n, width);
        } else if (f == SAMPLE_S24LE) {
            int32_t n = int32_t(value * 8388607);
            bytes[i * width] = n; bytes[i * width + 1] = n >> 8; bytes[i * width + 2] = n >> 16;
        } else if (f == SAMPLE_S32LE) {
            int32_t n = int32_t(value * 2147483647); std::memcpy(bytes.data() + i * width, &n, width);
        } else { std::memcpy(bytes.data() + i * width, &value, width); }
    }
    return bytes;
}
static std::vector<uint8_t> finish545(AudioSpeed &stream, std::vector<uint8_t> &input)
{
    auto output = std::make_unique<uint8_t[]>(64);
    int count = -1;
    assert(stream.ChangeSpeedFunc(input.data(), input.size(), output, count) == int(input.size()));
    assert(count >= 0 && count <= 64);
    std::vector<uint8_t> bytes(output.get(), output.get() + count);
    assert(stream.Finish() == SUCCESS);
    size_t calls = 0;
    do {
        assert(++calls < 100000);
        assert(stream.ReadOutput(output, count) == SUCCESS && count >= 0 && count <= 64);
        bytes.insert(bytes.end(), output.get(), output.get() + count);
    } while (count > 0);
    assert(stream.Finish() == SUCCESS && stream.ReadOutput(output, count) == SUCCESS && count == 0);
    return bytes;
}
int main()
{
    int cases = 0, differences = 0;
    for (int format : {SAMPLE_U8, SAMPLE_S16LE, SAMPLE_S24LE, SAMPLE_S32LE, SAMPLE_F32LE}) {
        for (int channels : {1, 2, 8}) for (float speed : {.125f, .5f, 1.f, 2.f}) {
            for (float pitch : {.75f, 1.f, 2.f}) for (bool finished : {false, true}) {
                AudioSpeed reused(8000, format, channels, 64), fresh(8000, format, channels, 64);
                assert(reused.SetSpeed(speed) == SUCCESS && fresh.SetSpeed(speed) == SUCCESS);
                assert(reused.SetPitch(pitch) == SUCCESS && fresh.SetPitch(pitch) == SUCCESS);
                auto old = input545(format, channels, 8000, 0), next = input545(format, channels, 1000, .71);
                auto output = std::make_unique<uint8_t[]>(64);
                int count = -1;
                assert(reused.ChangeSpeedFunc(old.data(), old.size(), output, count) == int(old.size()));
                if (finished) { assert(reused.Finish() == SUCCESS); }
                assert(reused.Flush() == SUCCESS && reused.GetSpeed() == speed);
                assert(reused.ReadOutput(output, count) == SUCCESS && count == 0);
                auto got = finish545(reused, next), expected = finish545(fresh, next);
                bool equal = got == expected;
                differences += !equal;
                ++cases;
                std::cout << "FLUSH545 format=" << format << " ch=" << channels << " speed=" << speed
                    << " pitch=" << pitch << " finished=" << finished << " reused=" << got.size()
                    << " fresh=" << expected.size() << " equal=" << equal << '\n';
#ifndef SPEED_FLUSH545_BASELINE
                assert(equal);
                // A second discard, with and without new input, is a fresh epoch too.
                assert(reused.Flush() == SUCCESS && reused.Flush() == SUCCESS);
                AudioSpeed freshAgain(8000, format, channels, 64);
                assert(freshAgain.SetSpeed(speed) == SUCCESS && freshAgain.SetPitch(pitch) == SUCCESS);
                assert(finish545(reused, next) == finish545(freshAgain, next));
#endif
            }
        }
    }
    assert(active545 == 0);
#ifndef SPEED_FLUSH545_BASELINE
    // A new/explicitly discarded epoch has no pending input. Empty Finish,
    // including a repeated drain before the next write, must leave it fresh.
    for (int format : {SAMPLE_U8, SAMPLE_S16LE, SAMPLE_S24LE, SAMPLE_S32LE, SAMPLE_F32LE}) {
        for (int channels : {1, 2, 8}) for (float speed : {.125f, .5f, 1.f, 2.f}) {
            for (float pitch : {.75f, 1.f, 2.f}) for (bool history : {false, true}) {
                AudioSpeed reused(8000, format, channels, 64), fresh(8000, format, channels, 64);
                assert(reused.SetSpeed(speed) == SUCCESS && fresh.SetSpeed(speed) == SUCCESS);
                assert(reused.SetPitch(pitch) == SUCCESS && fresh.SetPitch(pitch) == SUCCESS);
                auto output = std::make_unique<uint8_t[]>(64);
                int count = -1;
                if (history) {
                    auto old = input545(format, channels, 8000, 0);
                    assert(reused.ChangeSpeedFunc(old.data(), old.size(), output, count) == int(old.size()));
                    assert(reused.Flush() == SUCCESS);
                }
                for (int repeat = 0; repeat < 4; ++repeat) {
                    assert(reused.Finish() == SUCCESS);
                    assert(reused.ReadOutput(output, count) == SUCCESS && count == 0);
                }
                auto next = input545(format, channels, 1000, .71);
                assert(finish545(reused, next) == finish545(fresh, next));
                ++cases;
            }
        }
    }
    for (int format : {SAMPLE_U8, SAMPLE_S16LE, SAMPLE_S24LE, SAMPLE_S32LE, SAMPLE_F32LE}) {
        // Real input after an empty Finish must reopen the epoch. This short
        // input produces no immediate data, and its Finish must produce data.
        AudioSpeed stream(8000, format, 2, 64);
        assert(stream.SetSpeed(.5f) == SUCCESS && stream.Finish() == SUCCESS);
        auto output = std::make_unique<uint8_t[]>(64);
        auto input = input545(format, 2, 10, .71);
        int count = -1;
        assert(stream.ReadOutput(output, count) == SUCCESS && count == 0);
        assert(stream.ChangeSpeedFunc(input.data(), input.size(), output, count) == int(input.size()));
        assert(count == 0 && stream.Finish() == SUCCESS);
        assert(stream.ReadOutput(output, count) == SUCCESS && count > 0);
        while (count > 0) { assert(stream.ReadOutput(output, count) == SUCCESS); }
        assert(stream.Finish() == SUCCESS && stream.ReadOutput(output, count) == SUCCESS && count == 0);
        ++cases;
    }
    for (int format : {SAMPLE_U8, SAMPLE_S16LE, SAMPLE_S24LE, SAMPLE_S32LE, SAMPLE_F32LE}) {
        AudioSpeed stream(8000, format, 2, 64);
        assert(stream.SetSpeed(.5f) == SUCCESS && stream.SetPitch(.75f) == SUCCESS);
        assert(stream.Finish() == SUCCESS); // deliberately start from finished_=true
        assert(stream.Reconfigure(8000, format, 0) == ERROR && active545 == 0);
        assert(stream.Finish() == ERROR && stream.SetSpeed(2.f) == ERROR);
        assert(stream.GetSpeed() == .5f && stream.SetPitch(2.f) == ERROR);
        auto output = std::make_unique<uint8_t[]>(64);
        auto next = input545(format, 2, 1000, .71);
        int count = -1;
        assert(stream.ReadOutput(output, count) == ERROR && count == 0);
        assert(stream.ChangeSpeedFunc(next.data(), next.size(), output, count) < 0 && count == 0);
        assert(stream.Flush() == ERROR && stream.Finish() == ERROR);
        assert(stream.Reconfigure(8000, format, 2) == SUCCESS);
        assert(stream.Finish() == SUCCESS && stream.ReadOutput(output, count) == SUCCESS && count == 0);
        assert(stream.SetPitch(.75f) == SUCCESS && stream.GetSpeed() == .5f);
        AudioSpeed fresh(8000, format, 2, 64);
        assert(fresh.SetSpeed(.5f) == SUCCESS && fresh.SetPitch(.75f) == SUCCESS);
        assert(finish545(stream, next) == finish545(fresh, next));
        ++cases;
    }
    for (int format : {SAMPLE_U8, SAMPLE_S16LE, SAMPLE_S24LE, SAMPLE_S32LE, SAMPLE_F32LE}) {
        AudioSpeed stream(8000, format, 2, 64);
        assert(stream.SetSpeed(.5f) == SUCCESS && stream.SetPitch(.75f) == SUCCESS);
        auto old = input545(format, 2, 3200, 0), next = input545(format, 2, 1000, .71);
        auto output = std::make_unique<uint8_t[]>(64);
        int count = -1;
        assert(stream.ChangeSpeedFunc(old.data(), old.size(), output, count) == int(old.size()));
        failCreates545 = 1;
        int before = createCalls545;
        assert(stream.Flush() == ERROR && active545 == 0 && createCalls545 == before + 1);
        assert(stream.SetSpeed(2.f) == ERROR && stream.GetSpeed() == .5f);
        assert(stream.SetPitch(2.f) == ERROR && stream.Finish() == ERROR);
        assert(stream.ReadOutput(output, count) == ERROR && count == 0);
        assert(stream.ChangeSpeedFunc(next.data(), next.size(), output, count) < 0 && count == 0);
        failCreates545 = 1;
        assert(stream.Flush() == ERROR && active545 == 0);
        // Existing explicit reconfigure recovery: a lost stream has default pitch;
        // the owner reapplies its pitch after a successful real recreation.
        assert(stream.Reconfigure(8000, format, 2) == SUCCESS);
        assert(stream.SetPitch(.75f) == SUCCESS && stream.GetSpeed() == .5f);
        AudioSpeed fresh(8000, format, 2, 64);
        assert(fresh.SetSpeed(.5f) == SUCCESS && fresh.SetPitch(.75f) == SUCCESS);
        assert(finish545(stream, next) == finish545(fresh, next));
        ++cases;
    }
    for (int format : {SAMPLE_U8, SAMPLE_S16LE, SAMPLE_S24LE, SAMPLE_S32LE, SAMPLE_F32LE}) {
        failCreates545 = 1;
        AudioSpeed failed(8000, format, 2, 64);
        assert(failed.SetSpeed(.5f) == ERROR && failed.GetSpeed() == 1.f);
        assert(failed.SetPitch(.75f) == ERROR && failed.Finish() == ERROR);
        auto next = input545(format, 2, 10, .71);
        auto output = std::make_unique<uint8_t[]>(64);
        int count = -1;
        assert(failed.ChangeSpeedFunc(next.data(), next.size(), output, count) < 0 && count == 0);
        assert(failed.ReadOutput(output, count) == ERROR && count == 0);
        assert(failed.Reconfigure(8000, format, 2) == SUCCESS);
        assert(failed.SetSpeed(.5f) == SUCCESS && failed.SetPitch(.75f) == SUCCESS);
        AudioSpeed fresh(8000, format, 2, 64);
        assert(fresh.SetSpeed(.5f) == SUCCESS && fresh.SetPitch(.75f) == SUCCESS);
        assert(finish545(failed, next) == finish545(fresh, next));
        ++cases;
    }
    { AudioSpeed failed(8000, SAMPLE_S16LE, 1, 0);
      assert(failed.SetSpeed(.5f) == ERROR && failed.SetPitch(.75f) == ERROR);
      assert(failed.Flush() == ERROR && failed.Reconfigure(8000, SAMPLE_S16LE, 1) == ERROR);
      assert(failed.Finish() == ERROR);
      ++cases;
    }
#endif
    assert(active545 == 0);
    std::cout << "FLUSH549 summary cases=" << cases << " differences=" << differences
        << " complete_AudioSpeed_and_certified_Sonic no_target_IPC_or_hardware_claim\n";
}
