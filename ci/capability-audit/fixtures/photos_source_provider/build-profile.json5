            "default"
          ]
        }
      ]
    },
    {
      "name": "browserCommonPC",
      "srcPath": "./browserCommonPC"
    },
    {
      "name": "browserCommonPhone",
      "srcPath": "./browserCommonPhone"
    },
    {
      "name": "editor_common",
      "srcPath": "./imageEditor/common"
    },
    {
      "name": "editor_phone",
      "srcPath": "./imageEditor/product/editor_phone"
    },
    {
      "name": "editor_pc",
      "srcPath": "./imageEditor/product/editor_pc"
