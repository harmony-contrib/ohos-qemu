import("//build/ohos.gni")
config("number_identity_js_config") {
  include_dirs = [ "include" ]
}

ohos_shared_library("numberlookup") {
  sources = [
    "src/napi_number_identity.cpp",
  ]

  include_dirs = [
    "//base/telephony/number_identity/utils/log/include",
    "//base/telephony/number_identity/shared/include",
  ]

  public_configs = [ ":number_identity_js_config" ]

  external_deps = [
    "ability_base:base",
    "ability_base:want",
    "ability_base:zuri",
    "ability_runtime:abilitykit_native",
    "ability_runtime:ability_manager",
    "ability_runtime:data_ability_helper",
    "ability_runtime:napi_base_context",
    "core_service:libtel_common",
    "core_service:tel_core_service_api",
    "c_utils:utils",
    "data_share:datashare_common",
    "data_share:datashare_consumer",
    "data_share:datashare_provider",
    "hilog:libhilog",
    "hisysevent:libhisysevent",
    "i18n:intl_util",
    "init:libbegetutil",
    "napi:ace_napi",
    "ipc:ipc_single",
    "ipc:ipc_napi",
  ]

  defines = [
    "NUMBER_IDENTITY_LOG_TAG = \"NumberIdentityJsApi\"",
    "LOG_DOMAIN = 0xD001F1A",
  ]

  if (build_variant != "user") {
    defines += [ "NUMBER_IDENTITY_DEBUG" ]
  }

  part_name = "number_identity"
  subsystem_name = "telephony"
  relative_install_dir = "module/contact"
}

ohos_shared_library("numberidentity") {
  sources = [
    "src/napi_number_identity.cpp",
  ]

  include_dirs = [
    "//base/telephony/number_identity/utils/log/include",
    "//base/telephony/number_identity/shared/include",
  ]

  public_configs = [ ":number_identity_js_config" ]

  external_deps = [
    "ability_base:base",
    "ability_base:want",
    "ability_base:zuri",
    "ability_runtime:abilitykit_native",
    "ability_runtime:ability_manager",
    "ability_runtime:data_ability_helper",
    "ability_runtime:napi_base_context",
    "core_service:libtel_common",
    "core_service:tel_core_service_api",
    "c_utils:utils",
    "data_share:datashare_common",
    "data_share:datashare_consumer",
    "data_share:datashare_provider",
    "hilog:libhilog",
    "hisysevent:libhisysevent",
    "i18n:intl_util",
    "init:libbegetutil",
    "napi:ace_napi",
    "ipc:ipc_single",
    "ipc:ipc_napi",
  ]

  defines = [
    "NUMBER_IDENTITY_LOG_TAG = \"NumberIdentityJsApi\"",
    "LOG_DOMAIN = 0xD001F1A",
  ]

  part_name = "number_identity"
  subsystem_name = "telephony"
  relative_install_dir = "module/telephony"
}