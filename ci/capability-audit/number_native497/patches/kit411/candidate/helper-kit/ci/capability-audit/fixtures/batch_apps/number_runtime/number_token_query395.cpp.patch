+}
+
+static bool NativeClockNanoseconds496(const struct timespec &value, uint64_t &result)
+{
+    if (value.tv_sec < 0 || value.tv_nsec < 0 || value.tv_nsec >= 1000000000L) return false;
+    const uint64_t seconds = static_cast<uint64_t>(value.tv_sec);
+    const uint64_t nanos = static_cast<uint64_t>(value.tv_nsec);
+    if (seconds > (UINT64_MAX - nanos) / 1000000000ULL) return false;
+    result = seconds * 1000000000ULL + nanos;
+    return result > 0;
+}
