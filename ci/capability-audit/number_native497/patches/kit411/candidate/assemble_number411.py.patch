+def native_descriptor497(row, maximum):
+    n.need(type(row) is dict and set(row) == {'path', 'sha256', 'bytes'} and
+           type(row['path']) is str and type(row['sha256']) is str and
+           re.fullmatch('[0-9a-f]{64}', row['sha256']) and
+           type(row['bytes']) is int and 0 < row['bytes'] <= maximum,
+           'exact finite native evidence descriptor required; status is not admission')
+    path = Path(row['path'])
+    n.need(path.is_absolute() and path.resolve() == path and
+           all(not p.is_symlink() for p in (path, *path.parents)), 'canonical native evidence path required')
+    before = path.stat()
+    n.need(stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and before.st_size == row['bytes'],
+           'one regular native evidence inode/size required')
+    digest = hashlib.sha256()
+    with path.open('rb') as stream:
+        for block in iter(lambda: stream.read(1048576), b''): digest.update(block)
+    after = path.stat()
+    n.need((before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns) ==
+           (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns) and
+           digest.hexdigest() == row['sha256'], 'native evidence changed during full-byte descriptor verification')
+    return dict(row)
+
