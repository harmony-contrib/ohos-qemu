+def native_inputs496(value):
+    if value is None: return None
+    n.need(type(value) is dict and set(value) == NATIVE_INPUT_KEYS496,
+           'exact optional native DATA keys required; no command/callback/readiness fields')
+    result = {}
+    for key in ('number_image_report', 'loader_image_report', 'system_image', 'build_inputs'):
+        item = value[key]
+        result[key] = None if item is None else native_descriptor497(item,
+            16*1024**3 if key == 'system_image' else 16*1024*1024)
+    for key, names, limit in (('emitter_elfs', NATIVE_EMITTERS496, 256*1024*1024),
+                             ('producer_sources', {'capture', 'observer'}, 1024*1024)):
+        items = value[key]
+        if items is None:
+            result[key] = None
+        else:
+            n.need(type(items) is dict and set(items) == names, 'exact native ' + key + ' descriptor names required')
+            result[key] = {name: native_descriptor497(item, limit) for name, item in items.items()}
+    return result  # Descriptor integrity only. Actual raw/admitted/ELF joins remain separate.
